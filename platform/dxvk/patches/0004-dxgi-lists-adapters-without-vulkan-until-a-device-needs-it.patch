+  /* PS5_Proton: DXGI's adapters without Vulkan. DXVK_DXGI_ADAPTER_SUMMARY names
+   * a file holding what DXGI needs of each adapter before a device exists
+   * (DxgiAdapterSummary). A factory that finds it lists adapters and outputs from
+   * it and creates the Vulkan instance only when something needs Vulkan: a
+   * device, a swap chain, the interop, the memory budget. A factory that creates
+   * the instance writes the file. Its name must change with the driver and DXVK:
+   * MihawkOS puts it in the runtime's cache namespace, keyed by both
+   * (src/pw_shader_cache.c). Without the variable nothing changes. On a PS5 the
+   * instance loads the GPU driver, about 20 MiB that every helper shares the
+   * budget of: a browser's main process and a launcher's lister paid it only to
+   * read their displays (the PS5 Pro, 2026-10-20). */
+  static_assert(std::is_trivially_copyable_v<DxgiAdapterSummary>);
+
+  struct DxgiAdapterSummaryHeader {
+    char     magic[8];
+    uint32_t version;
+    uint32_t entrySize;
+    uint32_t count;
+  };
+
+  static std::vector<DxgiAdapterSummary> loadAdapterSummaries() {
+    std::vector<DxgiAdapterSummary> summaries;
+    std::string path = env::getEnvVar("DXVK_DXGI_ADAPTER_SUMMARY");
+
+    if (path.empty())
+      return summaries;
+
+    std::ifstream file(str::topath(path.c_str()).c_str(), std::ios::binary);
+    DxgiAdapterSummaryHeader header = { };
+
+    if (!file.read(reinterpret_cast<char*>(&header), sizeof(header))
+     || std::memcmp(header.magic, "DXVKDXAS", sizeof(header.magic))
+     || header.version != 1u || header.entrySize != sizeof(DxgiAdapterSummary)
+     || !header.count || header.count > 16u)
+      return summaries;
+
+    summaries.resize(header.count);
+
+    if (!file.read(reinterpret_cast<char*>(summaries.data()), sizeof(DxgiAdapterSummary) * header.count))
+      summaries.clear();
+
+    return summaries;
+  }
+
+  static void saveAdapterSummaries(const std::vector<DxgiAdapterSummary>& summaries) {
+    std::string path = env::getEnvVar("DXVK_DXGI_ADAPTER_SUMMARY");
+
+    if (path.empty() || summaries.empty() || summaries.size() > 16u)
+      return;
+
+    std::string temporary = str::format(path, ".", GetCurrentProcessId(), ".tmp");
+    DxgiAdapterSummaryHeader header = { { 'D', 'X', 'V', 'K', 'D', 'X', 'A', 'S' }, 1u,
+      uint32_t(sizeof(DxgiAdapterSummary)), uint32_t(summaries.size()) };
+    bool written = false;
+
+    { std::ofstream file(str::topath(temporary.c_str()).c_str(), std::ios::binary | std::ios::trunc);
+      file.write(reinterpret_cast<const char*>(&header), sizeof(header));
+      file.write(reinterpret_cast<const char*>(summaries.data()), sizeof(DxgiAdapterSummary) * summaries.size());
+      written = bool(file.flush());
+    }
+
+    if (!written || !MoveFileExW(str::tows(temporary.c_str()).c_str(), str::tows(path.c_str()).c_str(),
+                                 MOVEFILE_REPLACE_EXISTING))
+      DeleteFileW(str::tows(temporary.c_str()).c_str());
+  }
+
+  static Config dxgiConfig() {
+    Config config = Config::getUserConfig();
+    config.merge(Config::getAppConfig(env::getExePath()));
+    return config;
+  }
