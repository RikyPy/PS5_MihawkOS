From: PS5_Proton <local>
Subject: [PATCH] gpu-broker: copy an unscaled frame into the display a 64-byte line at a time (PROTON_GPU_FAST_COPY=1)

Every present copies the whole frame into VideoOut's 64KB_R_X-tiled buffer on the CPU: one pixel at a time through
two lookup tables in the tiles' order, then a clflushopt per 64 bytes. In a Direct3D 12 game's presents that took 4.3 to
7.7 ms (2026-10-17, record removed from the tree; in git history: present_avg 5.8 ms of a 29.5 ms frame), and the composed desktop's present
copies the same way (6.8 ms mean in frame-pacing-2026-10-16-02). In that tiling a 4x4 block of pixels at a multiple of
4 is one aligned 64-byte line with its rows in order, so with PROTON_GPU_FAST_COPY=1 (read when the display opens) an
unscaled frame is read four rows side by side and each line is written whole with streaming stores, which need no
clflushopt; the sfence that ends the copy orders them before the flip, as before. A scaled frame keeps the pixel loop.
The copy is PS5_Proton's src/pw_display_copy.h, host-tested byte for byte against the pixel loop in both channel
orders (tests/test_pw_display_copy.c); on a host it is 2 to 3.4 times faster than the loop. Off by default (PROTON_GPU_FAST_COPY=1); not yet run on
the console with it on, and it needs the owner's eyes on a live picture first.
---
--- a/tooling/gpu-broker/display.cpp
+++ b/tooling/gpu-broker/display.cpp
@@ -1,9 +1,11 @@
 /* Copyright (C) 2026 Mihawk-99 */
 // SPDX-License-Identifier: LGPL-2.1-or-later
 #include "display.h"
+#include "pw_display_copy.h"
 #include <ps5platform/kernel.h>
 #include <ps5platform/videoout.h>
 #include <cerrno>
+#include <cstdlib>
 #include <cstring>
 #include <unistd.h>
 extern "C" int sceKernelUsleep(unsigned);
@@ -86,6 +88,10 @@
         if(!status)status=sceVideoOutRegisterBuffers2(handle,0,0,buffers,buffer_count,attribute,0,nullptr);
         if(status)return status;
         registered=true;
+        // PS5_Proton's PROTON_GPU_FAST_COPY=1: an unscaled frame is copied a 64-byte line at a time with streaming
+        // stores (pw_display_copy.h); a scaled one, and every frame without it, pixel by pixel below.
+        const char *fast=getenv("PROTON_GPU_FAST_COPY");fast_copy=fast && !strcmp(fast,"1");
+        fprintf(log,"gpu-display opened fast_copy=%d\n",fast_copy);
     }
     if(!registered)return EBUSY;
     // Three buffers: the one written next was last on screen two flips ago, so it is free once the flip after it has
@@ -103,6 +109,8 @@
     }
     const uint64_t copy_start=now_ns();
     auto *buffer=(uint8_t *)mapped+back*buffer_bytes;
+    if(fast_copy && w==width && h==height)pw_display_copy_lines(buffer,(const uint8_t *)pixels,pitch,bgra);
+    else {
     // Scaling, nearest neighbour, as tables; then each tile in memory order, flushed as it is finished.
     static uint16_t source_x[width],source_y[height];
     for(unsigned x=0;x<width;++x)source_x[x]=uint16_t(x*w/width);
@@ -118,6 +126,7 @@
         }
         for(size_t at=0;at<65536;at+=64)__asm__ volatile("clflushopt (%0)"::"r"((uint8_t *)tile+at):"memory");
     }
+    }
     if(cursor_x>=0 && cursor_y>=0)draw_cursor(buffer,cursor_x,cursor_y);
     __asm__ volatile("sfence":::"memory");
     last_copy_ns=now_ns()-copy_start;
--- a/tooling/gpu-broker/display.h
+++ b/tooling/gpu-broker/display.h
@@ -11,6 +11,7 @@
     void *mapped=nullptr;
     uint64_t flips=0,last_copy_ns=0;
     bool registered=false;
+    bool fast_copy=false;   /* PS5_Proton's PROTON_GPU_FAST_COPY=1, read when the display opens */
     /* cursor_x, cursor_y: where to draw the pointer on the 1920x1080 screen, or -1 for none. */
     int present(const void *pixels,unsigned width,unsigned height,unsigned pitch,FILE *log,const char *capture,bool bgra=false,
                 int cursor_x=-1,int cursor_y=-1);
