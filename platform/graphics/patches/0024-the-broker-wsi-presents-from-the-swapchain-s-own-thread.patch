From: PS5_Proton <local>
Subject: [PATCH] gpu-broker: present without waiting, from the swapchain's own thread (WINE_PS5_ASYNC_PRESENT=1)

The broker WSI's present waited for the frame's fence, then made the synchronous round trip in which the owner copies
the frame into the display's buffer and submits the flip, all on the caller's thread. VKD3D-Proton presents from its
D3D12 queue's submission thread, so in a Direct3D 12 game that thread spent 5.8 ms of each frame there and no later
submission reached the GPU meanwhile (PS5_Proton's docs/PLAN.md, 2026-10-17: GPU busy 2 ms of 32.6, the
present 5.8 ms; with the helpers' sync device on, the present and the submissions' round trips are 8.6 ms of each frame
on that thread, over a 120 Hz frame by themselves). With WINE_PS5_ASYNC_PRESENT=1 in the helper (read when a swapchain
is made), a present queues its image and returns; the swapchain's thread waits for the fence and makes the round trip,
in present order, and frees the image, so acquire hands it out again only then (woken by the thread, not a 1 ms poll).
The first failure is returned by every later present and acquire, as before; destroying the swapchain lets the thread
show what is queued and joins it before any image goes. Without the setting nothing changes. Each swapchain made with it
says so on stderr ("gpu-wsi async present=1 images=... extent=..."). Console: off by default; with it on, a Direct3D
12 game at 119.88 Hz went from 95.0 to 118.6 fps with nothing else changed (PS5_Proton, 2026-10-17, record removed from the tree; in git history; the owner
off the pad, the same settings and stretch). A window frame the owner cannot place yet (ESTALE: its window or generation
not in the owner's snapshot) is sent again by the presenter, every 2 ms for up to 500 ms while nothing newer is queued (PS5_Proton
src/pw_present_retry.h, host-tested; one "gpu-wsi present refused tries= waited_ms= outcome=" line per burst),
and then dropped, never turned into a lost device: a program presenting synchronously sends it again itself when the
failure comes back, but behind the asynchronous present the failure never reached it, and a presenter into another
process's window that presents once lost its only frame (gate-2026-10-18-defaults-01, gpu-window32).
---
--- /dev/null
+++ b/tooling/gpu-broker/async-present-wsi.patch
@@ -0,0 +1,158 @@
+--- a/src/vulkan/wsi/wsi_common_videoout.c
++++ b/src/vulkan/wsi/wsi_common_videoout.c
+@@ -7,8 +7,12 @@
+ /* Experimental VK_KHR_display transport to the owning title. Native child
+  * processes never open VideoOut. Mesa's CPU WSI copies optimal images into
+  * broker-backed linear memory; the owner confirms each display flip. */
++#include <assert.h>
++#include <errno.h>
++#include "pw_present_retry.h"   /* PS5_Proton src/pw_present_retry.h, copied beside this file */
+ #include <inttypes.h>
+ #include <stdio.h>
++#include <stdlib.h>
+ #include <string.h>
+ #include "c11/threads.h"
+ #include "util/macros.h"
+@@ -372,11 +376,19 @@
+ }
+ 
+ struct wsi_videoout { struct wsi_interface base; };
++/* PS5_Proton's WINE_PS5_ASYNC_PRESENT=1: a present returns at once, and the swapchain's own thread waits for the
++ * frame's fence and makes the round trip to the owner, in present order; the image is acquired again only once that
++ * is done. VKD3D-Proton presents from its D3D12 queue's submission thread, which otherwise waited 5.8 ms a frame here,
++ * no later submission reaching the GPU meanwhile (PS5_Proton's docs/PLAN.md, 2026-10-17). Under lock:
++ * queue (head, count; never more than the images, as each queued one is busy), lost (the first failure, returned by
++ * every later present and acquire), stopping. */
+ struct broker_chain {
+    struct wsi_swapchain base;
+    mtx_t lock;
+    bool retired,busy[VIDEOOUT_BUFFERS];
+    uint32_t hwnd;uint64_t generation;
++   bool async,stopping;VkResult lost;cnd_t changed;thrd_t presenter;
++   uint32_t queue[VIDEOOUT_BUFFERS],head,count;
+    struct wsi_image images[];
+ };
+ static struct wsi_image *broker_image(struct wsi_swapchain *b,uint32_t i)
+@@ -396,15 +408,20 @@
+       for(uint32_t i=0;i<b->image_count;i++)if(!c->busy[i]) {
+          c->busy[i]=true;*index=i;mtx_unlock(&c->lock);return VK_SUCCESS;
+       }
+-      mtx_unlock(&c->lock);
+-      if(info->timeout==0)return VK_NOT_READY;
+-      if(os_time_get_nano()-start>=info->timeout)return VK_TIMEOUT;
+-      os_time_sleep(1000);
++      if(c->async && c->lost!=VK_SUCCESS) { const VkResult lost=c->lost;mtx_unlock(&c->lock);return lost; }
++      if(info->timeout==0) { mtx_unlock(&c->lock);return VK_NOT_READY; }
++      if(os_time_get_nano()-start>=info->timeout) { mtx_unlock(&c->lock);return VK_TIMEOUT; }
++      if(c->async) {   /* woken when the presenter frees an image; 1 ms bounds each wait, for the timeout */
++         struct timespec until;timespec_get(&until,TIME_UTC);
++         until.tv_nsec+=1000000;if(until.tv_nsec>=1000000000) { until.tv_nsec-=1000000000;++until.tv_sec; }
++         cnd_timedwait(&c->changed,&c->lock,&until);mtx_unlock(&c->lock);
++      } else { mtx_unlock(&c->lock);os_time_sleep(1000); }
+    }
+ }
+-static VkResult broker_present(struct wsi_swapchain *b,uint32_t i,uint64_t id,const VkPresentRegionKHR *damage)
++/* Image i to the owner: its fence, then the round trip; *status, the owner's answer. */
++static VkResult broker_show(struct broker_chain *c,uint32_t i,int *status_out)
+ {
+-   struct broker_chain *c=(void *)b;
++   struct wsi_swapchain *b=&c->base;
+    /* The GPU-to-buffer blit and application's semaphore waits precede this fence. */
+    const uint64_t waiting=os_time_get_nano();
+    VkResult result=b->wsi->WaitForFences(b->device,1,&b->fences[i],true,5000000000ull);
+@@ -415,7 +432,69 @@
+    int status=c->hwnd ? ps5_gpu_client_window_swapchain(image->cpu_map,width,height,image->row_pitches[0],1,c->hwnd,c->generation)
+                       : ps5_gpu_client_swapchain(image->cpu_map,width,height,image->row_pitches[0],1);
+    if(status)result=VK_ERROR_DEVICE_LOST;
+-   mtx_lock(&c->lock);c->busy[i]=false;mtx_unlock(&c->lock);
++   *status_out=status;
++   return result;
++}
++/* The presenter's resend of a refused frame (pw_present_retry.h): the image, and the last answer's VkResult. */
++struct broker_resend { struct broker_chain *chain;uint32_t image;VkResult result; };
++static int broker_resend_send(void *opaque)
++{
++   struct broker_resend *r=opaque;int status=0;
++   r->result=broker_show(r->chain,r->image,&status);
++   return status;
++}
++static int broker_resend_newer(void *opaque)
++{
++   struct broker_chain *c=((struct broker_resend *)opaque)->chain;
++   mtx_lock(&c->lock);const int newer=c->count>1 || c->stopping;mtx_unlock(&c->lock);
++   return newer;
++}
++static void broker_resend_pause(void *opaque,unsigned us) { (void)opaque;os_time_sleep(us); }
++static int broker_presenter(void *opaque)
++{
++   struct broker_chain *c=opaque;
++   mtx_lock(&c->lock);
++   for(;;) {
++      while(!c->count && !c->stopping)cnd_wait(&c->changed,&c->lock);
++      if(!c->count)break;   /* stopping, and every queued present shown */
++      const uint32_t i=c->queue[c->head];
++      mtx_unlock(&c->lock);
++      int status=0;
++      VkResult result=broker_show(c,i,&status);
++      /* A window frame the owner cannot place yet (ESTALE) goes again while nothing newer is queued, then is dropped,
++       * never the device lost (pw_present_retry.h): one line per burst. */
++      if(status==ESTALE) {
++         struct broker_resend resend={c,i,result};
++         const PwPresentBurst burst=pw_present_retry_run(status,broker_resend_send,broker_resend_newer,broker_resend_pause,&resend);
++         fprintf(stderr,"gpu-wsi present refused tries=%u waited_ms=%u outcome=%s\n",burst.tries,burst.waited_us/1000,
++                 pw_present_outcome_name(burst.outcome));
++         result=burst.outcome==PW_PRESENT_LOST ? resend.result : VK_SUCCESS;
++      }
++      mtx_lock(&c->lock);
++      c->head=(c->head+1)%VIDEOOUT_BUFFERS;--c->count;
++      if(result!=VK_SUCCESS && c->lost==VK_SUCCESS)c->lost=result;
++      c->busy[i]=false;cnd_broadcast(&c->changed);
++   }
++   mtx_unlock(&c->lock);
++   return 0;
++}
++static VkResult broker_present(struct wsi_swapchain *b,uint32_t i,uint64_t id,const VkPresentRegionKHR *damage)
++{
++   struct broker_chain *c=(void *)b;
++   VkResult result=VK_SUCCESS;
++   if(!c->async) {
++      int status=0;
++      result=broker_show(c,i,&status);
++      mtx_lock(&c->lock);c->busy[i]=false;mtx_unlock(&c->lock);
++      return result;
++   }
++   mtx_lock(&c->lock);
++   result=c->lost;
++   if(result==VK_SUCCESS) {
++      assert(c->count<VIDEOOUT_BUFFERS);
++      c->queue[(c->head+c->count)%VIDEOOUT_BUFFERS]=i;++c->count;cnd_broadcast(&c->changed);
++   } else c->busy[i]=false;
++   mtx_unlock(&c->lock);
+    return result;
+ }
+ static VkResult broker_wait(struct wsi_swapchain *b,uint64_t id,uint64_t timeout)
+@@ -423,6 +502,10 @@
+ static VkResult broker_destroy(struct wsi_swapchain *b,const VkAllocationCallbacks *a)
+ {
+    struct broker_chain *c=(void *)b;
++   if(c->async) {   /* the presenter shows what is queued, then ends: nothing it uses goes before it */
++      mtx_lock(&c->lock);c->stopping=true;cnd_broadcast(&c->changed);mtx_unlock(&c->lock);
++      thrd_join(c->presenter,NULL);cnd_destroy(&c->changed);
++   }
+    for(uint32_t i=0;i<b->image_count;i++)wsi_destroy_image(b,&c->images[i]);
+    wsi_swapchain_finish(b);mtx_destroy(&c->lock);vk_free(a,c);return VK_SUCCESS;
+ }
+@@ -456,6 +539,13 @@
+          wsi_swapchain_finish(&c->base);mtx_destroy(&c->lock);vk_free(a,c);return result;
+       }
+    }
++   const char *async=getenv("WINE_PS5_ASYNC_PRESENT");
++   if(async && !strcmp(async,"1")) {
++      c->async=cnd_init(&c->changed)==thrd_success;
++      if(c->async && thrd_create(&c->presenter,broker_presenter,c)!=thrd_success) { cnd_destroy(&c->changed);c->async=false; }
++      fprintf(stderr,"gpu-wsi async present=%d images=%u extent=%ux%u\n",c->async,count,info->imageExtent.width,
++              info->imageExtent.height);
++   }
+    if(info->oldSwapchain) {
+       struct broker_chain *old=(void *)wsi_swapchain_from_handle(info->oldSwapchain);
+       mtx_lock(&old->lock);old->retired=true;mtx_unlock(&old->lock);
--- a/tools/build-gpu-broker-client.sh
+++ b/tools/build-gpu-broker-client.sh
@@ -72,6 +72,9 @@
     patch --batch -p1 -d "$out/source" < "$out/patches/window-surfaces-wsi.patch"
     cp "$root/tooling/gpu-broker/present-times-wsi.patch" "$out/patches/"
     patch --batch -p1 -d "$out/source" < "$out/patches/present-times-wsi.patch"
+    cp "$root/tooling/gpu-broker/async-present-wsi.patch" "$out/patches/"
+    patch --batch -p1 -d "$out/source" < "$out/patches/async-present-wsi.patch"
+    cp "$root/tooling/gpu-broker/pw_present_retry.h" "$out/source/src/vulkan/wsi/"   # PS5_Proton's, beside the WSI
     python3 - "$radv" "$out" <<'PYWSI'
 import json,shlex,subprocess,sys
 from pathlib import Path
