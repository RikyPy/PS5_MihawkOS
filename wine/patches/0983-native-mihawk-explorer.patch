Subject: [PATCH] explorer: decorate the real browser with Mihawk navigation and commands

The existing shell view retains file operations and history. Address input is
read with a bounded, terminated API. Shell controls are opt-in and keep the
normal non-Mihawk route.

diff --git a/programs/explorer/explorer.c b/programs/explorer/explorer.c
--- a/programs/explorer/explorer.c
+++ b/programs/explorer/explorer.c
@@ -34,6 +34,7 @@
 #include <shlwapi.h>
 #include <commoncontrols.h>
 #include <commctrl.h>
+#include "pw_shell_style.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(explorer);
 
@@ -69,12 +70,21 @@
 
     IShellWindows *sw;
     LONG sw_cookie;
+    BOOL mihawk;
+    int mihawk_location;
+    struct pw_shell_style mihawk_style;
+    HWND mihawk_nav[3], mihawk_commands[8], mihawk_links[7];
+    HMODULE mihawk_resources;
+    HICON mihawk_icons[18], mihawk_small_icon, mihawk_large_icon;
+    HIMAGELIST mihawk_icon_images;
 } explorer_info;
 
 enum
 {
     BACK_BUTTON,FORWARD_BUTTON,UP_BUTTON
 };
+
+#include "pw_shell_explorer.h"
 
