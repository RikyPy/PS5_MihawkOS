From: PS5_Proton
Subject: [PATCH] win32u: retain GDI backing beside brokered GPU clients

Native display drivers can draw GDI through their GPU window drawable. The
PS5 broker has no such GDI drawable: dropping the ordinary parent surface
when it acquires a pixel format also removes backing for captions and GDI
children. Preserve that backing only in the retained-window route. Ordinary
Wine surface and DC clips remain authoritative; GPU planes keep their own
canonical client clips. Legacy PS5 and other display drivers are unchanged.

--- a/dlls/win32u/ps5drv.c
+++ b/dlls/win32u/ps5drv.c
@@ -93,6 +93,13 @@
 static void (*present_origin)( INT x, INT y );
 static BOOL helper_process;
 static BOOL window_surfaces;
+
+/* Native GPU drawables have no GDI drawable. Keep the ordinary parent
+ * surface for captions and GDI children; canonical GPU clips stay separate. */
+BOOL ps5_retains_gdi_surface(void)
+{
+    return window_surfaces;
+}
 static int (*present_window)( UINT hwnd, UINT64 generation, const void *pixels,
                               UINT width, UINT height, UINT stride, INT offset_x, INT offset_y );
 static void (*drop_window)( UINT hwnd );
--- a/dlls/win32u/win32u_private.h
+++ b/dlls/win32u/win32u_private.h
@@ -63,6 +63,9 @@
 extern void *window_surface_get_color( struct window_surface *surface, BITMAPINFO *info );
 
 extern int force_present_to_surface( const RECT *win_rect );
+#ifdef WINE_PS5_USER_DRIVER
+extern BOOL ps5_retains_gdi_surface(void);
+#endif
 
 /* defwnd.c */
 extern BOOL adjust_window_rect( RECT *rect, DWORD style, BOOL menu, DWORD ex_style, UINT dpi );
--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -2167,6 +2167,9 @@
     else if (create_layered || is_layered) needs_surface = TRUE;
 
     if (needs_surface && !is_layered && !create_layered && window_clip_client_surfaces( hwnd )
+#ifdef WINE_PS5_USER_DRIVER
+        && !ps5_retains_gdi_surface()
+#endif
         && !(!create_opaque && NtUserGetLayeredWindowAttributes( hwnd, NULL, NULL, &layered_flags ) && layered_flags & LWA_COLORKEY))
     {
         if (new_surface) window_surface_release( new_surface );
