 {
     const struct opengl_funcs *funcs = &display_funcs;
@@ -1600,6 +1600,18 @@ static void init_egl_platforms( struct opengl_funcs *funcs, const struct opengl_
 
 #else /* SONAME_LIBEGL */
 
+/* No EGL backend can create a framebuffer surface in this build. */
