From: PS5_Proton
Subject: [PATCH] ntdll: a PS5 helper's application settings, for every process

Every catalog game lives in Mihawk OS (one prefix) and is started from
its desktop shortcut: Explorer's child. A helper's Unix environment is
its spawner's (wine/ps5/pw_wine_process.c inherited()) and its Windows
one its parent's, so a game started from the desktop had Explorer's:
A .NET (MonoGame) game without WINE_PS5_OPENGL has no OpenGL driver at all.

- The PS5 spawn path passes the new process's executable and command
  line (UTF-8, from its process parameters) to pw_ps5_spawn, which
  carries them in the bootstrap to the title. The title finds the
  executable's catalog entry and gives the helper its game.json
  settings (src/pw_app_environment.h); the loader sets them on the Unix
  side.
- A process another one started applies the same settings to its
  Windows environment in init_startup_info, through patch 0974's
  overlay, now one function for the initial application and for a
  child: every case variant of a name removed, then one value set.

Without settings from the title nothing changes.

diff --git a/dlls/ntdll/unix/env.c b/dlls/ntdll/unix/env.c
index 4b2febc..fa8546c 100644
--- a/dlls/ntdll/unix/env.c
+++ b/dlls/ntdll/unix/env.c
@@ -1964,6 +1964,45 @@ static void DECLSPEC_NORETURN exit_initial_process( NTSTATUS status )
 }
 #endif
 
+#ifdef __PROSPERO__
+/* The application environment the PS5 loader was given for this process (pw_ps5_initial_environment): the catalog's
+ * settings for the initial application, and, for a process another one started, the settings the title found for its
+ * executable in the catalog (the Mihawk OS session: a game started from a desktop shortcut gets its own game.json
+ * "env", as from the launcher). Unix may hold case variants: every selected-name match is removed before exactly one
+ * Windows value, possibly empty, is installed. */
+static NTSTATUS ps5_application_environment( WCHAR **env, SIZE_T *pos, SIZE_T *size )
+{
+    extern const char *pw_ps5_initial_environment(void);
+    const char *application = pw_ps5_initial_environment();
+    for (const char *item = application; item && *item; item += strlen(item) + 1)
+    {
+        ULONG written;
+        NTSTATUS status;
+        size_t length = strlen(item);
+        WCHAR *entry = malloc((length + 1) * sizeof(*entry)), *equals;
+        if (!entry) return STATUS_NO_MEMORY;
+        status = RtlUTF8ToUnicodeN(entry, length * sizeof(*entry), &written, item, length);
+        if (status != STATUS_SUCCESS)
+        {
+            free(entry);
+            return status;
+        }
+        entry[written / sizeof(*entry)] = 0;
+        equals = wcschr(entry, '=');
+        if (!equals || equals == entry)
+        {
+            free(entry);
+            return STATUS_INVALID_PARAMETER;
+        }
+        while (find_env_var(*env, *pos, entry, equals - entry))
+            set_env_var(env, pos, size, entry, equals - entry, NULL);
+        set_env_var(env, pos, size, entry, equals - entry, equals + 1);
+        free(entry);
+    }
+    return STATUS_SUCCESS;
+}
+#endif
+
 /*************************************************************************
  *		build_initial_params
  *
@@ -2026,38 +2065,9 @@ static RTL_USER_PROCESS_PARAMETERS *build_initial_params( void **module )
     add_registry_environment( &env, &env_pos, &env_size );
 #ifdef __PROSPERO__
     /* Explicit catalog overrides belong to this initial Windows application,
-     * after normal registry provisioning. Descendants use their ordinary
-     * startup environment, so none of this is reapplied to CreateProcess. */
-    {
-        extern const char *pw_ps5_initial_environment(void);
-        const char *application = pw_ps5_initial_environment();
-        for (const char *item = application; item && *item; item += strlen(item) + 1)
-        {
-            ULONG written;
-            size_t length = strlen(item);
-            WCHAR *entry = malloc((length + 1) * sizeof(*entry)), *equals;
-            if (!entry) exit_initial_process(STATUS_NO_MEMORY);
-            status = RtlUTF8ToUnicodeN(entry, length * sizeof(*entry), &written, item, length);
-            if (status != STATUS_SUCCESS)
-            {
-                free(entry);
-                exit_initial_process(status);
-            }
-            entry[written / sizeof(*entry)] = 0;
-            equals = wcschr(entry, '=');
-            if (!equals || equals == entry)
-            {
-                free(entry);
-                exit_initial_process(STATUS_INVALID_PARAMETER);
-            }
-            /* Unix may hold case variants. Remove all selected-name matches
-             * before installing exactly one Windows value, including empty. */
-            while (find_env_var(env, env_pos, entry, equals - entry))
-                set_env_var(&env, &env_pos, &env_size, entry, equals - entry, NULL);
-            set_env_var(&env, &env_pos, &env_size, entry, equals - entry, equals + 1);
-            free(entry);
-        }
-    }
+     * after normal registry provisioning. */
+    status = ps5_application_environment( &env, &env_pos, &env_size );
+    if (status) exit_initial_process( status );
 #endif
     env[env_pos++] = 0;
 
@@ -2211,6 +2221,10 @@ void init_startup_info(void)
         for (i = 0; name[i]; ++i) nameW[i] = name[i];
         set_env_var( &env, &env_pos, &env_size, nameW, i, NULL );
     }
+    /* A process another one started gets the settings the title found for its executable (the loader was given
+     * them; none when the catalog names nothing for it). */
+    if ((status = ps5_application_environment( &env, &env_pos, &env_size )))
+        ERR( "PS5 application environment refused: %#x\n", status );
 #endif
     add_dynamic_environment( &env, &env_pos, &env_size );
     is_prefix_bootstrap = !!find_env_var( env, env_pos, bootstrapW, ARRAY_SIZE(bootstrapW) );
diff --git a/dlls/ntdll/unix/process.c b/dlls/ntdll/unix/process.c
index 0d70fd4..75559f5 100644
--- a/dlls/ntdll/unix/process.c
+++ b/dlls/ntdll/unix/process.c
@@ -405,8 +405,12 @@ static NTSTATUS spawn_process( const RTL_USER_PROCESS_PARAMETERS *params, int so
                                int unixdir, char *winedebug, const struct pe_image_info *pe_info )
 {
 #ifdef __PROSPERO__
-    extern int pw_ps5_spawn(int, const char *, const char *, const char *, const char *, unsigned int);
+    extern int pw_ps5_spawn(int, const char *, const char *, const char *, const char *, unsigned int,
+                            const char *, const char *);
     UNICODE_STRING nt_cwd = {0}, true_cwd = {0};
+    /* The new process's executable and command line, so the title can give it its catalog settings
+     * (wine/ps5/pw_wine_process.h, the bootstrap's image and command_line); a long command line keeps its start. */
+    char image[1024] = {0}, command_line[8192] = {0};
     OBJECT_ATTRIBUTES cwd_attr;
     char *cwd = NULL;
     NTSTATUS status;
@@ -424,8 +428,15 @@ static NTSTATUS spawn_process( const RTL_USER_PROCESS_PARAMETERS *params, int so
         while (key[i] && env[i] == key[i]) ++i;
         if (!key[i] && !env[i]) { flags = 2; break; }
     }
+    if (params->ImagePathName.Length / sizeof(WCHAR) * 3 < sizeof(image))
+        ntdll_wcstoumbs( params->ImagePathName.Buffer, params->ImagePathName.Length / sizeof(WCHAR), image,
+                         sizeof(image) - 1, FALSE );
+    ntdll_wcstoumbs( params->CommandLine.Buffer, params->CommandLine.Length / sizeof(WCHAR) * 3 < sizeof(command_line)
+                     ? params->CommandLine.Length / sizeof(WCHAR) : (sizeof(command_line) - 1) / 3, command_line,
+                     sizeof(command_line) - 1, FALSE );
     if (!status && pw_ps5_spawn(socketfd, getenv("WINE_PS5_NTDLL_DIR"), config_dir, cwd,
-                               winedebug ? strchr(winedebug, '=') + 1 : NULL, flags)) status = errno_to_status(errno);
+                               winedebug ? strchr(winedebug, '=') + 1 : NULL, flags, image, command_line))
+        status = errno_to_status(errno);
     free(cwd); free(nt_cwd.Buffer); free(true_cwd.Buffer);
     return status;
 #else
