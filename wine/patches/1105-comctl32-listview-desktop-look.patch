From: PS5_Proton <local>
Subject: [PATCH] comctl32: listview draws the desktop's plates, band and labels as the Windows 11 prototype does

With LVS_EX_TRANSPARENTSHADOWTEXT (the extended style Windows' desktop sets) an icon view is drawn as the approved Windows 11 prototype
draws its desktop, from PS5_Proton's src/pw_desktop_icons.h and the prototype's measured pixels (pw_desktop_sprites.h, generated by
tools/build-desktop-sprites.py), both copied into dlls/comctl32 at build time:

- each item sits on the prototype's plate, 1 px inside its cell and as big as the list's icon size makes it (73 x 73 for one line at
  48 px), in the colours of its state: hover (the item under the
  pointer is tracked, and let go when the pointer leaves), selected, selected under the pointer, and selected while the list has no
  focus; a drop target shows as selected. The selected icon is not tinted, and there is no dotted focus rectangle. The whole plate is
  the item for the pointer (LVM_HITTEST; a press on its edge takes the item, as in the prototype and on Windows 11, where Wine's list
  counted only the icon and the label);
- the label is laid out as Blink lays the prototype's out (white space collapsed, lines broken after spaces and hyphens, a word wider
  than a line broken anywhere, two lines with "…" unless the item is the selected one with the focus) and drawn from the prototype's own
  glyphs in its three layers (two shadows, then the text), clipped as the prototype clips a clamped label. A name with a character the
  glyphs lack keeps GDI's text with a soft shadow;
- the rubber band is the prototype's: a Highlight-blue border round its 30% fill;
- the first paint does not arrange the desktop's icons: Wine's list view arranged every icon view then, which put each icon the
  shell had placed (its saved cell, This PC first) back in the list's order.
---
diff --git a/dlls/comctl32/listview.c b/dlls/comctl32/listview.c
--- a/dlls/comctl32/listview.c
+++ b/dlls/comctl32/listview.c
@@ -399,6 +399,21 @@ typedef struct tagLISTVIEW_INFO
 #define LV_FL_DT_FLAGS  (DT_TOP | DT_NOPREFIX | DT_EDITCONTROL | DT_CENTER | DT_WORDBREAK | DT_NOCLIP)
 #define LV_SL_DT_FLAGS  (DT_VCENTER | DT_NOPREFIX | DT_EDITCONTROL | DT_SINGLELINE | DT_WORD_ELLIPSIS | DT_END_ELLIPSIS)
 
+/* The desktop (LVS_EX_TRANSPARENTSHADOWTEXT in the icon view) as the approved Windows 11 prototype draws it: the grid, the
+ * plates, the band and the labels from PS5_Proton's src/pw_desktop_icons.h and the prototype's measured pixels
+ * (pw_desktop_sprites.h, generated), both copied here at build time. */
+#include "pw_desktop_icons.h"
+#include "pw_desktop_sprites.h"
+#define LV_DESKTOP_LOOK(infoPtr) ((infoPtr)->uView == LV_VIEW_ICON && ((infoPtr)->dwLvExStyle & LVS_EX_TRANSPARENTSHADOWTEXT))
+struct desktop_bits { HDC dc; HBITMAP bitmap, old; unsigned int *pixels; int x, y, width, height; };
+static BOOL desktop_bits_open(struct desktop_bits *bits, HDC hdc, int x, int y, int width, int height);
+static void desktop_bits_blend(struct desktop_bits *bits, HDC hdc);
+static void desktop_draw_band(HDC hdc, const RECT *rect);
+static void desktop_set_hot(LISTVIEW_INFO *infoPtr, const POINT *pt);
+static BOOL desktop_label(const LISTVIEW_INFO *infoPtr, const LVITEMW *item, const RECT *label_rect, const PwDesktopGrid *grid,
+                          PwDesktopLabel *label, BOOL *whole, int *lines);
+static void draw_label_shadow(HDC hdc, const WCHAR *text, const RECT *label, UINT format);
+
 /* Image index from state */
 #define STATEIMAGEINDEX(x) (((x) & LVIS_STATEIMAGEMASK) >> 12)
 
@@ -1093,8 +1108,8 @@ static void prepaint_setup (const LISTVIEW_INFO *infoPtr, HDC hdc, const NMLVCUS
     backcolor = cd->clrTextBk;
     textcolor = cd->clrText;
 
-    /* apparently, for selected items, we have to override the returned values */
-    if (!SubItem)
+    /* apparently, for selected items, we have to override the returned values (not on the desktop: its text stays as it is set) */
+    if (!SubItem && !LV_DESKTOP_LOOK(infoPtr))
     {
         if (cd->nmcd.uItemState & CDIS_SELECTED)
         {
@@ -1735,6 +1750,7 @@ static inline BOOL LISTVIEW_GetItemW(const LISTVIEW_INFO *infoPtr, LPLVITEMW lpL
 /* used to handle collapse main item column case */
 static inline BOOL LISTVIEW_DrawFocusRect(const LISTVIEW_INFO *infoPtr, HDC hdc)
 {
+    if (LV_DESKTOP_LOOK(infoPtr)) return FALSE;   /* the desktop shows no dotted focus rectangle */
     return (infoPtr->rcFocus.left < infoPtr->rcFocus.right) ?
             DrawFocusRect(hdc, &infoPtr->rcFocus) : FALSE;
 }
@@ -4160,6 +4176,8 @@ static LRESULT LISTVIEW_MouseMove(LISTVIEW_INFO *infoPtr, WORD fwKeys, INT x, IN
         }
     }
 
+    if (LV_DESKTOP_LOOK(infoPtr)) desktop_set_hot(infoPtr, &pt);
+
     /* see if we are supposed to be tracking mouse hovering */
     if (LISTVIEW_IsHotTracking(infoPtr)) {
         TRACKMOUSEEVENT trackinfo;
@@ -4636,6 +4654,10 @@ static void LISTVIEW_DrawItemPart(LISTVIEW_INFO *infoPtr, LVITEMW *item, const N
     HIMAGELIST himl;
     UINT format;
     RECT *focus;
+    PwDesktopGrid grid = pw_desktop_grid(infoPtr->iconSize.cx);
+    PwDesktopLabel label;
+    struct desktop_bits bits;
+    BOOL desktop = FALSE, whole = FALSE;
 
     /* now check if we need to update the focus rectangle */
     focus = infoPtr->bFocus && (item->state & LVIS_FOCUSED) ? &infoPtr->rcFocus : 0;
@@ -4719,6 +4741,28 @@ static void LISTVIEW_DrawItemPart(LISTVIEW_INFO *infoPtr, LVITEMW *item, const N
 	}
     }
 
+    /* The desktop: the item's plate (the list's item box is its cell, 1 px above the plate, its size the icon's: see
+     * pw_desktop_icons.h) in the prototype's colours for its state, under the icon, which is not tinted when selected; its
+     * label is laid out here too, from the prototype's glyphs, all its lines when it is the selected item with the focus. */
+    if (LV_DESKTOP_LOOK(infoPtr) && item->iSubItem == 0)
+    {
+        BOOL hot = item->iItem == infoPtr->nHotItem;
+        int plate = -1, lines;
+
+        desktop = desktop_label(infoPtr, item, &rcLabel, &grid, &label, &whole, &lines);
+        if (item->state & (LVIS_SELECTED | LVIS_DROPHILITED))
+            plate = hot ? PW_DESKTOP_PLATE_SELECTED_HOVER :
+                    infoPtr->bFocus || (item->state & LVIS_DROPHILITED) ? PW_DESKTOP_PLATE_SELECTED : PW_DESKTOP_PLATE_INACTIVE;
+        else if (hot)
+            plate = PW_DESKTOP_PLATE_HOVER;
+        if (plate >= 0 && desktop_bits_open(&bits, nmlvcd->nmcd.hdc, rcBox.left, rcBox.top + 1, pw_desktop_plate_width(&grid),
+                                            pw_desktop_plate_height(&grid, lines)))
+        {
+            pw_desktop_plate_draw(pw_desktop_plates[plate], bits.pixels, bits.width, bits.height);
+            desktop_bits_blend(&bits, nmlvcd->nmcd.hdc);
+        }
+    }
+
     /* item icons */
     himl = (infoPtr->uView == LV_VIEW_ICON ? infoPtr->himlNormal : infoPtr->himlSmall);
     if (himl && item->iImage >= 0 && !IsRectEmpty(&rcIcon))
@@ -4727,7 +4771,7 @@ static void LISTVIEW_DrawItemPart(LISTVIEW_INFO *infoPtr, LVITEMW *item, const N
 
         TRACE("iImage=%d\n", item->iImage);
 
-        if (item->state & (LVIS_SELECTED | LVIS_CUT) && infoPtr->bFocus)
+        if (item->state & (LVIS_SELECTED | LVIS_CUT) && infoPtr->bFocus && !(LV_DESKTOP_LOOK(infoPtr) && !(item->state & LVIS_CUT)))
             style = ILD_SELECTED;
         else
             style = ILD_NORMAL;
@@ -4765,9 +4809,164 @@ static void LISTVIEW_DrawItemPart(LISTVIEW_INFO *infoPtr, LVITEMW *item, const N
     if (infoPtr->uView == LV_VIEW_DETAILS && infoPtr->dwLvExStyle & LVS_EX_GRIDLINES)
         rcLabel.bottom--;
 
+    if (desktop)
+    {
+        const PwGlyphFont *layers[3] = {&pw_desktop_label_fonts[0], &pw_desktop_label_fonts[1], &pw_desktop_label_fonts[2]};
+
+        /* the label's lines with 4 px round them for the shadows, the plate's top left at (4, 4 - the label's top) */
+        if (desktop_bits_open(&bits, nmlvcd->nmcd.hdc, rcBox.left - 4, rcBox.top + 1 + label.top - 4, pw_desktop_plate_width(&grid) + 8,
+                              PW_DESKTOP_LINE * label.lines + 8))
+        {
+            pw_desktop_label_draw(layers, &label, !whole, 4, 4 - label.top, bits.pixels, bits.width, bits.height);
+            desktop_bits_blend(&bits, nmlvcd->nmcd.hdc);
+        }
+        return;
+    }
+    /* a desktop label with a character the prototype's glyphs lack: GDI's text with a soft shadow */
+    if (infoPtr->uView == LV_VIEW_ICON && (infoPtr->dwLvExStyle & LVS_EX_TRANSPARENTSHADOWTEXT))
+        draw_label_shadow(nmlvcd->nmcd.hdc, item->pszText, &rcLabel, format);
     DrawTextW(nmlvcd->nmcd.hdc, item->pszText, -1, &rcLabel, format);
 }
 
+/* A desktop item's label as the prototype lays it out (FALSE: a character its glyphs lack, which GDI draws), whether it shows
+ * all its lines (the selected item with the focus), and the lines its plate holds either way. */
+static BOOL desktop_label(const LISTVIEW_INFO *infoPtr, const LVITEMW *item, const RECT *label_rect, const PwDesktopGrid *grid,
+                          PwDesktopLabel *label, BOOL *whole, int *lines)
+{
+    BOOL laid_out;
+
+    *whole = item->iItem == infoPtr->nFocusedItem && LISTVIEW_GetItemState(infoPtr, item->iItem, LVIS_SELECTED);
+    laid_out = is_text(item->pszText) &&
+               pw_desktop_label_layout(&pw_desktop_label_fonts[2], (const unsigned short *)item->pszText, lstrlenW(item->pszText),
+                                       *whole ? 0 : PW_DESKTOP_CLAMP, grid, label);
+    *lines = laid_out ? label->lines : max(1, (label_rect->bottom - label_rect->top - HEIGHT_PADDING) / max(infoPtr->ntmHeight, 1));
+    return laid_out;
+}
+
+/* A premultiplied 32-bit bitmap (cleared: a new DIB section is zeroed) for the desktop to compose into, then blend onto the
+ * list's DC at (x, y). */
+static BOOL desktop_bits_open(struct desktop_bits *bits, HDC hdc, int x, int y, int width, int height)
+{
+    BITMAPINFO info = { { sizeof(BITMAPINFOHEADER), width, -height, 1, 32, BI_RGB } };
+
+    memset(bits, 0, sizeof(*bits));
+    if (width <= 0 || height <= 0 || width > 8192 || height > 8192) return FALSE;
+    bits->x = x;
+    bits->y = y;
+    bits->width = width;
+    bits->height = height;
+    if (!(bits->dc = CreateCompatibleDC(hdc))) return FALSE;
+    if (!(bits->bitmap = CreateDIBSection(bits->dc, &info, DIB_RGB_COLORS, (void **)&bits->pixels, NULL, 0)))
+    {
+        DeleteDC(bits->dc);
+        return FALSE;
+    }
+    bits->old = SelectObject(bits->dc, bits->bitmap);
+    return TRUE;
+}
+
+static void desktop_bits_blend(struct desktop_bits *bits, HDC hdc)
+{
+    BLENDFUNCTION blend = { AC_SRC_OVER, 0, 255, AC_SRC_ALPHA };
+
+    GdiAlphaBlend(hdc, bits->x, bits->y, bits->width, bits->height, bits->dc, 0, 0, bits->width, bits->height, blend);
+    SelectObject(bits->dc, bits->old);
+    DeleteObject(bits->bitmap);
+    DeleteDC(bits->dc);
+}
+
+/* The desktop's rubber band: the prototype's Highlight-blue border round its 30% fill. */
+static void desktop_draw_band(HDC hdc, const RECT *rect)
+{
+    struct desktop_bits bits;
+
+    if (!desktop_bits_open(&bits, hdc, rect->left, rect->top, rect->right - rect->left, rect->bottom - rect->top)) return;
+    pw_desktop_band_draw(PW_DESKTOP_BAND_BORDER, PW_DESKTOP_BAND_FILL, bits.pixels, bits.width, bits.height);
+    desktop_bits_blend(&bits, hdc);
+}
+
+/* The desktop item under the pointer shows the hover plate; it goes when the pointer leaves the item or the list
+ * (pt NULL: WM_MOUSELEAVE, which the hot item asks for). */
+static void desktop_set_hot(LISTVIEW_INFO *infoPtr, const POINT *pt)
+{
+    TRACKMOUSEEVENT track = { sizeof(track), TME_LEAVE, infoPtr->hwndSelf, 0 };
+    LVHITTESTINFO ht;
+    INT item = -1;
+
+    if (pt)
+    {
+        ht.pt = *pt;
+        item = LISTVIEW_HitTest(infoPtr, &ht, FALSE, FALSE);
+    }
+    if (item == infoPtr->nHotItem) return;
+    if (infoPtr->nHotItem >= 0 && infoPtr->nHotItem < infoPtr->nItemCount) LISTVIEW_InvalidateItem(infoPtr, infoPtr->nHotItem);
+    infoPtr->nHotItem = item;
+    if (item < 0) return;
+    LISTVIEW_InvalidateItem(infoPtr, item);
+    _TrackMouseEvent(&track);
+}
+
+/* The soft shadow under a desktop label whose characters the prototype's glyphs lack: the text is drawn white on black in a bitmap, the
+ * coverage is blurred twice with a three-pixel box, and the result is blended in black one pixel down and to the right of the text. */
+static void draw_label_shadow(HDC hdc, const WCHAR *text, const RECT *label, UINT format)
+{
+    enum { margin = 3 };
+    int width = label->right - label->left + 2 * margin, height = label->bottom - label->top + 2 * margin;
+    BITMAPINFO info = { { sizeof(BITMAPINFOHEADER), width, -height, 1, 32, BI_RGB } };
+    BLENDFUNCTION blend = { AC_SRC_OVER, 0, 255, AC_SRC_ALPHA };
+    unsigned char *coverage, *scratch;
+    DWORD *pixels = NULL;
+    HBITMAP bitmap, old_bitmap;
+    HFONT old_font;
+    HDC dc;
+    RECT rect = { margin, margin, width - margin, height - margin };
+    int x, y, pass;
+
+    if (width <= 2 * margin || height <= 2 * margin || height > 512 || !text || !*text) return;
+    dc = CreateCompatibleDC(hdc);
+    bitmap = CreateDIBSection(dc, &info, DIB_RGB_COLORS, (void **)&pixels, NULL, 0);
+    coverage = malloc(width * height * 2);
+    if (!dc || !bitmap || !coverage) goto done;
+    scratch = coverage + width * height;
+    memset(pixels, 0, width * height * 4);
+    old_bitmap = SelectObject(dc, bitmap);
+    old_font = SelectObject(dc, GetCurrentObject(hdc, OBJ_FONT));
+    SetBkMode(dc, TRANSPARENT);
+    SetTextColor(dc, RGB(255, 255, 255));
+    DrawTextW(dc, text, -1, &rect, format);
+    SelectObject(dc, old_font);
+    SelectObject(dc, old_bitmap);
+    for (x = 0; x < width * height; x++)
+    {
+        unsigned value = max(max(pixels[x] & 0xff, (pixels[x] >> 8) & 0xff), (pixels[x] >> 16) & 0xff);
+        coverage[x] = value;
+    }
+    for (pass = 0; pass < 2; pass++)
+    {
+        for (y = 0; y < height; y++)
+            for (x = 0; x < width; x++)
+            {
+                unsigned sum = coverage[y * width + x] + (x > 0 ? coverage[y * width + x - 1] : 0) + (x + 1 < width ? coverage[y * width + x + 1] : 0);
+                scratch[y * width + x] = sum / 3;
+            }
+        for (y = 0; y < height; y++)
+            for (x = 0; x < width; x++)
+            {
+                unsigned sum = scratch[y * width + x] + (y > 0 ? scratch[(y - 1) * width + x] : 0) + (y + 1 < height ? scratch[(y + 1) * width + x] : 0);
+                coverage[y * width + x] = sum / 3;
+            }
+    }
+    for (x = 0; x < width * height; x++) pixels[x] = (min(255u, coverage[x] * 2u) * 3 / 4) << 24;
+    old_bitmap = SelectObject(dc, bitmap);
+    GdiAlphaBlend(hdc, label->left - margin + 1, label->top - margin + 1, width, height, dc, 0, 0, width, height, blend);
+    SelectObject(dc, old_bitmap);
+
+done:
+    if (bitmap) DeleteObject(bitmap);
+    if (dc) DeleteDC(dc);
+    free(coverage);
+}
+
 /***
  * DESCRIPTION:
  * Draws an item.
@@ -5308,7 +5507,10 @@ enddraw:
 
     /* Draw marquee rectangle if appropriate */
     if (infoPtr->bMarqueeSelect)
-        DrawFocusRect(hdc, &infoPtr->marqueeDrawRect);
+    {
+        if (LV_DESKTOP_LOOK(infoPtr)) desktop_draw_band(hdc, &infoPtr->marqueeDrawRect);
+        else DrawFocusRect(hdc, &infoPtr->marqueeDrawRect);
+    }
 
     if (cdmode & CDRF_NOTIFYPOSTPAINT)
 	notify_postpaint(infoPtr, &nmlvcd);
@@ -7745,6 +7947,17 @@ static INT LISTVIEW_HitTest(const LISTVIEW_INFO *infoPtr, LPLVHITTESTINFO lpht,
 	if (infoPtr->dwLvExStyle & LVS_EX_FULLROWSELECT)
 	    opt.x = lpht->pt.x - Origin.x;
     }
+    else if (LV_DESKTOP_LOOK(infoPtr))
+    {
+        /* the desktop: the whole plate takes the item, as in the prototype and on Windows 11 */
+        PwDesktopGrid grid = pw_desktop_grid(infoPtr->iconSize.cx);
+        PwDesktopLabel label;
+        BOOL whole;
+        int lines;
+
+        desktop_label(infoPtr, &lvItem, &rcLabel, &grid, &label, &whole, &lines);
+        SetRect(&rcBounds, 0, 1, pw_desktop_plate_width(&grid), 1 + pw_desktop_plate_height(&grid, lines));
+    }
     else
     {
         UnionRect(&rcBounds, &rcIcon, &rcLabel);
@@ -7767,6 +7980,8 @@ static INT LISTVIEW_HitTest(const LISTVIEW_INFO *infoPtr, LPLVHITTESTINFO lpht,
     {
 	lpht->flags = LVHT_ONITEM | LVHT_ABOVE;
     }
+    /* the desktop's plate around the icon and label is the item too */
+    if (LV_DESKTOP_LOOK(infoPtr) && !(lpht->flags & LVHT_ONITEM)) lpht->flags |= LVHT_ONITEMICON;
     if (lpht->flags & LVHT_ONITEM)
 	lpht->flags &= ~LVHT_NOWHERE;
     TRACE("lpht->flags=0x%x\n", lpht->flags); 
@@ -10814,7 +11029,8 @@ static LRESULT LISTVIEW_Paint(LISTVIEW_INFO *infoPtr, HDC hdc)
     {
 	infoPtr->bNoItemMetrics = FALSE;
 	LISTVIEW_UpdateItemSize(infoPtr);
-	if (infoPtr->uView == LV_VIEW_ICON || infoPtr->uView == LV_VIEW_SMALLICON)
+	/* not the desktop: the shell placed its icons on their cells before this first paint, and they stay there */
+	if ((infoPtr->uView == LV_VIEW_ICON || infoPtr->uView == LV_VIEW_SMALLICON) && !LV_DESKTOP_LOOK(infoPtr))
 	    LISTVIEW_Arrange(infoPtr, LVA_DEFAULT);
 	LISTVIEW_UpdateScroll(infoPtr);
     }
@@ -11873,6 +12089,10 @@ LISTVIEW_WindowProc(HWND hwnd, UINT uMsg, WPARAM wParam, LPARAM lParam)
   case WM_MOUSEHOVER:
     return LISTVIEW_MouseHover(infoPtr, (SHORT)LOWORD(lParam), (SHORT)HIWORD(lParam));
 
+  case WM_MOUSELEAVE:
+    if (LV_DESKTOP_LOOK(infoPtr)) desktop_set_hot(infoPtr, NULL);
+    return DefWindowProcW(hwnd, uMsg, wParam, lParam);
+
   case WM_NCDESTROY:
     return LISTVIEW_NCDestroy(infoPtr);
 
