From 7445730f6f526a2d002dbae99caacd8d66120973 Mon Sep 17 00:00:00 2001
From: Mihawk <163614687+mihawk-99@users.noreply.github.com>
Date: Sat, 3 Oct 2026 07:24:35 -0400
Subject: [PATCH] ps5: end a game cleanly: close requests, and the presenter
 closed at exit

The title replaced a game's process with LoadExec while the PS5 OpenGL SDK's
presenter, or RADV's swapchain, was still live: at once when the title
stopped a running game, and without the SDK's teardown even after a normal
exit. The console powered off three times on 2026-10-03, each time at such a
switch between processes.

The title now asks a running game to close the way a user would: the PS5
driver turns its close request into WM_CLOSE to the game's window, and a
terminate request into NtTerminateProcess, both on the thread that pumps the
game's messages, so the game ends through Wine's own exit. And exit_process
(and abort_process) runs the exit hooks the graphics drivers register
(wine/ps5/pw_wine_sink.h in PS5_Proton), after the process's other threads
were stopped: OpenGL closes its presenter as the SDK documents it (no
current context, the window surface destroyed, EGL terminated, which drains
the flips, restores the output and frees the presenter's memory), and every
Vulkan device that presents is idled with vkDeviceWaitIdle.
---
 dlls/ntdll/unix/thread.c |  15 ++++-
 dlls/win32u/opengl.c     | 133 +++++++++++++++++++++++++++++++++++++--
 dlls/win32u/ps5drv.c     |  15 ++++-
 dlls/win32u/vulkan.c     |  54 ++++++++++++++++
 4 files changed, 210 insertions(+), 7 deletions(-)

diff --git a/dlls/ntdll/unix/thread.c b/dlls/ntdll/unix/thread.c
index 33f9669..9cc633f 100644
--- a/dlls/ntdll/unix/thread.c
+++ b/dlls/ntdll/unix/thread.c
@@ -1493,6 +1493,11 @@ done:
 }
 
 
+#ifdef __PROSPERO__
+/* wine/ps5/pw_wine_sink.c, linked into ntdll */
+extern void pw_wine_run_exit_hooks(void);
+#endif
+
 /***********************************************************************
  *           abort_thread
  */
@@ -1511,7 +1516,9 @@ void abort_process( int status )
 {
 #ifdef __PROSPERO__
     /* A title never _exits: exit runs the title's atexit handler, which
-     * returns to the launcher, as process_exit_wrapper does. */
+     * returns to the launcher, as process_exit_wrapper does. First the
+     * graphics drivers close their presenters (wine/ps5/pw_wine_sink.h). */
+    pw_wine_run_exit_hooks();
     exit( get_unix_exit_code( status ));
 #else
     _exit( get_unix_exit_code( status ));
@@ -1551,6 +1558,12 @@ static DECLSPEC_NORETURN void exit_thread( int status )
 void exit_process( int status )
 {
     pthread_sigmask( SIG_BLOCK, &server_block_set, NULL );
+#ifdef __PROSPERO__
+    /* The process's other threads are stopped: the graphics drivers close
+     * their presenters and idle the GPU before the title replaces the
+     * process (wine/ps5/pw_wine_sink.h). */
+    pw_wine_run_exit_hooks();
+#endif
     process_exit_wrapper( get_unix_exit_code( status ));
 }
 
diff --git a/dlls/win32u/opengl.c b/dlls/win32u/opengl.c
index 7d12e28..b7c6174 100644
--- a/dlls/win32u/opengl.c
+++ b/dlls/win32u/opengl.c
@@ -791,6 +791,99 @@ static void fs_hack_handle_ds_test( int mode, struct wgl_context *ctx, struct fs
  * title hands its video output over with the first window surface, as for
  * a Vulkan surface (patch 0460). Every window's framebuffer surface presents
  * to that one surface, fitted onto the screen. */
+/* Every EGL context and surface the process creates, so that its presenter
+ * can be closed at exit: the PS5 SDK's eglTerminate shuts the presenter down
+ * (drains the flips, restores the output, frees its memory) only once no
+ * context and no surface is left. */
+static pthread_mutex_t ps5_egl_lock = PTHREAD_MUTEX_INITIALIZER;
+struct ps5_egl_objects { void **items; unsigned int count, capacity; };
+static struct ps5_egl_objects ps5_egl_contexts, ps5_egl_surfaces;
+
+static void ps5_egl_track( struct ps5_egl_objects *objects, void *item )
+{
+    pthread_mutex_lock( &ps5_egl_lock );
+    if (objects->count == objects->capacity)
+    {
+        unsigned int capacity = objects->capacity ? objects->capacity * 2 : 16;
+        void **items = realloc( objects->items, capacity * sizeof(*items) );
+        if (items)
+        {
+            objects->items = items;
+            objects->capacity = capacity;
+        }
+    }
+    if (objects->count < objects->capacity) objects->items[objects->count++] = item;
+    pthread_mutex_unlock( &ps5_egl_lock );
+}
+
+static void ps5_egl_untrack( struct ps5_egl_objects *objects, void *item )
+{
+    pthread_mutex_lock( &ps5_egl_lock );
+    for (unsigned int i = 0; i < objects->count; i++)
+    {
+        if (objects->items[i] != item) continue;
+        objects->items[i] = objects->items[--objects->count];
+        break;
+    }
+    pthread_mutex_unlock( &ps5_egl_lock );
+}
+
+static EGLContext ps5_eglCreateContext( EGLDisplay display, EGLConfig config, EGLContext share,
+                                        const EGLint *attribs )
+{
+    EGLContext context = eglCreateContext( display, config, share, attribs );
+    if (context) ps5_egl_track( &ps5_egl_contexts, context );
+    return context;
+}
+
+static EGLBoolean ps5_eglDestroyContext( EGLDisplay display, EGLContext context )
+{
+    EGLBoolean ret = eglDestroyContext( display, context );
+    if (ret) ps5_egl_untrack( &ps5_egl_contexts, context );
+    return ret;
+}
+
+static EGLSurface ps5_eglCreatePbufferSurface( EGLDisplay display, EGLConfig config, const EGLint *attribs )
+{
+    EGLSurface surface = eglCreatePbufferSurface( display, config, attribs );
+    if (surface) ps5_egl_track( &ps5_egl_surfaces, surface );
+    return surface;
+}
+
+static EGLSurface ps5_eglCreateWindowSurface( EGLDisplay display, EGLConfig config, EGLNativeWindowType window,
+                                              const EGLint *attribs )
+{
+    EGLSurface surface = eglCreateWindowSurface( display, config, window, attribs );
+    if (surface) ps5_egl_track( &ps5_egl_surfaces, surface );
+    return surface;
+}
+
+static EGLBoolean ps5_eglDestroySurface( EGLDisplay display, EGLSurface surface )
+{
+    EGLBoolean ret = eglDestroySurface( display, surface );
+    if (ret) ps5_egl_untrack( &ps5_egl_surfaces, surface );
+    return ret;
+}
+
+/* Destroys every tracked context or surface; returns how many went. */
+static unsigned int ps5_egl_destroy_all( struct ps5_egl_objects *objects, BOOL contexts, unsigned int *total )
+{
+    const struct opengl_funcs *funcs = &display_funcs;
+    unsigned int destroyed = 0;
+    void **items;
+
+    pthread_mutex_lock( &ps5_egl_lock );
+    *total = objects->count;
+    items = *total ? malloc( *total * sizeof(*items) ) : NULL;
+    if (items) memcpy( items, objects->items, *total * sizeof(*items) );
+    pthread_mutex_unlock( &ps5_egl_lock );
+    for (unsigned int i = 0; items && i < *total; i++)
+        destroyed += contexts ? funcs->p_eglDestroyContext( display_egl.display, items[i] )
+                              : funcs->p_eglDestroySurface( display_egl.display, items[i] );
+    free( items );
+    return destroyed;
+}
+
 static EGLSurface ps5_screen_surface;
 
 static void ps5_screen_destroy( struct opengl_drawable *drawable )
@@ -798,6 +891,31 @@ static void ps5_screen_destroy( struct opengl_drawable *drawable )
     drawable->surface = NULL; /* shared by every window, kept for the process */
 }
 
+/* The process is ending (pw_wine_run_exit_hooks, from exit_process, after its
+ * other threads were stopped): close the presenter as the PS5 OpenGL SDK
+ * documents it: no current context, every surface and context destroyed, EGL
+ * terminated, which drains the flips, restores the output and frees the
+ * presenter's memory, so the title never replaces a process whose presenter
+ * is still live. */
+static void ps5_screen_shutdown(void)
+{
+    const struct opengl_funcs *funcs = &display_funcs;
+    unsigned int surfaces, contexts, surfaces_destroyed, contexts_destroyed;
+    EGLBoolean released, terminated;
+    EGLint terminate_error;
+
+    if (!ps5_screen_surface) return;
+    released = funcs->p_eglMakeCurrent( display_egl.display, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT );
+    surfaces_destroyed = ps5_egl_destroy_all( &ps5_egl_surfaces, FALSE, &surfaces );
+    contexts_destroyed = ps5_egl_destroy_all( &ps5_egl_contexts, TRUE, &contexts );
+    ps5_screen_surface = NULL;
+    terminated = funcs->p_eglTerminate( display_egl.display );
+    terminate_error = funcs->p_eglGetError();
+    fprintf( stderr, "wine-ps5: OpenGL presenter closed: release %d, surfaces %u/%u, contexts %u/%u, "
+             "terminate %d (%#x)\n", released, surfaces_destroyed, surfaces, contexts_destroyed, contexts,
+             terminated, terminate_error );
+}
+
 static void ps5_screen_flush( struct opengl_drawable *drawable, UINT flags )
 {
 }
@@ -909,7 +1027,12 @@ static EGLSurface ps5_get_screen_surface( int format )
                        egl->configs[(format - 1) % egl->config_count], 0, NULL )))
             ERR( "Failed to create the PS5 screen surface (error %#x)\n", display_funcs.p_eglGetError() );
         else
+        {
+            int (*add_exit_hook)( void (*)(void) ) = dlsym( RTLD_DEFAULT, "pw_wine_add_exit_hook" );
+            if (!add_exit_hook || add_exit_hook( ps5_screen_shutdown ))
+                ERR( "the PS5 presenter cannot be closed at exit\n" );
             TRACE( "created the PS5 screen surface %p\n", ps5_screen_surface );
+        }
     }
     surface = ps5_screen_surface;
     pthread_mutex_unlock( &lock );
@@ -1679,11 +1802,11 @@ static BOOL egl_init( const struct opengl_driver_funcs **driver_funcs )
     funcs->p_eglQueryString = eglQueryString;
     funcs->p_eglBindAPI = eglBindAPI;
     funcs->p_eglChooseConfig = eglChooseConfig;
-    funcs->p_eglCreateContext = eglCreateContext;
-    funcs->p_eglCreatePbufferSurface = eglCreatePbufferSurface;
-    funcs->p_eglCreateWindowSurface = eglCreateWindowSurface;
-    funcs->p_eglDestroyContext = eglDestroyContext;
-    funcs->p_eglDestroySurface = eglDestroySurface;
+    funcs->p_eglCreateContext = ps5_eglCreateContext;
+    funcs->p_eglCreatePbufferSurface = ps5_eglCreatePbufferSurface;
+    funcs->p_eglCreateWindowSurface = ps5_eglCreateWindowSurface;
+    funcs->p_eglDestroyContext = ps5_eglDestroyContext;
+    funcs->p_eglDestroySurface = ps5_eglDestroySurface;
     funcs->p_eglGetConfigAttrib = eglGetConfigAttrib;
     funcs->p_eglGetConfigs = eglGetConfigs;
     funcs->p_eglGetDisplay = eglGetDisplay;
diff --git a/dlls/win32u/ps5drv.c b/dlls/win32u/ps5drv.c
index 443a75a..352771c 100644
--- a/dlls/win32u/ps5drv.c
+++ b/dlls/win32u/ps5drv.c
@@ -68,7 +68,7 @@ WINE_DEFAULT_DEBUG_CHANNEL(ps5drv);
 /* the layout of PwWineInput in wine/ps5/pw_wine_sink.h */
 struct ps5_input
 {
-    UINT type;              /* 1 key, 2 mouse move, 3 mouse button */
+    UINT type;              /* 1 key, 2 mouse move, 3 mouse button, 4 close, 5 terminate */
     UINT code;              /* virtual key, or button 0 left 1 right 2 middle */
     INT  x, y;              /* mouse move: relative motion in desktop pixels */
     UINT down;
@@ -577,6 +577,19 @@ static BOOL ps5_ProcessEvents( DWORD mask )
         case 3:
             if (event.code < 3) send_mouse( hwnd, button_flags[event.code][event.down != 0], 0, 0 );
             break;
+        case 4:
+            /* the title asks the game to close, as a user closing its window
+             * would; the game then ends through its own exit */
+            if (!hwnd) hwnd = last_shown_window();
+            fprintf( stderr, "wine-ps5: close requested: WM_CLOSE to window %p\n", hwnd );
+            if (hwnd) NtUserPostMessage( hwnd, WM_CLOSE, 0, 0 );
+            break;
+        case 5:
+            /* the game did not close: end the process through Wine's exit,
+             * which stops its threads and closes the presenter first */
+            fprintf( stderr, "wine-ps5: terminate requested\n" );
+            NtTerminateProcess( NtCurrentProcess(), 0 );
+            break;
         }
     }
     return processed != 0;
diff --git a/dlls/win32u/vulkan.c b/dlls/win32u/vulkan.c
index 5a8ef23..70b15ca 100644
--- a/dlls/win32u/vulkan.c
+++ b/dlls/win32u/vulkan.c
@@ -3079,6 +3079,54 @@ static BOOL surface_get_fshack_dpi( struct surface *surface )
     return fshack_enabled && dpi != raw ? raw : 0;
 }
 
+#ifdef __PROSPERO__
+/* Devices that present, for the end of the process: each gets vkDeviceWaitIdle
+ * from pw_wine_run_exit_hooks, so none of the process's GPU work is in flight
+ * when the title replaces it. Counted by swapchain: a device outlives its
+ * swapchains, so a device with one is still valid. */
+static pthread_mutex_t presenting_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct { struct vulkan_device *device; unsigned int swapchains; } presenting[8];
+
+static void ps5_vulkan_idle_at_exit(void)
+{
+    pthread_mutex_lock( &presenting_lock );
+    for (unsigned int i = 0; i < ARRAY_SIZE(presenting); i++)
+    {
+        VkResult res;
+        if (!presenting[i].swapchains) continue;
+        res = presenting[i].device->p_vkDeviceWaitIdle( presenting[i].device->host.device );
+        fprintf( stderr, "wine-ps5: Vulkan device idle at exit: %d\n", res );
+    }
+    pthread_mutex_unlock( &presenting_lock );
+}
+
+static void ps5_note_swapchain( struct vulkan_device *device, int delta )
+{
+    static BOOL hooked;
+    unsigned int i, free_slot = ARRAY_SIZE(presenting);
+
+    pthread_mutex_lock( &presenting_lock );
+    if (!hooked)
+    {
+        int (*add_exit_hook)( void (*)(void) ) = dlsym( RTLD_DEFAULT, "pw_wine_add_exit_hook" );
+        hooked = add_exit_hook && !add_exit_hook( ps5_vulkan_idle_at_exit );
+        if (!hooked) ERR( "the PS5 Vulkan devices cannot be idled at exit\n" );
+    }
+    for (i = 0; i < ARRAY_SIZE(presenting); i++)
+    {
+        if (presenting[i].swapchains && presenting[i].device == device) break;
+        if (!presenting[i].swapchains && free_slot == ARRAY_SIZE(presenting)) free_slot = i;
+    }
+    if (i == ARRAY_SIZE(presenting) && delta > 0 && free_slot < ARRAY_SIZE(presenting))
+    {
+        i = free_slot;
+        presenting[i].device = device;
+    }
+    if (i < ARRAY_SIZE(presenting)) presenting[i].swapchains += delta;
+    pthread_mutex_unlock( &presenting_lock );
+}
+#endif
+
 static VkResult win32u_vkCreateSwapchainKHR( VkDevice client_device, const VkSwapchainCreateInfoKHR *create_info,
                                              const VkAllocationCallbacks *allocator, VkSwapchainKHR *ret )
 {
@@ -3194,6 +3242,9 @@ static VkResult win32u_vkCreateSwapchainKHR( VkDevice client_device, const VkSwa
               debugstr_vkextent2d(&swapchain->extents), debugstr_vkextent2d(&swapchain->host_extents) );
     }
 
+#ifdef __PROSPERO__
+    ps5_note_swapchain( device, 1 );
+#endif
     *ret = swapchain->obj.client.swapchain;
     return VK_SUCCESS;
 }
@@ -3232,6 +3283,9 @@ void win32u_vkDestroySwapchainKHR( VkDevice client_device, VkSwapchainKHR client
 
     device->p_vkDestroySwapchainKHR( device->host.device, swapchain->obj.host.swapchain, NULL );
     instance->p_remove_object( instance, &swapchain->obj.obj );
+#ifdef __PROSPERO__
+    ps5_note_swapchain( device, -1 );
+#endif
 
     free( swapchain );
 }
-- 
