+/* The prototype's taskbar (src/pw_taskbar_layout.h): Start, search, Task View and the pins centred, a pinned app's
+ * windows shown on its pin, the other windows after the pins, the tray at the right. */
+static void taskbar_layout_prototype(void)
+{
+    struct taskbar_button *win; PwTaskbarPlace place; unsigned slots = PW_TASKBAR_PINS, at = PW_TASKBAR_PINS, i;
+    HWND foreground = GetAncestor(GetForegroundWindow(), GA_ROOTOWNER);
+    HWND pin_window[PW_TASKBAR_PINS] = {0}; BOOL running[PW_TASKBAR_PINS] = {0}, active[PW_TASKBAR_PINS] = {0};
+    LIST_FOR_EACH_ENTRY(win, &taskbar_buttons, struct taskbar_button, entry)
+    {
+        WCHAR title[256], previous[256];
+        if (!win->hwnd) continue;
+        win->active = win->hwnd == foreground;
+        win->visible = taskbar_eligible(win->hwnd);
+        GetWindowTextW(win->hwnd, title, ARRAY_SIZE(title)); GetWindowTextW(win->button, previous, ARRAY_SIZE(previous));
+        if (lstrcmpW(title, previous))
+        {
+            win->placed_shown = FALSE;
+            lstrcpyW(win->title, title); SetWindowTextW(win->button, title);
+            if (win->tooltip)
+            {
+                TTTOOLINFOW tip = {sizeof(tip)}; tip.hwnd = tray_window; tip.uId = (UINT_PTR)win->button;
+                tip.uFlags = TTF_SUBCLASS | TTF_IDISHWND; tip.lpszText = win->title;
+                SendMessageW(win->tooltip, TTM_UPDATETIPTEXTW, 0, (LPARAM)&tip);
+            }
+        }
+        if (!win->visible) continue;
+        int pin = taskbar_window_pin(win);
+        if (pin < 0) { ++slots; continue; }
+        running[pin] = TRUE;
+        if (win->active) { active[pin] = TRUE; pin_window[pin] = win->hwnd; }
+        else if (!pin_window[pin]) pin_window[pin] = win->hwnd;
+    }
+    pw_taskbar_place(&place, tray_width, slots, taskbar_clock_text_width(), 0);
+    /* notification icons stay left of the chevron (they are placed from the right past this width) */
+    taskbar_clock_width = tray_width - place.chevron.left + 4;
+    taskbar_text_right = place.text_right - place.clock.left;
+    taskbar_time_top = place.time_top - place.clock.top; taskbar_date_top = place.date_top - place.clock.top;
+    BOOL overflow = place.apps_shown < slots;
+    unsigned room = overflow && place.apps_shown ? place.apps_shown - 1 : place.apps_shown;
+    LIST_FOR_EACH_ENTRY(win, &taskbar_buttons, struct taskbar_button, entry)
+    {
+        if (!win->hwnd) { taskbar_put(win->button, &place.start, &win->placed); win->placed_shown = TRUE; continue; }
+        if (win->visible && win->pin < 0 && at < room)
+        {
+            RECT before = win->placed;
+            taskbar_put(win->button, &place.apps[at++], &win->placed);
+            if (!win->placed_shown || !EqualRect(&before, &win->placed)) InvalidateRect(win->button, NULL, FALSE);
+            win->placed_shown = TRUE;
+        }
+        else if (win->placed_shown || IsWindowVisible(win->button))
+        { ShowWindow(win->button, SW_HIDE); win->placed_shown = FALSE; SetRectEmpty(&win->placed); }
+    }
+    taskbar_put(taskbar_search, &place.search, &taskbar_fixed_placed[0]);
+    taskbar_put(taskbar_taskview, &place.taskview, &taskbar_fixed_placed[1]);
+    taskbar_put(taskbar_chevron, &place.chevron, &taskbar_fixed_placed[2]);
+    taskbar_put(taskbar_status, &place.status, &taskbar_fixed_placed[3]);
+    for (i = 0; i < PW_TASKBAR_PINS; ++i)
+    {
+        if (running[i] != taskbar_pin_running[i] || active[i] != taskbar_pin_active[i]) InvalidateRect(taskbar_pins[i], NULL, FALSE);
+        taskbar_pin_window[i] = pin_window[i]; taskbar_pin_running[i] = running[i]; taskbar_pin_active[i] = active[i];
+        if (i < room) taskbar_put(taskbar_pins[i], &place.apps[i], &taskbar_fixed_placed[4 + i]);
+        else if (IsWindowVisible(taskbar_pins[i])) { ShowWindow(taskbar_pins[i], SW_HIDE); SetRectEmpty(&taskbar_fixed_placed[4 + i]); }
+    }
+    if (overflow) taskbar_put(taskbar_overflow, &place.apps[place.apps_shown - 1], &taskbar_overflow_placed);
+    else if (IsWindowVisible(taskbar_overflow)) { ShowWindow(taskbar_overflow, SW_HIDE); SetRectEmpty(&taskbar_overflow_placed); }
+    taskbar_overflow_shown = overflow;
+    taskbar_put(taskbar_clock, &place.clock, &taskbar_clock_placed);
+}
+
 /* Theme, font, DPI or display changes: every button, the overflow and the clock are placed and painted again. */
 static void taskbar_forget_placement(void)
 {
     struct taskbar_button *win;
     LIST_FOR_EACH_ENTRY(win, &taskbar_buttons, struct taskbar_button, entry) win->placed_shown = FALSE;
     SetRectEmpty(&taskbar_overflow_placed); SetRectEmpty(&taskbar_clock_placed);
+    for (unsigned int i = 0; i < ARRAY_SIZE(taskbar_fixed_placed); ++i) SetRectEmpty(&taskbar_fixed_placed[i]);
+    LIST_FOR_EACH_ENTRY(win, &taskbar_buttons, struct taskbar_button, entry) SetRectEmpty(&win->placed);
     taskbar_overflow_shown = -1;
 }
 
