+/* A 40 px plate sprite at another width: its two halves at the ends, its middle column between (a plate is the same
+ * in every column between its 4 px corners). */
+static void taskbar_plate(HDC dc, unsigned sprite, int width)
+{
+    const struct pw_shell_sprite *s = &pw_shell_sprites[!!taskbar_dark][sprite];
+    if (width == s->width) { pw_taskbar_sprite(dc, taskbar_dark, sprite, 0, 0); return; }
+    int half = min(width, s->width) / 2;
+    BITMAPINFO info = {{sizeof(BITMAPINFOHEADER), s->width, -s->height, 1, 32, BI_RGB}};
+    void *bits = NULL; HBITMAP bitmap = CreateDIBSection(NULL, &info, DIB_RGB_COLORS, &bits, NULL, 0); HDC source;
+    if (!bitmap || !bits || !(source = CreateCompatibleDC(dc))) { if (bitmap) DeleteObject(bitmap); return; }
+    memcpy(bits, s->bgra, (size_t)s->width * s->height * 4);
+    HGDIOBJ prior = SelectObject(source, bitmap); BLENDFUNCTION blend = {AC_SRC_OVER, 0, 255, AC_SRC_ALPHA};
+    GdiAlphaBlend(dc, 0, 0, half, s->height, source, 0, 0, half, s->height, blend);
+    GdiAlphaBlend(dc, width - half, 0, half, s->height, source, s->width - half, 0, half, s->height, blend);
+    if (width > 2 * half) GdiAlphaBlend(dc, half, 0, width - 2 * half, s->height, source, s->width / 2, 0, 1, s->height, blend);
+    SelectObject(source, prior); DeleteDC(source); DeleteObject(bitmap);
+}
+
+/* The prototype's own pixels for Start, the search pill, Task View, the tray buttons, the pins and the other windows'
+ * buttons (their plates and pills; a window's own icon in between). FALSE: not one of them. */
+static BOOL taskbar_paint_prototype(const DRAWITEMSTRUCT *dis, struct taskbar_button *win)
+{
+    HWND item = dis->hwndItem; HDC dc = NULL; HPAINTBUFFER glass; RECT rect = dis->rcItem; int pin = -1, width;
+    BOOL hot = !!GetPropW(item, L"MihawkTaskbarHot"), pressed = !!(dis->itemState & ODS_SELECTED), dark = taskbar_dark;
+    for (int i = 0; i < PW_TASKBAR_PINS; ++i) if (item == taskbar_pins[i]) pin = i;
+    if (!taskbar_prototype || !(win || pin >= 0 || item == taskbar_search || item == taskbar_taskview ||
+                                item == taskbar_chevron || item == taskbar_status)) return FALSE;
+    if (!(glass = pw_shell_glass_begin(dis->hDC, &rect, &dc))) return FALSE;
+    width = rect.right - rect.left;
+    if (item == taskbar_search) pw_taskbar_sprite(dc, dark, hot || pressed ? PW_SPRITE_SEARCH_HOVER : PW_SPRITE_SEARCH, 0, 0);
+    else if (win && !win->hwnd)
+    {
+        if (pressed) { taskbar_plate(dc, PW_SPRITE_PLATE_PRESS, width); pw_taskbar_sprite(dc, dark, PW_SPRITE_START, 0, 0); }
+        else pw_taskbar_sprite(dc, dark, hot ? PW_SPRITE_START_HOVER : PW_SPRITE_START, 0, 0);
+    }
+    else
+    {
+        BOOL active = pin >= 0 ? taskbar_pin_active[pin] : win && win->active;
+        if (pressed) taskbar_plate(dc, PW_SPRITE_PLATE_PRESS, width);
+        else if (active) taskbar_plate(dc, PW_SPRITE_PLATE_ACTIVE, width);
+        else if (hot) taskbar_plate(dc, PW_SPRITE_PLATE_HOVER, width);
+        if (item == taskbar_taskview) pw_taskbar_sprite(dc, dark, PW_SPRITE_TASKVIEW, 0, 0);
+        else if (item == taskbar_chevron) pw_taskbar_sprite(dc, dark, PW_SPRITE_CHEVRON, 0, 0);
+        else if (item == taskbar_status) pw_taskbar_sprite(dc, dark, PW_SPRITE_STATUS, 0, 0);
+        else if (pin >= 0)
+        {
+            pw_taskbar_sprite(dc, dark, pw_taskbar_pin_apps[pin].sprite, 0, 0);
+            if (taskbar_pin_running[pin]) pw_taskbar_pill(dc, dark, active, width);
+        }
+        else
+        {
+            HICON icon = taskbar_window_icon(win);
+            if (!icon) icon = LoadIconW(NULL, (LPCWSTR)IDI_APPLICATION);
+            if (icon) DrawIconEx(dc, (width - 24) / 2, (rect.bottom - rect.top - 24) / 2, icon, 24, 24, 0, NULL, DI_NORMAL);
+            pw_shell_glass_fix(glass);  /* a masked icon becomes opaque; the sprites are premultiplied and stay */
+            pw_taskbar_pill(dc, dark, active, width);
+        }
+    }
+    if ((dis->itemState & ODS_FOCUS) && !(dis->itemState & ODS_NOFOCUSRECT))
+    { InflateRect(&rect, -2, -2); DrawFocusRect(dc, &rect); pw_shell_glass_fix(glass); }
+    EndBufferedPaint(glass, TRUE);
+    return TRUE;
+}
