+/* The pinned app a window's process is (looked up once per window). */
+static int taskbar_window_pin(struct taskbar_button *win)
+{
+    if (win->pin == -2)
+    {
+        WCHAR path[MAX_PATH]; DWORD length = ARRAY_SIZE(path), pid = 0; HANDLE process;
+        win->pin = -1;
+        GetWindowThreadProcessId(win->hwnd, &pid);
+        if ((process = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pid)))
+        {
+            if (QueryFullProcessImageNameW(process, 0, path, &length)) win->pin = pw_taskbar_pin_of(path);
+            CloseHandle(process);
+        }
+    }
+    return win->pin;
+}
+
+/* A window moved or shown only when its place changed, and repainted then. */
+static void taskbar_put(HWND hwnd, const PwTaskbarRect *r, RECT *placed)
+{
+    RECT place = {r->left, r->top, r->right, r->bottom};
+    if (EqualRect(&place, placed) && IsWindowVisible(hwnd)) return;
+    SetWindowPos(hwnd, NULL, place.left, place.top, place.right - place.left, place.bottom - place.top,
+                 SWP_NOACTIVATE | SWP_NOZORDER | SWP_SHOWWINDOW);
+    InvalidateRect(hwnd, NULL, FALSE);
+    *placed = place;
+}
+
+static int taskbar_clock_text_width(void)
+{
+    int time_width = pw_taskbar_text_width(taskbar_dark, taskbar_time), date_width = pw_taskbar_text_width(taskbar_dark, taskbar_date);
+    /* As the prototype lays the lines out: Blink's box, the advances rounded up to 1/64 px, to the nearest pixel. */
+    if (taskbar_prototype && time_width >= 0 && date_width >= 0) return (((max(time_width, date_width) + 1023) & ~1023) + 32768) >> 16;
+    HDC dc = GetDC(tray_window); SIZE time = {0}, date = {0};
+    HGDIOBJ prior = SelectObject(dc, taskbar_font ? taskbar_font : GetStockObject(DEFAULT_GUI_FONT));
+    GetTextExtentPoint32W(dc, taskbar_time, lstrlenW(taskbar_time), &time);
+    GetTextExtentPoint32W(dc, taskbar_date, lstrlenW(taskbar_date), &date);
+    SelectObject(dc, prior); ReleaseDC(tray_window, dc);
+    return max(time.cx, date.cx);
+}
