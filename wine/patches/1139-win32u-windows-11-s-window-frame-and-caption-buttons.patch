+/* Windows 11 shows a framed top-level window inside its resize border, as DWM does: a 1-pixel border and what it
+ * encloses (the whole frame when maximized). The rest of the frame is invisible yet still sizes the window. Returns
+ * the invisible part on each side, or FALSE for a window without such a frame. */
+BOOL get_dwm_frame_inset( UINT style, UINT ex_style, SIZE *inset )
+{
+    if (style & WS_CHILD) return FALSE;
+    if (has_thick_frame( style, ex_style ))
+    {
+        inset->cx = get_system_metrics( SM_CXFRAME );
+        inset->cy = get_system_metrics( SM_CYFRAME );
+    }
+    else if (has_dialog_frame( style, ex_style ))
+    {
+        inset->cx = get_system_metrics( SM_CXDLGFRAME );
+        inset->cy = get_system_metrics( SM_CYDLGFRAME );
+    }
+    else return FALSE;
+    if (!(style & WS_MAXIMIZE))
+    {
+        inset->cx -= get_system_metrics( SM_CXBORDER );
+        inset->cy -= get_system_metrics( SM_CYBORDER );
+    }
+    return TRUE;
+}
