+/* Redraw the caption button a hit code names: 0 normal, 1 pressed, 2 hot. */
+static void draw_caption_button( HWND hwnd, HDC hdc, UINT hit, BOOL down )
+{
+    DWORD style = get_window_long( hwnd, GWL_STYLE );
+    UINT state;
+
+    if (!(style & WS_SYSMENU) || (style & WS_CAPTION) != WS_CAPTION) return;
+    switch (hit)
+    {
+    case HTCLOSE:
+        state = get_menu_state( NtUserGetSystemMenu( hwnd, FALSE ), SC_CLOSE, MF_BYCOMMAND );
+        draw_close_button( hwnd, hdc, down, (state & (MF_DISABLED | MF_GRAYED)) || state == 0xFFFFFFFF );
+        break;
+    case HTMAXBUTTON:
+        if (style & (WS_MAXIMIZEBOX | WS_MINIMIZEBOX)) draw_max_button( hwnd, hdc, down, !(style & WS_MAXIMIZEBOX) );
+        break;
+    case HTMINBUTTON:
+        if (style & (WS_MAXIMIZEBOX | WS_MINIMIZEBOX)) draw_min_button( hwnd, hdc, down, !(style & WS_MINIMIZEBOX) );
+        break;
+    }
+}
+
+/* Windows 11 lights the caption button under the pointer until the pointer leaves it. */
+static void set_caption_hot( HWND hwnd, UINT hot )
+{
+    WND *win = get_win_ptr( hwnd );
+    UINT old;
+    HDC hdc;
+
+    if (!win || win == WND_OTHER_PROCESS || win == WND_DESKTOP) return;
+    old = win->caption_hot;
+    win->caption_hot = hot;
+    release_win_ptr( win );
+    if (old == hot || !(hdc = NtUserGetWindowDC( hwnd ))) return;
+    if (old) draw_caption_button( hwnd, hdc, old, FALSE );
+    if (hot) draw_caption_button( hwnd, hdc, hot, 2 );
+    NtUserReleaseDC( hwnd, hdc );
+}
