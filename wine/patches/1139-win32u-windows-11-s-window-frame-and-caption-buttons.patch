+/* Windows 11's caption buttons: the caption's full height, SM_CXSIZE wide, side by side from the inside rectangle's
+ * right edge, close first. A tool window keeps its small close button. */
+static void get_caption_button_rect( HWND hwnd, DWORD style, DWORD ex_style, int index, RECT *rect )
+{
+    get_inside_rect( hwnd, COORDS_WINDOW, rect, style, ex_style );
+    rect->right -= index * get_system_metrics( SM_CXSIZE );
+    rect->left = rect->right - get_system_metrics( SM_CXSIZE );
+    rect->bottom = rect->top + get_system_metrics( SM_CYCAPTION );
+}
+
+/* The caption button the pointer is over (HTCLOSE, HTMAXBUTTON, HTMINBUTTON) or 0, drawn hot. */
+static UINT get_caption_hot( HWND hwnd )
+{
+    WND *win = get_win_ptr( hwnd );
+    UINT hot = 0;
+
+    if (win && win != WND_OTHER_PROCESS && win != WND_DESKTOP)
+    {
+        hot = win->caption_hot;
+        release_win_ptr( win );
+    }
+    return hot;
+}
