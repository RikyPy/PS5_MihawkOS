     int            is_unicode;  /* ANSI or unicode */
     lparam_t       info;        /* current window info value */
+    object_id_t    generation;  /* lifetime identity for retained surfaces */
+    int            native_pid;  /* process allowed to publish this surface */
 @END
 
 
