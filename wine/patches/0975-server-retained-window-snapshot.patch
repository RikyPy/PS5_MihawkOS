+#ifdef __PROSPERO__
+/* Only Wine's server thread/lock touches window objects. Broker readers copy
+ * this independent bounded record; they never traverse mutable Wine lists. */
+static uint64_t ps5_window_generation;
+static int ps5_windows_dirty = 1;
+static pthread_mutex_t ps5_snapshot_mutex = PTHREAD_MUTEX_INITIALIZER;
+static PwWindowSnapshot ps5_snapshot;
+struct desktop *ps5_hardware_desktop(void);
+
+DECLSPEC_EXPORT int pw_wineserver_windows(void *output, unsigned int bytes)
+{
+    if (!output || bytes != sizeof(ps5_snapshot)) { errno = EINVAL;return -1; }
+    pthread_mutex_lock(&ps5_snapshot_mutex);
+    memcpy(output, &ps5_snapshot, sizeof(ps5_snapshot));
+    pthread_mutex_unlock(&ps5_snapshot_mutex);
+    return 0;
+}
+
+void ps5_windows_note_request(unsigned int request)
+{
+    switch (request)
+    {
+    case REQ_create_window: case REQ_destroy_window: case REQ_get_desktop_window:
+    case REQ_init_window_info: case REQ_set_window_info: case REQ_set_window_pos:
+    case REQ_set_parent: case REQ_set_window_owner: case REQ_set_window_region:
+    case REQ_update_window_zorder: case REQ_set_window_layered_info:
+    case REQ_create_desktop: case REQ_set_input_desktop: case REQ_set_thread_desktop:
+        ps5_windows_dirty = 1;break;
+    }
+}
+
+static void ps5_snapshot_add(PwWindowSnapshot *snapshot, const struct window *win, int desktop)
+{
+    PwWindowRow *row;
+    if (snapshot->count == PW_WINDOW_LIMIT) { snapshot->overflow = 1;return; }
+    row = &snapshot->windows[snapshot->count++];
+    row->hwnd = win->handle;
+    row->generation = win->ps5_generation;
+    row->pid = win->thread ? win->thread->process->unix_pid : 0;
+    row->windows_pid = win->thread ? win->thread->process->id : 0;
+    row->owner = win->owner;
+    row->left = win->visible_rect.left;
+    row->top = win->visible_rect.top;
+    row->right = win->visible_rect.right;
+    row->bottom = win->visible_rect.bottom;
+    if ((win->style & WS_VISIBLE) && !(win->style & WS_MINIMIZE))row->flags |= PW_WINDOW_VISIBLE;
+    if (desktop)row->flags |= PW_WINDOW_DESKTOP;
+    if (win->win_region || (win->ex_style & WS_EX_LAYERED))row->flags |= PW_WINDOW_UNSUPPORTED;
+}
+
+void ps5_windows_publish(void)
+{
+    PwWindowSnapshot snapshot = {0};
+    struct desktop *desktop;
+    struct window *win;
+    unsigned int saved_error, saved_global_error;
+    if (!ps5_windows_dirty)return;
+    saved_error = get_error();
+    saved_global_error = global_error;
+    snapshot.version = PW_WINDOW_SNAPSHOT_VERSION;
+    snapshot.size = sizeof(snapshot);
+    desktop = ps5_hardware_desktop();
+    if (desktop)
+    {
+        if (desktop->top_window)
+        {
+            LIST_FOR_EACH_ENTRY(win, &desktop->top_window->children, struct window, entry)
+                ps5_snapshot_add(&snapshot,win,0);
+            ps5_snapshot_add(&snapshot,desktop->top_window,1);
+        }
+        release_object(desktop);
+    }
+    set_error(saved_error);
+    global_error = saved_global_error;
+    pthread_mutex_lock(&ps5_snapshot_mutex);
+    snapshot.sequence = ps5_snapshot.sequence + 1;
+    ps5_snapshot = snapshot;
+    pthread_mutex_unlock(&ps5_snapshot_mutex);
+    ps5_windows_dirty = 0;
+}
+#endif
+
 static const struct rectangle empty_rect;
 
