--- a/dlls/uxtheme/window.c
+++ b/dlls/uxtheme/window.c
@@ -64,6 +64,33 @@
     DrawThemeBackground(theme, hdc, part, state, &rect, NULL);
 }
 
+/* Ordinary caption buttons use the same theme parts as applications drawing
+ * Window chrome. The existing caption paint already provides the background
+ * beneath partially transparent sprites; painting the parent here would erase it. */
+static void uxtheme_draw_caption_button(HTHEME theme, HWND hwnd, HDC hdc,
+                                        enum NONCLIENT_BUTTON_TYPE type, RECT rect, BOOL down, BOOL grayed)
+{
+    int part, state;
+    HRESULT result;
+
+    switch (type)
+    {
+    case CAPTION_CLOSE_BUTTON: part = WP_CLOSEBUTTON; break;
+    case CAPTION_SMALL_CLOSE_BUTTON: part = WP_SMALLCLOSEBUTTON; break;
+    case CAPTION_MIN_BUTTON: part = WP_MINBUTTON; break;
+    case CAPTION_MAX_BUTTON: part = WP_MAXBUTTON; break;
+    case CAPTION_RESTORE_BUTTON: part = WP_RESTOREBUTTON; break;
+    default: return;
+    }
+    state = grayed ? CBS_DISABLED : down ? CBS_PUSHED : CBS_NORMAL;
+    if (GetActiveWindow() != hwnd) state += 4;
+    if (!IsThemePartDefined(theme, part, 0))
+        result = E_NOTIMPL;
+    else
+        result = DrawThemeBackground(theme, hdc, part, state, &rect, NULL);
+    if (FAILED(result)) user_api.pNonClientButtonDraw(hwnd, hdc, type, rect, down, grayed);
+}
+
 void WINAPI UXTHEME_NonClientButtonDraw(HWND hwnd, HDC hdc, enum NONCLIENT_BUTTON_TYPE type,
                                         RECT rect, BOOL down, BOOL grayed)
 {
