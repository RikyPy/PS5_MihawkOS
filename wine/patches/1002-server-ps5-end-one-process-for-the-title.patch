diff --git a/server/window.c b/server/window.c
--- a/server/window.c
+++ b/server/window.c
@@ -1270,6 +1270,25 @@
     return 1;
 }
 
+#ifdef __PROSPERO__
+/* WM_CLOSE to each visible top-level window of process, as a user closing them would (the title's memory guard in
+ * the desktop session, queue.c ps5_inject_input); how many were asked. */
+unsigned int ps5_close_process_windows( struct desktop *desktop, struct process *process )
+{
+    struct window *win;
+    unsigned int count = 0;
+
+    if (!desktop->top_window) return 0;
+    LIST_FOR_EACH_ENTRY( win, &desktop->top_window->children, struct window, entry )
+    {
+        if (!win->thread || win->thread->process != process || !is_visible( win )) continue;
+        post_message( win->handle, WM_CLOSE, 0, 0 );
+        count++;
+    }
+    return count;
+}
+#endif
+
 /* same as is_visible but takes a window handle */
 int is_window_visible( user_handle_t window )
 {
