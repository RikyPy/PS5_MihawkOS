+/* PS5 DWM state: dwmapi's attributes and thumbnails reach the server here.
+ * The server owns validation and ownership; the compositor reads its snapshot. */
+static NTSTATUS ps5_dwm_call( HWND hwnd, struct ps5_dwm_params *params )
+{
+    NTSTATUS status = STATUS_INVALID_PARAMETER;
+
+    switch (params->op)
+    {
+    case PS5_DWM_SET:
+        SERVER_START_REQ( ps5_set_window_dwm )
+        {
+            req->window         = wine_server_user_handle( hwnd );
+            req->attribute      = params->attribute;
+            req->value          = params->value;
+            req->margins.left   = params->rect.left;
+            req->margins.top    = params->rect.top;
+            req->margins.right  = params->rect.right;
+            req->margins.bottom = params->rect.bottom;
+            status = wine_server_call( req );
+        }
+        SERVER_END_REQ;
+        break;
+    case PS5_DWM_GET:
+        SERVER_START_REQ( ps5_get_window_dwm )
+        {
+            req->window    = wine_server_user_handle( hwnd );
+            req->attribute = params->attribute;
+            if (!(status = wine_server_call( req ))) params->value = reply->value;
+        }
+        SERVER_END_REQ;
+        break;
+    case PS5_DWM_REGISTER:
+        SERVER_START_REQ( ps5_register_thumbnail )
+        {
+            req->destination = wine_server_user_handle( hwnd );
+            req->source      = wine_server_user_handle( UlongToHandle( params->source ));
+            if (!(status = wine_server_call( req ))) params->id = reply->id;
+        }
+        SERVER_END_REQ;
+        break;
+    case PS5_DWM_UPDATE:
+        SERVER_START_REQ( ps5_update_thumbnail )
+        {
+            req->id                      = params->id;
+            req->flags                   = params->flags;
+            req->options                 = params->options;
+            req->opacity                 = params->opacity;
+            req->destination_rect.left   = params->rect.left;
+            req->destination_rect.top    = params->rect.top;
+            req->destination_rect.right  = params->rect.right;
+            req->destination_rect.bottom = params->rect.bottom;
+            req->source_rect.left        = params->source_rect.left;
+            req->source_rect.top         = params->source_rect.top;
+            req->source_rect.right       = params->source_rect.right;
+            req->source_rect.bottom      = params->source_rect.bottom;
+            status = wine_server_call( req );
+        }
+        SERVER_END_REQ;
+        break;
+    case PS5_DWM_UNREGISTER:
+        SERVER_START_REQ( ps5_unregister_thumbnail )
+        {
+            req->id = params->id;
+            status = wine_server_call( req );
+        }
+        SERVER_END_REQ;
+        break;
+    case PS5_DWM_QUERY:
+        SERVER_START_REQ( ps5_query_thumbnail_size )
+        {
+            req->id = params->id;
+            if (!(status = wine_server_call( req )))
+            {
+                params->width  = reply->width;
+                params->height = reply->height;
+            }
+        }
+        SERVER_END_REQ;
+        break;
+    }
+    return status;
+}
+
 /*****************************************************************************
  *           NtUserCallHwndParam (win32u.@)
  */
@@ -6440,6 +6523,9 @@ ULONG_PTR WINAPI NtUserCallHwndParam( HWND hwnd, DWORD_PTR param, DWORD code )
         return set_raw_window_pos( hwnd, params->rect, params->flags, params->internal );
     }
 
+    case NtUserCallHwndParam_Ps5Dwm:
+        return ps5_dwm_call( hwnd, (struct ps5_dwm_params *)param );
+
     default:
         FIXME( "invalid code %u\n", code );
         return 0;
