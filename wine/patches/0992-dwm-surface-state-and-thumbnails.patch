+/* DWM surface state for the PS5 retained compositor (visual only: Wine's own
+ * window state, regions and hit-testing are unchanged). Attributes may be set
+ * only by the window's process; thumbnails belong to their destination HWND. */
+@REQ(ps5_set_window_dwm)
+    user_handle_t window;
+    unsigned int  attribute;   /* 1 corner, 2 border, 3 backdrop, 4 dark material, 5 frame margins */
+    unsigned int  value;
+    struct rectangle margins;  /* MARGINS left/top/right/bottom widths */
+@END
+
+@REQ(ps5_get_window_dwm)
+    user_handle_t window;
+    unsigned int  attribute;
+@REPLY
+    unsigned int  value;
+@END
+
+@REQ(ps5_register_thumbnail)
+    user_handle_t destination;
+    user_handle_t source;
+@REPLY
+    unsigned int  id;
+@END
+
+@REQ(ps5_update_thumbnail)
+    unsigned int  id;
+    unsigned int  flags;       /* DWM_TNP_* fields present */
+    unsigned int  options;     /* 1 visible, 2 source client area only */
+    unsigned int  opacity;
+    struct rectangle destination_rect;
+    struct rectangle source_rect;
+@END
+
+@REQ(ps5_unregister_thumbnail)
+    unsigned int  id;
+@END
+
+@REQ(ps5_query_thumbnail_size)
+    unsigned int  id;
+@REPLY
+    int           width;
+    int           height;
+@END
