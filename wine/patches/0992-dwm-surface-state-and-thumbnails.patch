+#ifdef __PROSPERO__
+static int ps5_is_top_level( const struct window *win )
+{
+    return win->parent && is_desktop_window( win->parent );
+}
+
+static struct ps5_thumbnail *ps5_owned_thumbnail( unsigned int id )
+{
+    struct ps5_thumbnail *thumbnail = ps5_find_thumbnail( id );
+    struct window *destination = thumbnail ? get_user_object( thumbnail->destination, NTUSER_OBJ_WINDOW ) : NULL;
+
+    if (!destination || !destination->thread || destination->thread->process != current->process)
+    {
+        set_error( STATUS_INVALID_PARAMETER );
+        return NULL;
+    }
+    return thumbnail;
+}
+#endif
+
+/* DWM attributes are set by the window's own process, as on Windows. */
+DECL_HANDLER(ps5_set_window_dwm)
+{
+#ifdef __PROSPERO__
+    struct window *win = get_window( req->window );
+
+    if (!win) return;
+    if (!win->thread || win->thread->process != current->process)
+    {
+        set_error( STATUS_ACCESS_DENIED );
+        return;
+    }
+    switch (req->attribute)
+    {
+    case 1:
+        if (req->value > PS5_DWMWCP_ROUNDSMALL) break;
+        win->ps5_corner = req->value;
+        return;
+    case 2:
+        if (req->value == 0xffffffff) win->ps5_border_mode = 0;      /* DWMWA_COLOR_DEFAULT */
+        else if (req->value == 0xfffffffe) win->ps5_border_mode = 2; /* DWMWA_COLOR_NONE */
+        else if (req->value <= 0xffffff)
+        {
+            win->ps5_border_mode = 1;
+            win->ps5_border = req->value;
+        }
+        else break;
+        return;
+    case 3:
+        if (req->value > PS5_DWMSBT_TABBEDWINDOW) break;
+        win->ps5_backdrop = req->value;
+        return;
+    case 4:
+        win->ps5_dark = !!req->value;
+        return;
+    case 5:
+        win->ps5_margins = req->margins;
+        win->ps5_margins_set = 1;
+        return;
+    }
+    set_error( STATUS_INVALID_PARAMETER );
+#else
+    set_error( STATUS_NOT_IMPLEMENTED );
+#endif
+}
+
+DECL_HANDLER(ps5_get_window_dwm)
+{
+#ifdef __PROSPERO__
+    struct window *win = get_window( req->window );
+
+    if (!win) return;
+    switch (req->attribute)
+    {
+    case 1: reply->value = win->ps5_corner; return;
+    case 3: reply->value = win->ps5_backdrop; return;
+    case 4: reply->value = win->ps5_dark; return;
+    }
+    set_error( STATUS_INVALID_PARAMETER );
+#else
+    set_error( STATUS_NOT_IMPLEMENTED );
+#endif
+}
+
+/* The destination must be a top-level window of the calling process; the
+ * source any other top-level window or the desktop. */
+DECL_HANDLER(ps5_register_thumbnail)
+{
+#ifdef __PROSPERO__
+    struct window *destination = get_window( req->destination ), *source;
+    struct ps5_thumbnail *slot = NULL;
+
+    if (!destination || !(source = get_window( req->source ))) return;
+    if (destination == source || !ps5_is_top_level( destination ) ||
+        !destination->thread || destination->thread->process != current->process ||
+        !(ps5_is_top_level( source ) || is_desktop_window( source )))
+    {
+        set_error( STATUS_INVALID_PARAMETER );
+        return;
+    }
+    for (unsigned int i = 0; i < PW_WINDOW_THUMBNAIL_LIMIT && !slot; ++i)
+        if (!ps5_thumbnails[i].id) slot = &ps5_thumbnails[i];
+    if (!slot)
+    {
+        set_error( STATUS_NO_MEMORY );
+        return;
+    }
+    do if (!++ps5_thumbnail_serial) ps5_thumbnail_serial = 1;
+    while (ps5_find_thumbnail( ps5_thumbnail_serial ));
+    memset( slot, 0, sizeof(*slot) );
+    slot->id = ps5_thumbnail_serial;
+    slot->destination = destination->handle;
+    slot->source = source->handle;
+    slot->opacity = 255;
+    reply->id = slot->id;
+#else
+    set_error( STATUS_NOT_IMPLEMENTED );
+#endif
+}
+
+DECL_HANDLER(ps5_update_thumbnail)
+{
+#ifdef __PROSPERO__
+    struct ps5_thumbnail *thumbnail = ps5_owned_thumbnail( req->id );
+
+    if (!thumbnail) return;
+    if ((req->flags & ~0x1f) || (req->options & ~3) || ((req->flags & 4) && req->opacity > 255))
+    {
+        set_error( STATUS_INVALID_PARAMETER );
+        return;
+    }
+    if (req->flags & 1) thumbnail->destination_rect = req->destination_rect;
+    if (req->flags & 2) thumbnail->source_rect = req->source_rect;
+    if (req->flags & 4) thumbnail->opacity = req->opacity;
+    if (req->flags & 8) thumbnail->options = (thumbnail->options & ~1) | (req->options & 1);
+    if (req->flags & 0x10) thumbnail->options = (thumbnail->options & ~2) | (req->options & 2);
+    thumbnail->flags |= req->flags;
+#else
+    set_error( STATUS_NOT_IMPLEMENTED );
+#endif
+}
+
+DECL_HANDLER(ps5_unregister_thumbnail)
+{
+#ifdef __PROSPERO__
+    struct ps5_thumbnail *thumbnail = ps5_owned_thumbnail( req->id );
+
+    if (thumbnail) memset( thumbnail, 0, sizeof(*thumbnail) );
+#else
+    set_error( STATUS_NOT_IMPLEMENTED );
+#endif
+}
+
+DECL_HANDLER(ps5_query_thumbnail_size)
+{
+#ifdef __PROSPERO__
+    struct ps5_thumbnail *thumbnail = ps5_owned_thumbnail( req->id );
+    struct window *source = thumbnail ? get_user_object( thumbnail->source, NTUSER_OBJ_WINDOW ) : NULL;
+
+    if (!thumbnail) return;
+    if (!source)
+    {
+        set_error( STATUS_INVALID_PARAMETER );
+        return;
+    }
+    reply->width = source->window_rect.right - source->window_rect.left;
+    reply->height = source->window_rect.bottom - source->window_rect.top;
+#else
+    set_error( STATUS_NOT_IMPLEMENTED );
+#endif
+}
