+/* DWM semantics adopted from Microsoft's Windows 11 rounded-corner guidance:
+ * frames (WS_CAPTION or WS_THICKFRAME) round at 8 px by default and standard
+ * menus at 4 px; maximized windows, window regions and layered windows never
+ * round; other pop-ups round only on request. Glass is the client area outside the frame-extension margins,
+ * and only for an explicit system backdrop: Wine still paints non-client
+ * frames itself, and applications that merely extend the frame keep today's
+ * opaque pixels. */
+enum { PS5_DWMWCP_DEFAULT, PS5_DWMWCP_DONOTROUND, PS5_DWMWCP_ROUND, PS5_DWMWCP_ROUNDSMALL };
+enum { PS5_DWMSBT_AUTO, PS5_DWMSBT_NONE, PS5_DWMSBT_MAINWINDOW, PS5_DWMSBT_TRANSIENTWINDOW, PS5_DWMSBT_TABBEDWINDOW };
+static int32_t ps5_clamp32(int64_t value)
+{
+    return value < INT32_MIN ? INT32_MIN : value > INT32_MAX ? INT32_MAX : (int32_t)value;
+}
+static void ps5_snapshot_dwm(PwWindowRow *row, const struct window *win)
+{
+    static const unsigned char kinds[] = {PW_BACKDROP_NONE, PW_BACKDROP_NONE, PW_BACKDROP_MICA,
+                                          PW_BACKDROP_ACRYLIC, PW_BACKDROP_MICA_ALT};
+    const int framed = (win->style & WS_CAPTION) == WS_CAPTION || (win->style & WS_THICKFRAME);
+    const int plain = !(win->style & WS_MAXIMIZE) && !win->win_region && !(win->ex_style & WS_EX_LAYERED);
+    const int dropshadow = win->class && (get_class_style( win->class ) & CS_DROPSHADOW);
+    const struct rectangle *margins = &win->ps5_margins;
+
+    if (plain && (win->ps5_corner == PS5_DWMWCP_ROUND || (win->ps5_corner == PS5_DWMWCP_DEFAULT && framed)))
+        row->radius = 8;
+    else if (plain && (win->ps5_corner == PS5_DWMWCP_ROUNDSMALL ||
+                       (win->ps5_corner == PS5_DWMWCP_DEFAULT && win->class &&
+                        get_class_atom( win->class ) == 32768 /* #32768: standard menus round small */)))
+        row->radius = 4;
+    if (plain && (framed || row->radius == 8)) row->shadow = PW_SHADOW_WINDOW;
+    else if (plain && (row->radius == 4 || dropshadow)) row->shadow = PW_SHADOW_SMALL;
+    if (win->ps5_border_mode == 1)
+    {
+        row->flags |= PW_WINDOW_BORDER;
+        row->border = ((win->ps5_border & 0xff) << 16) | (win->ps5_border & 0xff00) | ((win->ps5_border >> 16) & 0xff);
+    }
+    if (win->ps5_backdrop < sizeof(kinds) && kinds[win->ps5_backdrop] != PW_BACKDROP_NONE &&
+        win->ps5_margins_set && !(win->ex_style & WS_EX_LAYERED) &&
+        (margins->left || margins->top || margins->right || margins->bottom))
+    {
+        row->flags |= PW_WINDOW_GLASS;
+        row->backdrop = kinds[win->ps5_backdrop];
+        row->material = win->ps5_dark ? PW_MATERIAL_DARK : PW_MATERIAL_LIGHT;
+        if (margins->left < 0 || margins->top < 0 || margins->right < 0 || margins->bottom < 0)
+        {
+            /* "Sheet of glass": the whole client area. */
+            row->solid_left = row->solid_right = row->client_left;
+            row->solid_top = row->solid_bottom = row->client_top;
+        }
+        else
+        {
+            int64_t left = (int64_t)row->client_left + margins->left, top = (int64_t)row->client_top + margins->top;
+            int64_t right = (int64_t)row->client_right - margins->right, bottom = (int64_t)row->client_bottom - margins->bottom;
+            if (right < left) right = left;
+            if (bottom < top) bottom = top;
+            row->solid_left = ps5_clamp32( left ); row->solid_top = ps5_clamp32( top );
+            row->solid_right = ps5_clamp32( right ); row->solid_bottom = ps5_clamp32( bottom );
+        }
+    }
+}
+
+/* Live thumbnails belong to their destination HWND and its process; the
+ * table is bounded like the snapshot that exports it. */
+struct ps5_thumbnail
+{
+    unsigned int     id, flags, options, opacity;
+    user_handle_t    destination, source;
+    struct rectangle destination_rect, source_rect;
+};
+static struct ps5_thumbnail ps5_thumbnails[PW_WINDOW_THUMBNAIL_LIMIT];
+static unsigned int ps5_thumbnail_serial;
+
+static struct ps5_thumbnail *ps5_find_thumbnail( unsigned int id )
+{
+    for (unsigned int i = 0; id && i < PW_WINDOW_THUMBNAIL_LIMIT; ++i)
+        if (ps5_thumbnails[i].id == id) return &ps5_thumbnails[i];
+    return NULL;
+}
+
+static void ps5_release_thumbnails( user_handle_t destination )
+{
+    for (unsigned int i = 0; i < PW_WINDOW_THUMBNAIL_LIMIT; ++i)
+        if (ps5_thumbnails[i].id && ps5_thumbnails[i].destination == destination)
+        {
+            memset( &ps5_thumbnails[i], 0, sizeof(ps5_thumbnails[i]) );
+            ps5_windows_dirty = 1;
+        }
+}
+
+static const PwWindowRow *ps5_snapshot_row( const PwWindowSnapshot *snapshot, user_handle_t handle )
+{
+    for (unsigned int i = 0; i < snapshot->count; ++i)
+        if (snapshot->windows[i].hwnd == handle) return &snapshot->windows[i];
+    return NULL;
+}
+
+static void ps5_snapshot_thumbnails( PwWindowSnapshot *snapshot )
+{
+    for (unsigned int i = 0; i < PW_WINDOW_THUMBNAIL_LIMIT; ++i)
+    {
+        const struct ps5_thumbnail *thumbnail = &ps5_thumbnails[i];
+        const PwWindowRow *destination, *source;
+        struct window *source_window;
+        PwWindowThumbnail *out;
+        int64_t base_x, base_y, base_w, base_h, left, top, right, bottom;
+
+        if (!thumbnail->id || !(thumbnail->options & 1) || !thumbnail->opacity ||
+            !(thumbnail->flags & 1 /* DWM_TNP_RECTDESTINATION */)) continue;
+        destination = ps5_snapshot_row( snapshot, thumbnail->destination );
+        source = ps5_snapshot_row( snapshot, thumbnail->source );
+        source_window = get_user_object( thumbnail->source, NTUSER_OBJ_WINDOW );
+        /* A minimized source has no retained restored-size image yet. */
+        if (!destination || !source || !source_window || (source_window->style & WS_MINIMIZE) ||
+            (destination->flags & (PW_WINDOW_CHILD | PW_WINDOW_DESKTOP)) || (source->flags & PW_WINDOW_CHILD)) continue;
+        left = (int64_t)destination->client_left + thumbnail->destination_rect.left;
+        top = (int64_t)destination->client_top + thumbnail->destination_rect.top;
+        right = (int64_t)destination->client_left + thumbnail->destination_rect.right;
+        bottom = (int64_t)destination->client_top + thumbnail->destination_rect.bottom;
+        if (right <= left || bottom <= top) continue;
+        if (right - left > 1920) right = left + 1920;
+        if (bottom - top > 1080) bottom = top + 1080;
+        base_x = (thumbnail->options & 2) ? (int64_t)source->client_left - source->left : 0;
+        base_y = (thumbnail->options & 2) ? (int64_t)source->client_top - source->top : 0;
+        base_w = (thumbnail->options & 2) ? (int64_t)source->client_right - source->client_left : (int64_t)source->right - source->left;
+        base_h = (thumbnail->options & 2) ? (int64_t)source->client_bottom - source->client_top : (int64_t)source->bottom - source->top;
+        out = &snapshot->thumbnails[snapshot->thumbnail_count];
+        *out = (PwWindowThumbnail){0};
+        out->source_left = ps5_clamp32( base_x );
+        out->source_top = ps5_clamp32( base_y );
+        out->source_right = ps5_clamp32( base_x + base_w );
+        out->source_bottom = ps5_clamp32( base_y + base_h );
+        if (thumbnail->flags & 2 /* DWM_TNP_RECTSOURCE */)
+        {
+            int64_t sl = base_x + thumbnail->source_rect.left, st = base_y + thumbnail->source_rect.top;
+            int64_t sr = base_x + thumbnail->source_rect.right, sb = base_y + thumbnail->source_rect.bottom;
+            if (sl > out->source_left) out->source_left = ps5_clamp32( sl );
+            if (st > out->source_top) out->source_top = ps5_clamp32( st );
+            if (sr < out->source_right) out->source_right = ps5_clamp32( sr );
+            if (sb < out->source_bottom) out->source_bottom = ps5_clamp32( sb );
+        }
+        if (out->source_left < 0) out->source_left = 0;
+        if (out->source_top < 0) out->source_top = 0;
+        if (out->source_right > 2176) out->source_right = 2176;
+        if (out->source_bottom > 1408) out->source_bottom = 1408;
+        if (out->source_right <= out->source_left || out->source_bottom <= out->source_top) continue;
+        out->destination = destination->hwnd;
+        out->destination_generation = destination->generation;
+        out->source = source->hwnd;
+        out->source_generation = source->generation;
+        out->left = ps5_clamp32( left ); out->top = ps5_clamp32( top );
+        out->right = ps5_clamp32( right ); out->bottom = ps5_clamp32( bottom );
+        out->opacity = thumbnail->opacity;
+        snapshot->thumbnail_count++;
+    }
+}
