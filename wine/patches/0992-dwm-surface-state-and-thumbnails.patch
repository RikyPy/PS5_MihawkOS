@@ -1661,4 +1663,46 @@ static inline BOOL NtUserSetRawWindowPos( HWND hwnd, RECT rect, UINT flags, BOOL
     return NtUserCallHwndParam( hwnd, (UINT_PTR)&params, NtUserCallHwndParam_SetRawWindowPos );
 }
 
+/* DWM state for the PS5 compositor. Integer-only, so PE32 and PE64 share the
+ * layout through WoW64's default pass-through. Returns an NTSTATUS. */
+enum ps5_dwm_op
+{
+    PS5_DWM_SET = 1,
+    PS5_DWM_GET,
+    PS5_DWM_REGISTER,
+    PS5_DWM_UPDATE,
+    PS5_DWM_UNREGISTER,
+    PS5_DWM_QUERY,
+};
+
+enum ps5_dwm_attribute
+{
+    PS5_DWM_CORNER = 1,
+    PS5_DWM_BORDER,
+    PS5_DWM_BACKDROP,
+    PS5_DWM_DARK,
+    PS5_DWM_MARGINS,
+};
+
+struct ps5_dwm_params
+{
+    UINT op;
+    UINT attribute;
+    UINT value;      /* SET/GET value */
+    UINT id;         /* thumbnail */
+    UINT source;     /* REGISTER source HWND */
+    UINT flags;      /* UPDATE DWM_TNP_* */
+    UINT options;    /* UPDATE: 1 visible, 2 client area only */
+    UINT opacity;
+    RECT rect;       /* SET margins (left/top/right/bottom) or UPDATE destination */
+    RECT source_rect;
+    INT  width;      /* QUERY reply */
+    INT  height;
+};
+
+static inline NTSTATUS NtUserPs5Dwm( HWND hwnd, struct ps5_dwm_params *params )
+{
+    return NtUserCallHwndParam( hwnd, (UINT_PTR)params, NtUserCallHwndParam_Ps5Dwm );
+}
+
 #endif /* _NTUSER_ */
