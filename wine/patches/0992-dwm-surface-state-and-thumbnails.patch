+/* Window state goes to the server, which validates values and ownership and
+ * publishes it to the compositor. A server without the requests reports
+ * STATUS_NOT_IMPLEMENTED; callers then keep the previous stub results. */
+static HRESULT dwm_result(NTSTATUS status)
+{
+    switch (status)
+    {
+    case STATUS_SUCCESS: return S_OK;
+    case 0xc0010000 | ERROR_INVALID_WINDOW_HANDLE: return E_HANDLE;
+    case STATUS_ACCESS_DENIED: return E_ACCESSDENIED;
+    case STATUS_NO_MEMORY: return E_OUTOFMEMORY;
+    case STATUS_NOT_IMPLEMENTED: return E_NOTIMPL;
+    default: return E_INVALIDARG;
+    }
+}
