+/* Draws text with Chromium's glyphs from pen x (16.16) on the baseline, in role's colour (each font is the prototype's
+ * label or shortcut colour; another role scales it); FALSE when a character has none or the text would pass right
+ * (16.16) by a pixel: less is what rounding the menu's width to whole pixels took from it. */
+static BOOL pw_menu_glyph_text( struct pw_paint *paint, int which, int role, const WCHAR *text, int count, int x,
+                                int baseline, int right, BOOL cues )
+{
+    PwGlyphFont font = pw_menu_fonts[paint->dark][which];
+    unsigned int captured = pw_menu_text_colour( paint->dark, which ? PW_MENU_SECONDARY : PW_MENU_PRIMARY ) >> 24;
+    unsigned int alpha = ((pw_menu_text_colour( paint->dark, role ) >> 24) * 255 + captured / 2) / captured;
+    unsigned short stripped[256];
+    int key, length = pw_menu_strip( text, count, stripped, &key ), width = pw_text_width( &font, stripped, length );
+
+    if (width < 0 || x + width >= right + 65536) return FALSE;
+    if (alpha > 255) alpha = 255;
+    font.color = paint->dark ? alpha * 0x01010101u : alpha << 24;
+    pw_text_draw( &font, stripped, length, x, baseline, paint->bits, paint->width, paint->height );
+    if (cues && key >= 0)
+    {
+        /* the access key's letter, underlined 2 px under the baseline */
+        int pen = x + pw_text_width( &font, stripped, key ), end = pen + pw_text_glyph( &font, stripped[key] )->advance;
+        unsigned int colour = pw_menu_text_colour( paint->dark, role );
+        for (int px = pen >> 16; px < (end + 65535) >> 16; px++)
+            if (px >= 0 && px < paint->width && baseline + 2 >= 0 && baseline + 2 < paint->height)
+                paint->bits[(baseline + 2) * paint->width + px] = pw_menu_over( paint->bits[(baseline + 2) * paint->width + px], colour );
+    }
+    return TRUE;
+}
