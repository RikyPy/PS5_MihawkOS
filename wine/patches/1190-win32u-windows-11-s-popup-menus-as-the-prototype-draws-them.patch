+/* The label's length (up to a tab or a right-justify mark) and what follows it, the shortcut. */
+static int pw_menu_label( const WCHAR *text, const WCHAR **shortcut )
+{
+    int i = 0;
+    while (text[i] && text[i] != '\t' && text[i] != '\b') i++;
+    *shortcut = text[i] && text[i + 1] ? text + i + 1 : NULL;
+    return i;
+}
