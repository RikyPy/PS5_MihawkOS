+/* What GDI drew into the rectangle (alpha 0) becomes opaque. */
+static void pw_menu_opaque( struct pw_paint *paint, const RECT *rect )
+{
+    NtGdiFlush();
+    for (int j = max( rect->top, 0 ); j < min( rect->bottom, paint->height ); j++)
+        for (int i = max( rect->left, 0 ); i < min( rect->right, paint->width ); i++) paint->bits[j * paint->width + i] |= 0xff000000;
+}
