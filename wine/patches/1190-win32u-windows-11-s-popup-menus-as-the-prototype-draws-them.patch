+            if (IS_MAGIC_BITMAP( item->hbmpItem ) && item->hbmpItem != HBMMENU_CALLBACK && item->hbmpItem != HBMMENU_SYSTEM)
+                pw_menu_magic( paint, item->hbmpItem, icon_x, rect.top, pw_menu_text_colour( paint->dark, role ));
+            else if (item->hbmpItem == HBMMENU_CALLBACK || item->hbmpItem == HBMMENU_SYSTEM)
+            {
