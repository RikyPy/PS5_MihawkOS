+        int row = menu->pw_row > (right - left) * 65536 ? menu->pw_row : (right - left) * 65536;
+        int end = left * 65536 + row - (PW_MENU_ROW_PAD + ((item->fType & MF_POPUP) ? PW_MENU_GAP + PW_MENU_TAIL + PW_MENU_CHEVRON : 0)) * 65536;
