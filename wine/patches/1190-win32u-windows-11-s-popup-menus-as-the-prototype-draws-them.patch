+/* A popup's window: the flyout's glass, rounded, in the menu's light or dark. */
+static void pw_menu_surface( struct menu *menu )
+{
+    struct ps5_dwm_params params = {.op = PS5_DWM_SET};
+
+    menu->pw_dark = pw_menu_dark();
+    params.attribute = PS5_DWM_CORNER;
+    params.value = 2; /* DWMWCP_ROUND */
+    menu->pw_glass = !NtUserPs5Dwm( menu->hWnd, &params );
+    params.attribute = PS5_DWM_DARK;
+    params.value = menu->pw_dark;
+    menu->pw_glass = menu->pw_glass && !NtUserPs5Dwm( menu->hWnd, &params );
+    params.attribute = PS5_DWM_MARGINS;
+    SetRect( &params.rect, -1, -1, -1, -1 );
+    menu->pw_glass = menu->pw_glass && !NtUserPs5Dwm( menu->hWnd, &params );
+    params.attribute = PS5_DWM_BACKDROP;
+    params.value = 7; /* PS5_DWMSBT_FLYOUT: .acrylic.surface-flyout */
+    menu->pw_glass = menu->pw_glass && !NtUserPs5Dwm( menu->hWnd, &params );
+}
