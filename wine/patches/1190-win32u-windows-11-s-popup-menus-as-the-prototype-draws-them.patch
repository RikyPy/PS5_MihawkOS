+/* 0: a label, 1: the default item's label, 2: a shortcut; in the menu font's face. */
+static HFONT pw_menu_font( int which )
+{
+    static HFONT fonts[3];
+    HFONT ret = fonts[which], prev;
+    NONCLIENTMETRICSW ncm;
+
+    if (ret) return ret;
+    ncm.cbSize = sizeof(ncm);
+    NtUserSystemParametersInfo( SPI_GETNONCLIENTMETRICS, sizeof(ncm), &ncm, 0 );
+    ncm.lfMenuFont.lfHeight = which == 2 ? -PW_MENU_SHORTCUT_TEXT : -PW_MENU_TEXT;
+    ncm.lfMenuFont.lfWeight = which == 1 ? FW_SEMIBOLD : FW_NORMAL;
+    if (!(ret = NtGdiHfontCreate( &ncm.lfMenuFont, sizeof(ncm.lfMenuFont), 0, 0, NULL ))) return get_menu_font( which == 1 );
+    if ((prev = InterlockedCompareExchangePointer( (void **)&fonts[which], ret, NULL )))
+    {
+        NtGdiDeleteObjectApp( ret );
+        ret = prev;
+    }
+    return ret;
+}
