+    BOOL        pw_glass;       /* PS5_Proton: the compositor draws the flyout's material under the popup */
+    BOOL        pw_dark;        /* ... and the popup is in the dark theme */
+    BYTE        pw_checks;      /* the popup has a check column */
+    BYTE        pw_icons;       /* ... an icon column */
+    BYTE        pw_commands;    /* ... and this many leading items are command cells */
+    int         pw_row;         /* its widest row, 16.16 as Chromium lays it out (one column; 0 for several) */
