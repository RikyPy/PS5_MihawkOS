+/* Paints the whole popup into a premultiplied buffer and copies it, alpha and all, to the window. */
+static void pw_menu_paint( HWND hwnd, HDC hdc, HMENU hmenu )
+{
+    struct menu *menu = unsafe_menu_ptr( hmenu );
+    BITMAPINFO info = {{sizeof(info.bmiHeader)}};
+    struct pw_paint paint;
+    HBITMAP bitmap, prev_bitmap;
+    HFONT prev_font;
+    RECT client, box;
+    void *bits;
+
+    if (!menu) return;
+    get_client_rect( hwnd, &client, get_thread_dpi() );
+    if (client.right <= 0 || client.bottom <= 0) return;
+    /* only the rows the update region reaches are drawn and copied (a hover repaints two) */
+    if (NtGdiGetAppClipBox( hdc, &box ) == ERROR || !intersect_rect( &box, &box, &client )) box = client;
+    info.bmiHeader.biWidth = client.right;
+    info.bmiHeader.biHeight = -client.bottom;
+    info.bmiHeader.biPlanes = 1;
+    info.bmiHeader.biBitCount = 32;
+    info.bmiHeader.biCompression = BI_RGB;
+    if (!(paint.dc = NtGdiCreateCompatibleDC( hdc ))) return;
+    if (!(bitmap = NtGdiCreateDIBSection( paint.dc, NULL, 0, &info, DIB_RGB_COLORS, 0, 0, 0, &bits )))
+    {
+        NtGdiDeleteObjectApp( paint.dc );
+        return;
+    }
+    prev_bitmap = NtGdiSelectBitmap( paint.dc, bitmap );
+    prev_font = NtGdiSelectFont( paint.dc, get_menu_font( FALSE ));
+    NtGdiGetAndSetDCDword( paint.dc, NtGdiSetBkMode, TRANSPARENT, NULL );
+    paint.bits = bits;
+    paint.width = client.right;
+    paint.height = client.bottom;
+    paint.dark = menu->pw_dark;
+    paint.chrome = &pw_menu_chrome[paint.dark ? 1 : 0];
+
+    /* glass: transparent, the compositor's material shows; an app's own background, or no compositor: opaque */
+    if (menu->hbrBack || !menu->pw_glass)
+    {
+        fill_rect( paint.dc, &client, menu->hbrBack ? menu->hbrBack : get_sys_color_brush( COLOR_MENU ));
+        if (!menu->pw_glass && !menu->hbrBack) frame_rect( paint.dc, &client, get_sys_color_brush( COLOR_BTNSHADOW ));
+        pw_menu_opaque( &paint, &client );
+    }
+    for (UINT i = 0; i < menu->nItems; i++)
+    {
+        RECT rect = menu->items[i].rect, inside;
+
+        adjust_menu_item_rect( menu, &rect );
+        InflateRect( &rect, 0, 2 );  /* a neighbour's keyboard ring */
+        if (intersect_rect( &inside, &rect, &box )) pw_menu_draw_item( hwnd, menu, &menu->items[i], &paint );
+    }
+    if (menu->bScrolling)
+    {
+        /* Wine's arrows, on the menu's opaque colour */
+        RECT strip = {0, 0, client.right, menu->items_rect.top};
+        fill_rect( paint.dc, &strip, get_sys_color_brush( COLOR_MENU ));
+        SetRect( &strip, 0, menu->items_rect.bottom, client.right, client.bottom );
+        fill_rect( paint.dc, &strip, get_sys_color_brush( COLOR_MENU ));
+        draw_scroll_arrows( menu, paint.dc );
+        pw_menu_opaque( &paint, &strip );
+        SetRect( &strip, 0, 0, client.right, menu->items_rect.top );
+        pw_menu_opaque( &paint, &strip );
+    }
+
+    NtGdiBitBlt( hdc, box.left, box.top, box.right - box.left, box.bottom - box.top, paint.dc, box.left, box.top, SRCCOPY, 0, 0 );
+    NtGdiSelectFont( paint.dc, prev_font );
+    NtGdiSelectBitmap( paint.dc, prev_bitmap );
+    NtGdiDeleteObjectApp( bitmap );
+    NtGdiDeleteObjectApp( paint.dc );
+}
+
+/* A popup's item changed state: it is painted again through the buffer (glass is never drawn piecemeal); now paints
+ * what is invalid at once. */
+static void pw_menu_invalidate_item( struct menu *menu, struct menu_item *item, BOOL now )
+{
+    RECT rect = item->rect;
+
+    adjust_menu_item_rect( menu, &rect );
+    /* the keyboard ring reaches 2 px past the row */
+    InflateRect( &rect, 0, 2 );
+    NtUserRedrawWindow( menu->hWnd, &rect, 0, RDW_INVALIDATE | (now ? RDW_UPDATENOW : 0) );
+}
+
+/* The focus ring follows the keyboard: shown from the first key, hidden when the pointer moves. */
+static void pw_menu_track_keys( HMENU top, BOOL keys )
+{
+    HMENU hmenu = top;
+
+    if (keys) pw_menu_cues = TRUE;
+    if (pw_menu_keys == keys) return;
+    pw_menu_keys = keys;
+    while (hmenu)
+    {
+        struct menu *menu = unsafe_menu_ptr( hmenu );
+        struct menu_item *item;
+
+        if (!menu) break;
+        if (menu->hWnd && (menu->wFlags & MF_POPUP)) NtUserRedrawWindow( menu->hWnd, NULL, 0, RDW_INVALIDATE );
+        if (menu->FocusedItem == NO_SELECTED_ITEM) break;
+        item = &menu->items[menu->FocusedItem];
+        hmenu = (item->fType & MF_POPUP) && (item->fState & MF_MOUSESELECT) ? item->hSubMenu : NULL;
     }
 }
 
+static void draw_popup_menu( HWND hwnd, HDC hdc, HMENU hmenu )
+{
+    pw_menu_paint( hwnd, hdc, hmenu );
+}
