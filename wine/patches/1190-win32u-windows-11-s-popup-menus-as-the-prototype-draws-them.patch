+/* A text's width, 16.16: which (0 a label, 1 a shortcut) font of Chromium's glyphs when it has them all and the text is
+ * not the default item's semibold label, else GDI's whole pixels. */
+static int pw_menu_text_width( HDC hdc, BOOL dark, int which, BOOL bold, const WCHAR *text, int count )
+{
+    unsigned short stripped[256];
+    int key, length = pw_menu_strip( text, count, stripped, &key ), width;
+    HFONT prev;
+
+    if (!bold && (width = pw_text_width( &pw_menu_fonts[dark][which], stripped, length )) >= 0) return width;
+    prev = NtGdiSelectFont( hdc, pw_menu_font( bold ? 1 : which ? 2 : 0 ));
+    width = pw_menu_glyphs( hdc, NULL, text, count, 0, 0, 0, 0, FALSE );
+    NtGdiSelectFont( hdc, prev );
+    return width * 65536;
+}
