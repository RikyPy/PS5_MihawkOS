+/* Draws (paint) or measures (paint NULL) text with the font selected in hdc: each glyph's 8-bit coverage composed in
+ * colour on the baseline from x, the access-key prefix taken out (its letter underlined when cues), ending in an
+ * ellipsis when it would pass x + max. Returns the advance. */
+static int pw_menu_glyphs( HDC hdc, struct pw_paint *paint, const WCHAR *text, int count, int x, int baseline,
+                           int max, unsigned int colour, BOOL cues )
+{
+    static const MAT2 identity = { {0,1}, {0,0}, {0,0}, {0,1} };
+    static const WCHAR ellipsis = 0x2026;
+    GLYPHMETRICS gm;
+    BYTE stack[1024], *buffer = stack;
+    DWORD capacity = sizeof(stack), size;
+    int pen = 0, i, ellipsis_width = 0, underline = 0;
+    BOOL white = paint && paint->dark;
+
+    if (max > 0 && pw_menu_glyphs( hdc, NULL, text, count, 0, 0, 0, 0, FALSE ) <= max) max = 0;
+    if (max > 0 && NtGdiGetGlyphOutline( hdc, ellipsis, GGO_METRICS, &gm, 0, NULL, &identity, FALSE ) != GDI_ERROR)
+        ellipsis_width = gm.gmCellIncX;
+    for (i = 0; i < count; i++)
+    {
+        WCHAR ch = text[i];
+        BOOL last = FALSE;
+
+        if (ch == '&' && i + 1 < count)
+        {
+            ch = text[++i];
+            underline = ch != '&' && cues;
+        }
+        else underline = FALSE;
+        if (NtGdiGetGlyphOutline( hdc, ch, GGO_METRICS, &gm, 0, NULL, &identity, FALSE ) == GDI_ERROR) continue;
+        if (max > 0 && pen + (int)gm.gmCellIncX > max - ellipsis_width)
+        {
+            /* the rest does not fit: an ellipsis in its place */
+            if (NtGdiGetGlyphOutline( hdc, ellipsis, GGO_METRICS, &gm, 0, NULL, &identity, FALSE ) == GDI_ERROR) break;
+            ch = ellipsis;
+            underline = FALSE;
+            last = TRUE;
+        }
+        if (paint && (size = NtGdiGetGlyphOutline( hdc, ch, WINE_GGO_GRAY16_BITMAP, &gm, 0, NULL, &identity, FALSE )) &&
+            size != GDI_ERROR)
+        {
+            if (size > capacity)
+            {
+                if (buffer != stack) free( buffer );
+                if (!(buffer = malloc( size ))) { buffer = stack; capacity = sizeof(stack); continue; }
+                capacity = size;
+            }
+            if (NtGdiGetGlyphOutline( hdc, ch, WINE_GGO_GRAY16_BITMAP, &gm, size, buffer, &identity, FALSE ) != GDI_ERROR)
+                pw_menu_text( paint->bits, paint->width, paint->height, x + pen + gm.gmptGlyphOrigin.x,
+                              baseline - gm.gmptGlyphOrigin.y, buffer, gm.gmBlackBoxX, gm.gmBlackBoxY,
+                              (gm.gmBlackBoxX + 3) & ~3, colour, white );
+        }
+        if (paint && underline)
+        {
+            /* text-underline-offset: 2px under the baseline, as wide as the letter */
+            for (int u = 0; u < (int)gm.gmCellIncX; u++)
+            {
+                int px = x + pen + u, py = baseline + 2;
+                if (px >= 0 && px < paint->width && py >= 0 && py < paint->height)
+                    paint->bits[py * paint->width + px] = pw_menu_over( paint->bits[py * paint->width + px], colour );
+            }
+        }
+        pen += gm.gmCellIncX;
+        if (last) break;
+    }
+    if (buffer != stack) free( buffer );
+    return pen;
+}
