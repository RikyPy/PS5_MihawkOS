+        pw_menu_bitmap( paint, item->hbmpItem, rect.left + (PW_MENU_COMMAND - item->bmpsize.cx) / 2,
+                        rect.top + (PW_MENU_COMMAND - item->bmpsize.cy) / 2, 255 );
