+        int check_x = left + PW_MENU_ROW_PAD, icon_x = left + pw_menu_icon_x( menu->pw_checks );
+        BOOL shared = !menu->pw_checks && menu->pw_icons && (checked || mark) && !(menu->dwStyle & MNS_NOCHECK);
