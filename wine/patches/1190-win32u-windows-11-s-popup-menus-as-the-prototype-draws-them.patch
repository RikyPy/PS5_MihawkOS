+/* An item's height and the width its row needs, 16.16. */
+static int pw_menu_item_size( HDC hdc, struct menu *menu, struct menu_item *item, int *width )
+{
+    const WCHAR *shortcut;
+    int label, height = PW_MENU_ROW;
+
+    *width = 0;
+    if (item->fType & MF_SEPARATOR) return PW_MENU_SEPARATOR;
+    if (item->fType & MF_OWNERDRAW)
+    {
+        MEASUREITEMSTRUCT mis = {.CtlType = ODT_MENU, .itemID = item->wID, .itemData = item->dwItemData,
+                                 .itemHeight = od_item_height};
+        send_message( menu->hwndOwner, WM_MEASUREITEM, 0, (LPARAM)&mis );
+        *width = (mis.itemWidth + 2 * PW_MENU_ROW_PAD) * 65536;
+        return mis.itemHeight;
+    }
+    item->bmpsize.cx = item->bmpsize.cy = 0;
+    if (item->hbmpItem)
+    {
+        get_bitmap_item_size( item, &item->bmpsize, menu->hwndOwner );
+        if (item->bmpsize.cy + 4 > height) height = item->bmpsize.cy + 4;
+    }
+    if (item->fType & MF_BITMAP)
+    {
+        /* an old-style picture item: the picture is its content */
+        *width = (2 * PW_MENU_ROW_PAD + item->bmpsize.cx + (menu->pw_checks ? PW_MENU_ICON + PW_MENU_GAP : 0)) * 65536;
+        return height;
+    }
+    if (item->text && !(item->fType & MF_SYSMENU))
+    {
+        label = pw_menu_label( item->text, &shortcut );
+        *width = pw_menu_row_width( menu->pw_checks, menu->pw_icons,
+                                    pw_menu_text_width( hdc, menu->pw_dark, 0, !!(item->fState & MFS_DEFAULT), item->text, label ),
+                                    shortcut ? pw_menu_text_width( hdc, menu->pw_dark, 1, FALSE, shortcut, lstrlenW( shortcut )) : 0,
+                                    !!(item->fType & MF_POPUP) );
+    }
+    else *width = pw_menu_row_width( menu->pw_checks, menu->pw_icons, 0, 0, !!(item->fType & MF_POPUP) );
+    return height;
+}
