 #endif
 };
 
@@ -335,6 +341,7 @@ extern void virtual_init_user_shared_data(void);
 extern NTSTATUS virtual_handle_fault( EXCEPTION_RECORD *rec, void *stack );
 #ifdef __PROSPERO__
 extern BOOL virtual_ps5_step_done(void);
+extern void signal_ps5_fs_repair(void);
 #endif
 extern unsigned int virtual_locked_server_call( void *req_ptr );
 extern ssize_t virtual_locked_read( int fd, void *addr, size_t size );
diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
index a3bc47f..2e42a2e 100644
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -101,6 +101,8 @@
 #include "wine/debug.h"
 #ifdef __PROSPERO__
 #include "pw_wine_section_ps5.h"
+#include "pw_wine_alias.h"
+#include "pw_wine_mmu4k.h"
 #endif
 
 WINE_DEFAULT_DEBUG_CHANNEL(virtual);
@@ -226,6 +228,7 @@ extern int __wine_ps5_dmem_check( void *base, size_t size );
 typedef int (*pw_wine_vm_owned_query)( const void *, void **, void ** );
 extern int __wine_ps5_vm_gap( const void *, const void *, pw_wine_vm_owned_query, void **, void ** );
 extern int pw_wine_vm_step_slot( void *const slots[2], const void *page );
+extern int __wine_ps5_mmu4k_init( const PwWineMmu4kOps *ops );
 #define host_mmap __wine_ps5_mmap
 #define host_munmap __wine_ps5_munmap
 #define host_mprotect __wine_ps5_mprotect
@@ -4788,6 +4791,69 @@ static unsigned int ps5_host_page_prot( uintptr_t addr )
 {
     return get_host_page_unix_prot( (const void *)addr, 0, 0 );
 }
+
+/* The 4 KiB MMU's view of Wine (docs/MMU4K.md, wine/ps5/pw_wine_mmu4k.h): a run calls these on its own stack right
+ * after a sigreturn, so each first repairs a null %fs (signal_ps5_fs_repair, P5). classify, under the virtual mutex:
+ * bit i of plain is a 4 KiB page the run may store into, what the kernel would let through when the host page is
+ * writable (the store goes to the program's address), and only a read-write page that is not write-copy when it is
+ * held read-only for its neighbours (the store goes through the alias of the direct memory, a private copy never).
+ * Bit i of exec is a 4 KiB page the run may fetch code from, as the CPU with 4 KiB pages would. */
+static int ps5_mmu4k_classify( void *context, uintptr_t host_page, PwWineMmu4kPage *out )
+{
+    char *base = (char *)host_page;
+    unsigned int i;
+
+    signal_ps5_fs_repair();
+    if (!find_view( base, 0 )) return -1;
+    out->host_page = host_page;
+    out->kernel_write = (get_host_page_unix_prot( base, 0, 0 ) & PROT_WRITE) != 0;
+    out->plain = out->exec = 0;
+    for (i = 0; i < host_page_size / page_size; i++)
+    {
+        BYTE vprot = get_page_vprot( base + i * page_size );
+        if ((get_unix_prot( vprot ) & PROT_WRITE) && (out->kernel_write || !(vprot & VPROT_WRITECOPY)))
+            out->plain |= 1 << i;
+        if (get_unix_prot( vprot ) & PROT_EXEC) out->exec |= 1 << i;
+    }
+    out->alias_delta = 0;
+    if (!out->kernel_write && out->plain)
+    {
+        uintptr_t alias = pw_wine_alias_get( host_page );
+        if (alias) out->alias_delta = (intptr_t)(alias - host_page);
+    }
+    out->generation = pw_wine_alias_generation();  /* after the get, which may give a window back */
+    return 0;
+}
+
+static void ps5_mmu4k_lock( void *context )
+{
+    signal_ps5_fs_repair();
+    mutex_lock( &virtual_mutex );
+}
+
+static void ps5_mmu4k_unlock( void *context )
+{
+    signal_ps5_fs_repair();
+    mutex_unlock( &virtual_mutex );
+}
+
+static const PwWineMmu4kOps ps5_mmu4k_ops = { NULL, ps5_mmu4k_classify, ps5_mmu4k_lock, ps5_mmu4k_unlock };
+
+/* Under the virtual mutex, for a write a 4 KiB page allows in a host page held read-only for its neighbours (patch
+ * 1122's branch of virtual_handle_fault): TRUE with a run stack taken and the thread told to start a run there
+ * (segv_handler's ps5_fault_resolved, docs/MMU4K.md section 4.5); FALSE leaves 1122's step. */
+static BOOL ps5_mmu4k_wanted( struct ntdll_thread_data *data, char *page, void *addr )
+{
+    int stack;
+
+    if (!pw_wine_mmu4k_ready() || !data->ps5_fault_own || data->ps5_step_page[0] || data->ps5_mmu4k_run ||
+        !pw_wine_alias_get( (uintptr_t)page ) || (stack = pw_wine_mmu4k_stack_take()) < 0)
+        return FALSE;
+    data->ps5_mmu4k_page = page;
+    data->ps5_mmu4k_addr = addr;
+    data->ps5_mmu4k_stack = stack;
+    return TRUE;
+}
 #endif
 
 /***********************************************************************
@@ -4859,6 +4925,7 @@ void virtual_init(void)
     wine_rb_init( &views_tree, compare_view );
 #ifdef __PROSPERO__
     __wine_ps5_section_init( (uintptr_t)host_addr_space_limit, ps5_host_page_prot );
+    __wine_ps5_mmu4k_init( &ps5_mmu4k_ops );  /* on in a helper unless WINE_PS5_MMU4K=0; one log line either way */
 #endif
 
     free_ranges[0].base = (void *)0;
@@ -6047,8 +6114,9 @@ NTSTATUS virtual_handle_fault( EXCEPTION_RECORD *rec, void *stack )
         }
     }
     /* A write this page allows, refused because its host page holds read-only pages too (get_host_page_unix_prot):
-     * the host page is opened for the one instruction; the single-step trap closes it (virtual_ps5_step_done). An
-     * evicted page of a shared section is mapped first, opened. */
+     * a run of the 4 KiB MMU executes it and what follows with the stores to such pages through an alias
+     * (ps5_mmu4k_wanted); else the host page is opened for the one instruction and the single-step trap closes it
+     * (virtual_ps5_step_done). An evicted page of a shared section is mapped first, opened. */
     if (ret == STATUS_ACCESS_VIOLATION && err == EXCEPTION_WRITE_FAULT &&
         (get_unix_prot( get_page_vprot( addr ) ) & PROT_WRITE) &&
         !(get_host_page_unix_prot( page, 0, 0 ) & PROT_WRITE))
@@ -6058,7 +6126,8 @@ NTSTATUS virtual_handle_fault( EXCEPTION_RECORD *rec, void *stack )
         /* The slot holding this page if another thread closed it before the instruction ran (wine/ps5/pw_wine_vm.h). */
         int slot = pw_wine_vm_step_slot( data->ps5_step_page, page ), mapped = -1;
 
-        if (slot >= 0 &&
+        if (ps5_mmu4k_wanted( data, page, addr )) ret = STATUS_SUCCESS;
+        else if (slot >= 0 &&
             (mapped = __wine_ps5_section_fault( (uintptr_t)addr, open, PROT_WRITE,
                                                 (PwWineSectionRetry *)&data->ps5_section_retry, 1 )) ==
             PW_WINE_SECTION_RETRY)
