From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: PS5 Proton <ps5proton@invalid>
Date: Sun, 4 Oct 2026 12:00:00 -0400
Subject: [PATCH] ntdll: Opt in to Sony-managed PE64 children on PS5.

Preserve Wine's process registration, startup parameters and inherited handles.
Replace native fork/exec with the service loader and transferred server socket.
Remote clients use protocol transport and a per-child native signal agent;
process-local synchronization and memory copying cannot cross address spaces.
The experimental path requires WINE_PS5_CHILDREN=1 and a staged headless loader.
---
diff --git a/dlls/ntdll/unix/process.c b/dlls/ntdll/unix/process.c
--- a/dlls/ntdll/unix/process.c
+++ b/dlls/ntdll/unix/process.c
@@ -404,6 +404,22 @@
 static NTSTATUS spawn_process( const RTL_USER_PROCESS_PARAMETERS *params, int socketfd,
                                int unixdir, char *winedebug, const struct pe_image_info *pe_info )
 {
+#ifdef __PROSPERO__
+    extern int pw_ps5_spawn(int, const char *, const char *, const char *, const char *);
+    UNICODE_STRING nt_cwd = {0}, true_cwd = {0};
+    OBJECT_ATTRIBUTES cwd_attr;
+    char *cwd = NULL;
+    NTSTATUS status;
+    (void)unixdir; (void)pe_info;
+    if (get_nt_path(params->CurrentDirectory.DosPath.Buffer, &nt_cwd)) return STATUS_OBJECT_PATH_NOT_FOUND;
+    nt_cwd.Length = wcslen(nt_cwd.Buffer) * sizeof(WCHAR);
+    InitializeObjectAttributes(&cwd_attr, &nt_cwd, OBJ_CASE_INSENSITIVE, 0, NULL);
+    status = get_nt_and_unix_names(&cwd_attr, &true_cwd, &cwd, FILE_OPEN, FALSE);
+    if (!status && pw_ps5_spawn(socketfd, getenv("WINE_PS5_NTDLL_DIR"), config_dir, cwd,
+                               winedebug ? strchr(winedebug, '=') + 1 : NULL)) status = errno_to_status(errno);
+    free(cwd); free(nt_cwd.Buffer); free(true_cwd.Buffer);
+    return status;
+#else
     NTSTATUS status = STATUS_SUCCESS;
     int stdin_fd = -1, stdout_fd = -1;
     pid_t pid;
@@ -462,6 +478,7 @@
     if (stdin_fd != -1 && stdin_fd != 0) close( stdin_fd );
     if (stdout_fd != -1 && stdout_fd != 1) close( stdout_fd );
     return status;
+#endif
 }
 
 
@@ -780,14 +797,14 @@
         goto done;
     }
 #ifdef __PROSPERO__
-    /* A PS5 title is a single process: it can neither fork nor exec, so Windows process
-     * creation fails cleanly instead of spawning a loader. The image is opened first, as on
-     * Windows, so a missing or unreadable one fails with the status Windows gives
-     * (ERROR_FILE_NOT_FOUND for CreateProcess), which programs check; only an image that is
-     * there is refused as not supported. */
-    TRACE( "process creation is not supported on PS5\n" );
-    status = STATUS_NOT_SUPPORTED;
-    goto done;
+    /* Experimental Sony service loader: only PE64, explicitly enabled. */
+    if (!getenv("WINE_PS5_CHILDREN") || strcmp(getenv("WINE_PS5_CHILDREN"), "1") ||
+        getenv("WINE_PS5_CHILD") || debug ||
+        pe_info.machine != IMAGE_FILE_MACHINE_AMD64 || (machine && machine != IMAGE_FILE_MACHINE_AMD64))
+    {
+        status = STATUS_NOT_SUPPORTED;
+        goto done;
+    }
 #endif
     if (!machine)
     {
diff --git a/dlls/ntdll/unix/server.c b/dlls/ntdll/unix/server.c
--- a/dlls/ntdll/unix/server.c
+++ b/dlls/ntdll/unix/server.c
@@ -1645,6 +1645,12 @@
     if (!(connect_server = dlsym( module, "pw_wineserver_connect" )))
         fatal_error( "%s has no pw_wineserver_connect\n", module_path );
     register_server_thread = dlsym( module, "pw_wine_thread_register" );
+    {
+        extern int pw_ps5_remote_signal(pid_t, long, int);
+        extern int pw_ps5_remote_close(pid_t);
+        void (*set_remote_signal)(int (*)(pid_t,long,int), int (*)(pid_t)) = dlsym(module, "pw_wine_threads_set_remote_signal");
+        if (set_remote_signal) set_remote_signal(pw_ps5_remote_signal,pw_ps5_remote_close);
+    }
     unregister_server_thread = dlsym( module, "pw_wine_thread_unregister" );
     flush_server = dlsym( module, "pw_wineserver_flush" );
     terminate_server = dlsym( module, "pw_wineserver_terminate" );
@@ -1657,7 +1663,7 @@
         extern const struct ps5_ntsync_ops *ps5_ntsync;
         void (*set_ntsync)( const struct ps5_ntsync_ops * ) = dlsym( module, "pw_wineserver_set_ntsync" );
         const char *enable = getenv( "WINE_PS5_NTSYNC" );
-        if (set_ntsync && enable && !strcmp( enable, "1" ))
+        if (set_ntsync && enable && !strcmp( enable, "1" ) && !getenv("WINE_PS5_CHILDREN"))
         {
             ps5_ntsync = pw_wine_ntsync_ops();
             set_ntsync( ps5_ntsync );
@@ -1686,12 +1692,22 @@
 
 void ps5_unregister_inprocess_thread(void)
 {
-    if (unregister_server_thread) unregister_server_thread( get_unix_tid() );
+    if (getenv("WINE_PS5_CHILD"))
+    {
+        extern void pw_wine_thread_unregister(long);
+        pw_wine_thread_unregister(get_unix_tid());
+    }
+    else if (unregister_server_thread) unregister_server_thread( get_unix_tid() );
 }
 
 static void register_inprocess_thread( int tid )
 {
-    if (register_server_thread && register_server_thread( tid, pthread_self() ))
+    if (getenv("WINE_PS5_CHILD"))
+    {
+        extern int pw_wine_thread_register(long, pthread_t);
+        if (pw_wine_thread_register(tid, pthread_self())) ERR("child thread registration failed\n");
+    }
+    else if (register_server_thread && register_server_thread( tid, pthread_self() ))
         ERR( "cannot register thread %d with the in-process server\n", tid );
 }
 #endif
@@ -1892,6 +1908,20 @@
 void process_exit_wrapper( int status )
 {
     close( fd_socket );
+#ifdef __PROSPERO__
+    if (getenv("WINE_PS5_CHILD"))
+    {
+        extern void pw_ps5_child_exit(unsigned int) DECLSPEC_NORETURN;
+        pw_ps5_child_exit(status);
+    }
+#endif
+#ifdef __PROSPERO__
+    if (getenv("WINE_PS5_CHILDREN"))
+    {
+        extern void pw_ps5_wait_children(void);
+        pw_ps5_wait_children(); /* Keep the server host alive after the Windows parent dies. */
+    }
+#endif
     exit( status );
 }
 
diff --git a/dlls/ntdll/unix/thread.c b/dlls/ntdll/unix/thread.c
--- a/dlls/ntdll/unix/thread.c
+++ b/dlls/ntdll/unix/thread.c
@@ -1558,7 +1558,12 @@
      * returns to the launcher, as process_exit_wrapper does. First the
      * graphics drivers close their presenters (wine/ps5/pw_wine_sink.h). */
     pw_wine_run_exit_hooks();
-    exit( get_unix_exit_code( status ));
+    if (getenv("WINE_PS5_CHILD"))
+    {
+        extern void pw_ps5_child_exit(unsigned int) DECLSPEC_NORETURN;
+        pw_ps5_child_exit(status);
+    }
+    process_exit_wrapper( get_unix_exit_code( status ));
 #else
     _exit( get_unix_exit_code( status ));
 #endif
diff --git a/server/ptrace.c b/server/ptrace.c
--- a/server/ptrace.c
+++ b/server/ptrace.c
@@ -536,7 +536,7 @@
 int read_process_memory( struct process *process, client_ptr_t ptr, data_size_t size, char *dest )
 {
 #ifdef __PROSPERO__
-    if ((unsigned long)ptr != ptr)
+    if (process->unix_pid != getpid() || (unsigned long)ptr != ptr)
     {
         set_error( STATUS_ACCESS_DENIED );
         return 0;
@@ -553,7 +553,7 @@
 
     if (!thread) return 0;
 
-    if ((unsigned long)ptr != ptr)
+    if (process->unix_pid != getpid() || (unsigned long)ptr != ptr)
     {
         set_error( STATUS_ACCESS_DENIED );
         return 0;
diff --git a/server/thread.c b/server/thread.c
--- a/server/thread.c
+++ b/server/thread.c
@@ -427,7 +427,7 @@
     extern int pw_wine_thread_set_priority( long tid, int policy, int priority );
     int status;
 
-    if (!ps5_scheduling || thread->unix_tid == -1) return;
+    if (!ps5_scheduling || thread->unix_tid == -1 || thread->unix_pid != getpid()) return;
     status = pw_wine_thread_set_priority( thread->unix_tid, SCHED_RR,
                                           ps5_native_priority( get_effective_thread_priority( thread )));
     if (status && debug_level)
diff --git a/server/process.c b/server/process.c
--- a/server/process.c
+++ b/server/process.c
@@ -642,6 +642,21 @@
     }
 #endif
 
+#ifdef __PROSPERO__
+    if (process->unix_pid != getpid())
+    {
+        extern int pw_wine_process_close(pid_t);
+        if (!pw_wine_process_close(process->unix_pid))
+        {
+            process->sigkill_timeout = NULL;
+            process_died(process);
+            return;
+        }
+        process->sigkill_delay = TICKS_PER_SEC / 2;
+        process->sigkill_timeout = add_timeout_user( -process->sigkill_delay, process_sigkill, process );
+        return; /* A failed service close never authorizes a raw kill. */
+    }
+#endif
     if (!kill( process->unix_pid, signal ) && !signal)
         process->sigkill_timeout = add_timeout_user( -process->sigkill_delay, process_sigkill, process );
     else
