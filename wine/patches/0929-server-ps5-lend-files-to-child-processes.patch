From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mihawk <163614687+mihawk-99@users.noreply.github.com>
Date: Mon, 5 Oct 2026 20:00:00 -0400
Subject: [PATCH] server: PS5: lend files to child processes, so the title can
 park them.

The console counts the files a title and all its child processes hold open
as one budget of about 250 (fd-budget-01: a file opened by the title cuts
the helper's headroom as much as the title's, and costs one whichever
process holds descriptors of it; dups, copies passed over a socket,
sockets, pipes and mappings whose descriptor was closed cost nothing).
The server opens every Windows file for every process, so it is the
server that has to park idle files to stay inside the budget.

A descriptor sent to a child counted as in flight for good, since no
receiver in the title ever claimed it, so such a file could never be
parked; and the child cached its copy, which kept the file open whatever
the server did. Now a child gets files and directories uncached, and the
server pins a file it sends only until the receiving thread's next
request, by which time the child has closed its copy.
---
diff --git a/server/fd.c b/server/fd.c
index 643489d..a3aca55 100644
--- a/server/fd.c
+++ b/server/fd.c
@@ -3290,6 +3290,12 @@ DECL_HANDLER(get_handle_fd)
         if (unix_fd != -1)
         {
             reply->type = fd->fd_ops->get_fd_type( fd );
+#ifdef __PROSPERO__
+            /* A child's copy of a file or directory would keep it open against the title's budget, where the
+             * server could not park it: the child closes it after each call (send_client_fd). */
+            if (ps5_is_child_process( current->process ) && (reply->type == FD_TYPE_FILE || reply->type == FD_TYPE_DIR))
+                reply->cacheable = 0;
+#endif
             reply->options = fd->options;
             reply->access = get_handle_access( current->process, req->handle );
             send_client_fd( current->process, unix_fd, req->handle );
diff --git a/server/request.c b/server/request.c
index 1978038..091e390 100644
--- a/server/request.c
+++ b/server/request.c
@@ -305,6 +305,9 @@ static void call_req_handler( struct thread *thread )
     enum request req = thread->req.request_header.req;
 
     current = thread;
+#ifdef __PROSPERO__
+    ps5_end_fd_loan( current );
+#endif
     current->ps5_last_req = req;
     current->ps5_last_req_time = monotonic_time;
     current->reply_size = 0;
@@ -615,6 +618,29 @@ int receive_fd( struct process *process )
 }
 
 /* send an fd to a client */
+#ifdef __PROSPERO__
+/* The console counts the files a title and its child processes hold open together (BUDGET_FD_FILE, about 250 in
+ * all, and a file costs one however many processes have a descriptor of it). The server opens every Windows file of
+ * every process, so it is the server that parks idle files (pw_wine_fdv.h) to stay inside the budget. A file sent to
+ * a child is lent, not given: the child does not cache it (get_handle_fd), and it stays pinned only until the
+ * receiving thread's next request, by which time the child has closed its copy; then the file can be parked again.
+ * Sent as a plain transfer, it counted as in flight forever and was never parked (2026-10-05). */
+extern ssize_t pw_wine_fdv_sendmsg_loan( int socket, const struct msghdr *message, int flags, unsigned int *loan );
+extern void pw_wine_fdv_loan_end( unsigned int loan );
+
+void ps5_end_fd_loan( struct thread *thread )
+{
+    if (!thread->ps5_fd_loan) return;
+    pw_wine_fdv_loan_end( thread->ps5_fd_loan );
+    thread->ps5_fd_loan = 0;
+}
+
+int ps5_is_child_process( const struct process *process )
+{
+    return process->unix_pid != -1 && process->unix_pid != getpid();
+}
+#endif
+
 int send_client_fd( struct process *process, int fd, obj_handle_t handle )
 {
     struct iovec vec;
@@ -644,6 +670,17 @@ int send_client_fd( struct process *process, int fd, obj_handle_t handle )
     if (debug_level)
         fprintf( stderr, "%04x: *fd* %04x -> %d\n", current ? current->id : process->id, handle, fd );
 
+#ifdef __PROSPERO__
+    if (ps5_is_child_process( process ))
+    {
+        unsigned int loan = 0;
+
+        ret = pw_wine_fdv_sendmsg_loan( get_unix_fd( process->msg_fd ), &msghdr, 0, &loan );
+        if (loan && current && current->process == process && !current->ps5_fd_loan) current->ps5_fd_loan = loan;
+        else if (loan) pw_wine_fdv_loan_end( loan );
+    }
+    else
+#endif
     ret = sendmsg( get_unix_fd( process->msg_fd ), &msghdr, 0 );
 
     if (ret == sizeof(handle)) return 0;
diff --git a/server/request.h b/server/request.h
index b79d2a1..19b0c81 100644
--- a/server/request.h
+++ b/server/request.h
@@ -52,6 +52,9 @@ extern const struct object_attributes *get_req_object_attributes( const struct s
 extern const void *get_req_data_after_objattr( const struct object_attributes *attr, data_size_t *len );
 extern int receive_fd( struct process *process );
 extern int send_client_fd( struct process *process, int fd, obj_handle_t handle );
+#ifdef __PROSPERO__
+extern int ps5_is_child_process( const struct process *process );
+#endif
 extern void read_request( struct thread *thread );
 extern void write_reply( struct thread *thread );
 extern timeout_t monotonic_counter(void);
diff --git a/server/thread.c b/server/thread.c
index 0327cf2..981d5e4 100644
--- a/server/thread.c
+++ b/server/thread.c
@@ -455,6 +455,9 @@ static inline void init_thread_structure( struct thread *thread )
     thread->alert_sync      = NULL;
     thread->unix_pid        = -1;  /* not known yet */
     thread->unix_tid        = -1;  /* not known yet */
+#ifdef __PROSPERO__
+    thread->ps5_fd_loan     = 0;
+#endif
     thread->context         = NULL;
     thread->teb             = 0;
     thread->entry_point     = 0;
@@ -666,6 +669,9 @@ static void cleanup_thread( struct thread *thread )
     int i;
 
     cleanup_thread_completion( thread );
+#ifdef __PROSPERO__
+    ps5_end_fd_loan( thread );
+#endif
     if (thread->context)
     {
         thread->context->status = STATUS_ACCESS_DENIED;
diff --git a/server/thread.h b/server/thread.h
index d104e61..8eec9ef 100644
--- a/server/thread.h
+++ b/server/thread.h
@@ -47,6 +47,11 @@ struct inflight_fd
 };
 #define MAX_INFLIGHT_FDS 16  /* max number of fds in flight per thread */
 
+#ifdef __PROSPERO__
+/* A file sent to a child process stays pinned until that thread's next request (request.c). */
+extern void ps5_end_fd_loan( struct thread *thread );
+#endif
+
 struct thread
 {
     struct object          obj;           /* object header */
@@ -90,6 +95,7 @@ struct thread
     int                    suspend;       /* suspend count */
     int                    ps5_last_req;  /* WINE_PS5_WAIT_WATCHDOG: last request */
     timeout_t              ps5_last_req_time;
+    unsigned int           ps5_fd_loan;   /* a file lent to this thread's process, pinned until its next request */
     int                    dbg_hidden;    /* hidden from debugger */
     int                    bypass_proc_suspend; /* will still run if the process is suspended */
     obj_handle_t           desktop;       /* desktop handle */
