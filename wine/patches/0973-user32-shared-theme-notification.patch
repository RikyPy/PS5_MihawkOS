+/* SetSysColors publishes to the shared volatile registry. Drop process-local
+ * values and GDI objects before a receiver handles WM_SYSCOLORCHANGE. */
+void invalidate_sys_colors(void)
+{
+    unsigned int i;
+    HBRUSH brush;
+    HPEN pen;
+
+    for (i = 0; i < ARRAY_SIZE(system_colors); ++i)
+    {
+        system_colors[i].hdr.loaded = FALSE;
+        if ((brush = InterlockedExchangePointer((void **)&system_colors[i].brush, NULL)))
+        {
+            make_gdi_object_system(brush, FALSE);
+            NtGdiDeleteObjectApp(brush);
+        }
+        if ((pen = InterlockedExchangePointer((void **)&system_colors[i].pen, NULL)))
+        {
+            make_gdi_object_system(pen, FALSE);
+            NtGdiDeleteObjectApp(pen);
+        }
+    }
+}
+
 COLORREF get_sys_color( int index )
 {
     COLORREF ret = 0;
--- a/dlls/win32u/message.c
+++ b/dlls/win32u/message.c
@@ -469,6 +469,7 @@
     NTSTATUS status;
 
     if (thread_info->recursion_count > MAX_WINPROC_RECURSION) return 0;
+    if (params->msg == WM_SYSCOLORCHANGE) invalidate_sys_colors();
     thread_info->recursion_count++;
     status = KeUserModeCallback( NtUserCallWinProc, params, size, &ret_ptr, &ret_len );
     thread_info->recursion_count--;
