--- a/dlls/uxtheme/system.c
+++ b/dlls/uxtheme/system.c
@@ -1261,10 +1261,47 @@
     return S_OK;
 }
 
+/* Another process owns theme selection. Reload only this process's theme
+ * file before delivering WM_THEMECHANGED; do not publish metrics or rewrite
+ * ThemeManager here. Existing theme handles retain their file references. */
+static void WINAPI UXTHEME_RefreshTheme(void)
+{
+    HKEY key;
+    WCHAR active[10] = {0}, path[MAX_PATH] = {0}, color[64] = {0}, size[64] = {0};
+    DWORD count;
+    PTHEME_FILE theme = NULL;
+    BOOL enabled;
+
+    if (RegOpenKeyW(HKEY_CURRENT_USER, szThemeManager, &key)) return;
+    count = sizeof(active);
+    RegQueryValueExW(key, L"ThemeActive", NULL, NULL, (BYTE *)active, &count);
+    count = sizeof(color);
+    RegQueryValueExW(key, L"ColorName", NULL, NULL, (BYTE *)color, &count);
+    count = sizeof(size);
+    RegQueryValueExW(key, L"SizeName", NULL, NULL, (BYTE *)size, &count);
+    if (query_reg_path(key, L"DllName", path)) path[0] = 0;
+    RegCloseKey(key);
+    active[ARRAY_SIZE(active)-1] = color[ARRAY_SIZE(color)-1] = size[ARRAY_SIZE(size)-1] = 0;
+    path[ARRAY_SIZE(path)-1] = 0;
+    enabled = active[0] && active[0] != '0';
+    if (enabled == bThemeActive && (!enabled ||
+        (!lstrcmpW(path, szCurrentTheme) && !lstrcmpW(color, szCurrentColor) &&
+         !lstrcmpW(size, szCurrentSize)))) return;
+    if (enabled && FAILED(MSSTYLES_OpenThemeFile(path, color[0] ? color : NULL,
+                                               size[0] ? size : NULL, &theme))) return;
+    MSSTYLES_SetActiveTheme(theme, FALSE);
+    bThemeActive = enabled;
+    lstrcpynW(szCurrentTheme, enabled ? path : L"", ARRAY_SIZE(szCurrentTheme));
+    lstrcpynW(szCurrentColor, theme ? theme->pszSelectedColor : L"", ARRAY_SIZE(szCurrentColor));
+    lstrcpynW(szCurrentSize, theme ? theme->pszSelectedSize : L"", ARRAY_SIZE(szCurrentSize));
+    if (theme) MSSTYLES_CloseThemeFile(theme);
+}
+
 BOOL WINAPI ThemeHooksInstall(void)
 {
     struct user_api_hook hooks;
 
+    hooks.pThemeChanged = UXTHEME_RefreshTheme;
     hooks.pDefDlgProc = UXTHEME_DefDlgProc;
     hooks.pNonClientButtonDraw = UXTHEME_NonClientButtonDraw;
     hooks.pScrollBarDraw = UXTHEME_ScrollBarDraw;
