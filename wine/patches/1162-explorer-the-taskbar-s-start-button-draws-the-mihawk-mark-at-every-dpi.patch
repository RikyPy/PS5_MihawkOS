-        static const POINT mark[] = {
-            {139,0}, {139,260}, {140,267}, {144,272}, {149,276}, {156,277}, {163,276}, {168,272}, {172,267}, {173,260}, {173,0}, {241,0},
-            {262,4}, {281,16}, {293,35}, {297,56}, {293,77}, {281,96}, {262,108}, {241,112}, {208,112}, {208,260}, {204,280}, {193,297},
-            {176,308}, {156,312}, {136,308}, {119,297}, {108,280}, {104,260}, {104,112}, {71,112}, {50,108}, {31,96}, {19,77}, {15,56},
-            {19,35}, {31,16}, {50,4}, {71,0}, {208,79}, {241,79}, {250,77}, {257,72}, {262,65}, {264,56}, {262,47}, {257,40},
-            {250,35}, {241,33}, {208,33}, {104,79}, {71,79}, {62,77}, {55,72}, {50,65}, {48,56}, {50,47}, {55,40}, {62,35},
-            {71,33}, {104,33}
-        };
-        static const INT mark_counts[] = {40, 11, 11};
-        int extent = MulDiv(PW_APPEARANCE_TASKBAR_START_SIZE, dpi, 96), x = (rect.right - extent) / 2, y = (rect.bottom - extent) / 2;
-        HBRUSH brush = CreateSolidBrush(PW_APPEARANCE_START_MARK); POINT points[ARRAY_SIZE(mark)];
-        HGDIOBJ prior_brush = SelectObject(dc, brush), prior_pen = SelectObject(dc, GetStockObject(NULL_PEN));
