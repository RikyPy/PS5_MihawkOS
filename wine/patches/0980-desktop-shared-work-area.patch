+#ifdef WINE_PS5_USER_DRIVER
+/* No per-process cache: taskbar reservations follow the authoritative desktop
+ * across new and already-running PE32/PE64 clients. Shared reads use Wine's
+ * existing seqlock and preserve ordinary monitor geometry until a setter runs. */
+static BOOL get_desktop_work_area( RECT *rect )
+{
+    struct object_lock lock = OBJECT_LOCK_INIT;
+    const desktop_shm_t *desktop_shm;
+    NTSTATUS status;
+    BOOL valid = FALSE;
+
+    while ((status = get_shared_desktop( &lock, &desktop_shm )) == STATUS_PENDING)
+    {
+        valid = desktop_shm->work_area_valid;
+        *rect = wine_server_get_rect( desktop_shm->work_area );
+    }
+    return !status && valid;
+}
+#endif
+
 /* display_lock must be held */
