From: PS5_Proton
Subject: [PATCH] win32u: share desktop work-area reservations across clients

SPI_SETWORKAREA used a process-local rectangle, invisible to other clients
and GetMonitorInfo. Keep the raw primary-monitor reservation in Wine's
existing authoritative desktop shared object and read it under its seqlock.
Normal monitor information, SPI and maximization then see the same rectangle.
Preserve the original path for other drivers and ordinary desktop lifetime.

--- a/server/protocol.def
+++ b/server/protocol.def
@@ -1019,6 +1019,8 @@
     unsigned char        keystate[256];    /* asynchronous key state */
     unsigned __int64     monitor_serial;   /* winstation monitor update counter */
     unsigned __int64     keystate_serial;  /* keystate update counter */
+    struct rectangle     work_area;        /* primary monitor work area in raw coordinates */
+    unsigned int         work_area_valid;  /* an explicit desktop reservation exists */
 } desktop_shm_t;
 
 typedef volatile struct
@@ -4360,3 +4362,9 @@
     unsigned int shm_idx;
 @REPLY
 @END
+
+/* Set a coherent, desktop-owned work-area reservation. Clients read the
+ * existing desktop shared object under its seqlock, not a private SPI cache. */
+@REQ(set_desktop_work_area)
+    struct rectangle rect;
+@END
--- a/server/winstation.c
+++ b/server/winstation.c
@@ -334,6 +334,8 @@
                 shared->cursor.clip.right = 0;
                 shared->cursor.clip.bottom = 0;
                 memset( (void *)shared->keystate, 0, sizeof(shared->keystate) );
+                shared->work_area_valid = 0;
+                memset( (void *)&shared->work_area, 0, sizeof(shared->work_area) );
                 shared->keystate_serial = 1;
                 shared->monitor_serial = winstation->monitor_serial;
             }
@@ -1017,3 +1019,23 @@
         set_error( STATUS_BUFFER_TOO_SMALL );
     }
 }
+
+/* The server serializes writers; the existing shared-object seqlock makes all
+ * four coordinates visible together to every process on this desktop. */
+DECL_HANDLER(set_desktop_work_area)
+{
+    struct desktop *desktop;
+    if (req->rect.left >= req->rect.right || req->rect.top >= req->rect.bottom)
+    {
+        set_error( STATUS_INVALID_PARAMETER );
+        return;
+    }
+    if (!(desktop = get_thread_desktop( current, DESKTOP_WRITEOBJECTS ))) return;
+    SHARED_WRITE_BEGIN( desktop->shared, desktop_shm_t )
+    {
+        shared->work_area = req->rect;
+        shared->work_area_valid = 1;
+    }
+    SHARED_WRITE_END;
+    release_object( desktop );
+}
