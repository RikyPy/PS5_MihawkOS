+
     if (!(env = getenv( "WINE_USE_EGL" )) || !atoi( env ))
     {
         WARN( "EGL support is disabled.\n" );
@@ -1456,7 +1642,9 @@ static BOOL egl_init( const struct opengl_driver_funcs **driver_funcs )
     LOAD_FUNCPTR( eglGetProcAddress );
