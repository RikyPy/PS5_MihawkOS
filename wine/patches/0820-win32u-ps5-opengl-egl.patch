@@ -1003,7 +1104,13 @@ static EGLConfig egl_config_for_format( const struct egl_platform *egl, int form
 
 static void egldrv_init_egl_platform( struct egl_platform *platform )
 {
+#ifdef WINE_PS5_OPENGL
+    /* The PS5 SDK accepts EGL_DEFAULT_DISPLAY, but has no platform-display
+     * extensions. WGL drawables use the generic pbuffer/framebuffer path. */
+    platform->type = 0;
+#else
     platform->type = EGL_PLATFORM_SURFACELESS_MESA;
+#endif
     platform->native_display = 0;
 }
 
@@ -1079,6 +1186,11 @@ static BOOL describe_egl_config( EGLConfig config, struct wgl_pixel_format *fmt,
     /* If we can't get basic information, there is no point continuing */
     if (!funcs->p_eglGetConfigAttrib( egl->display, config, EGL_SURFACE_TYPE, &surface_type )) return FALSE;
     if (egl->type == EGL_PLATFORM_SURFACELESS_MESA) surface_type |= EGL_WINDOW_BIT | EGL_PBUFFER_BIT;
+#ifdef WINE_PS5_OPENGL
+    /* The SDK exposes a default display but no native window surface. WGL
+     * presents its framebuffer through the PS5 driver's existing path. */
+    if (!egl->type) surface_type |= EGL_WINDOW_BIT | EGL_PBUFFER_BIT;
+#endif
 
     memset( fmt, 0, sizeof(*fmt) );
     pfd->nSize = sizeof(*pfd);
@@ -1219,7 +1331,20 @@ static BOOL egldrv_surface_create( HWND hwnd, BOOL raw, int format, struct openg
     struct client_surface *client;
 
     if (!(client = nulldrv_client_surface_create( hwnd ))) return FALSE;
+#ifdef WINE_PS5_OPENGL
+    struct opengl_drawable *target;
+    EGLSurface screen = ps5_get_screen_surface( format );
+    target = screen ? opengl_drawable_create( sizeof(*target), &ps5_screen_funcs, format, client ) : NULL;
+    if (target)
+    {
+        target->surface = screen;
+        *drawable = framebuffer_surface_create( format, client, target );
+        opengl_drawable_release( target );
+    }
+    else *drawable = NULL;
+#else
     *drawable = framebuffer_surface_create( format, client, NULL );
+#endif
     client_surface_release( client );
 
     return !!*drawable;
@@ -1365,6 +1490,32 @@ static BOOL egldrv_context_create( int format, void *share, const int *attribs,
     }
     *attribs_end = EGL_NONE;
 
+#ifdef WINE_PS5_OPENGL
+    {
+        /* EGL_KHR_create_context ignores the profile mask below version 3.2,
+         * as desktop Mesa does, but the PS5 driver fails such a request with
+         * EGL_BAD_MATCH. Drop the mask so that the internal context, which
+         * asks for a core profile without a version, gets the default one. */
+        EGLint major = 1, minor = 0, *attr;
+
+        for (attr = egl_attribs; attr != attribs_end; attr += 2)
+        {
+            if (attr[0] == EGL_CONTEXT_MAJOR_VERSION_KHR) major = attr[1];
+            if (attr[0] == EGL_CONTEXT_MINOR_VERSION_KHR) minor = attr[1];
+        }
+        if (major < 3 || (major == 3 && minor < 2))
+        {
+            for (attr = egl_attribs; attr != attribs_end; attr += 2)
+                if (attr[0] == EGL_CONTEXT_OPENGL_PROFILE_MASK_KHR) break;
+            if (attr != attribs_end)
+            {
+                memmove( attr, attr + 2, (char *)(attribs_end + 1) - (char *)(attr + 2) );
+                attribs_end -= 2;
+            }
+        }
+    }
+#endif
+
     /* For now only OpenGL is supported. It's enough to set the API only for
      * context creation, since:
      * 1. the default API is EGL_OPENGL_ES_API
@@ -1435,6 +1586,41 @@ static BOOL egl_init( const struct opengl_driver_funcs **driver_funcs )
     struct opengl_funcs *funcs = &display_funcs;
