 static BOOL has_extension( const char *list, const char *ext )
 {
     size_t len = strlen( ext );
@@ -201,7 +230,7 @@ static struct framebuffer_surface *framebuffer_from_opengl_drawable( struct open
     return CONTAINING_RECORD( base, struct framebuffer_surface, base );
 }
 
-#ifdef SONAME_LIBEGL
+#if defined(SONAME_LIBEGL) || defined(WINE_PS5_OPENGL)
 
 static BOOL is_default_fbo_srgb_capable( void )
 {
@@ -756,6 +785,61 @@ static void fs_hack_handle_ds_test( int mode, struct wgl_context *ctx, struct fs
     fs_hack_handle_enable_switch( mode, GL_STENCIL_TEST, &state->stencil_test, FALSE );
 }
 
+#ifdef WINE_PS5_OPENGL
+/* The PS5 SDK submits GPU work only while it owns the video output, and has
+ * one window surface: the whole screen, scanned out on eglSwapBuffers. The
+ * title hands its video output over with the first window surface, as for
+ * a Vulkan surface (patch 0460). Every window's framebuffer surface presents
+ * to that one surface, fitted onto the screen. */
+static EGLSurface ps5_screen_surface;
+
+static void ps5_screen_destroy( struct opengl_drawable *drawable )
+{
+    drawable->surface = NULL; /* shared by every window, kept for the process */
+}
+
+static void ps5_screen_flush( struct opengl_drawable *drawable, UINT flags )
+{
+}
+
+static BOOL ps5_screen_swap( struct opengl_drawable *drawable )
+{
+    return display_funcs.p_eglSwapBuffers( display_egl.display, drawable->surface );
+}
+
+static const struct opengl_drawable_funcs ps5_screen_funcs =
+{
+    .destroy = ps5_screen_destroy,
+    .flush = ps5_screen_flush,
+    .swap = ps5_screen_swap,
+};
+
+static EGLSurface ps5_get_screen_surface( int format )
+{
+    static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
+    const struct egl_platform *egl = &display_egl;
+    int (*release_display)(void);
+    EGLSurface surface;
+
+    pthread_mutex_lock( &lock );
+    if (!ps5_screen_surface)
+    {
+        release_display = dlsym( RTLD_DEFAULT, "pw_wine_release_display" );
+        if (release_display && release_display())
+            ERR( "the title kept the video output\n" );
+        else if (!(ps5_screen_surface = display_funcs.p_eglCreateWindowSurface( egl->display,
+                       egl->configs[(format - 1) % egl->config_count], 0, NULL )))
+            ERR( "Failed to create the PS5 screen surface (error %#x)\n", display_funcs.p_eglGetError() );
+        else
+            TRACE( "created the PS5 screen surface %p\n", ps5_screen_surface );
+    }
+    surface = ps5_screen_surface;
+    pthread_mutex_unlock( &lock );
+    return surface;
+}
+#endif
+
+
 #define GAMMA_RAMP_SIZE 256
 
 static void blit_framebuffer_surface( struct framebuffer_surface *surface )
@@ -792,6 +876,20 @@ static void blit_framebuffer_surface( struct framebuffer_surface *surface )
     if (!NtUserGetClientRect( client->hwnd, &src, NtUserGetDpiForWindow( client->hwnd ) )) return;
     if (!NtUserGetClientRect( client->hwnd, &dst, NtUserGetWinMonitorDpi( client->hwnd, MDT_WINE_RAW_DPI ) )) return;
 
+#ifdef WINE_PS5_OPENGL
+    if (surface->target && surface->target->funcs == &ps5_screen_funcs && src.right > 0 && src.bottom > 0)
+    {
+        EGLint width, height;
+        if (funcs->p_eglQuerySurface( display_egl.display, surface->target->surface, EGL_WIDTH, &width ) &&
+            funcs->p_eglQuerySurface( display_egl.display, surface->target->surface, EGL_HEIGHT, &height ))
+        {
+            float scale = min( (float)width / src.right, (float)height / src.bottom );
+            LONG w = src.right * scale, h = src.bottom * scale;
+            SetRect( &dst, (width - w) / 2, (height - h) / 2, (width + w) / 2, (height + h) / 2 );
+        }
+    }
+#endif
+
     TRACE( "hwnd %p src %s dst %s fbo %u\n", client->hwnd, wine_dbgstr_rect(&src), wine_dbgstr_rect(&dst), surface->base.read_fbo );
 
     if (!ctx->gamma_program || !ctx->gamma_ramp)
@@ -825,7 +923,7 @@ static void blit_framebuffer_surface( struct framebuffer_surface *surface )
             funcs->p_glEnable( GL_FRAMEBUFFER_SRGB );
         funcs->p_glBindFramebuffer( GL_READ_FRAMEBUFFER, surface->base.read_fbo );
         funcs->p_glReadBuffer( GL_COLOR_ATTACHMENT0 );
-        funcs->p_glBlitFramebuffer( 0, 0, src.right, src.bottom, 0, 0, dst.right, dst.bottom, GL_COLOR_BUFFER_BIT,
+        funcs->p_glBlitFramebuffer( 0, 0, src.right, src.bottom, dst.left, dst.top, dst.right, dst.bottom, GL_COLOR_BUFFER_BIT,
                                     ctx->integer_scaling ? GL_NEAREST : GL_LINEAR );
     }
     else
@@ -841,8 +939,8 @@ static void blit_framebuffer_surface( struct framebuffer_surface *surface )
         if (is_srgb_format( surface->internalformat ))
             funcs->p_glTexParameteri( GL_TEXTURE_2D, GL_TEXTURE_SRGB_DECODE_EXT, GL_SKIP_DECODE_EXT );
 
-        if (ctx->has_GL_ARB_viewport_array) funcs->p_glViewportIndexedf( 0, 0, 0, dst.right, dst.bottom );
-        else funcs->p_glViewport( 0, 0, dst.right, dst.bottom );
+        if (ctx->has_GL_ARB_viewport_array) funcs->p_glViewportIndexedf( 0, dst.left, dst.top, dst.right - dst.left, dst.bottom - dst.top );
+        else funcs->p_glViewport( dst.left, dst.top, dst.right - dst.left, dst.bottom - dst.top );
 
         if (gamma_serial != surface->last_gamma_serial)
         {
@@ -968,6 +1066,9 @@ static BOOL needs_framebuffer_surface( HWND hwnd )
     float gamma_ramp[GAMMA_RAMP_SIZE * 4];
     LONG gamma_serial;
 
+#ifdef WINE_PS5_OPENGL
+    return TRUE; /* VideoOut always needs a framebuffer scaled to the screen. */
+#endif
     if (!fshack_enabled) return FALSE;
 
