@@ -1378,6 +1378,12 @@ static NTSTATUS fdo_pnp_dispatch(DEVICE_OBJECT *device, IRP *irp)
     case IRP_MN_START_DEVICE:
         bus_options_init();
 
+        if (GetEnvironmentVariableW(L"WINE_PS5_HID", NULL, 0))
+        {
+            struct bus_main_params bus = {.name = L"PS5", .init_code = ps5_init, .wait_code = ps5_wait};
+            irp->IoStatus.Status = bus_main_thread_start(&bus);
+            break;
+        }
         mouse_device_create();
         keyboard_device_create();
 
@@ -1391,6 +1397,7 @@ static NTSTATUS fdo_pnp_dispatch(DEVICE_OBJECT *device, IRP *irp)
         irp->IoStatus.Status = STATUS_SUCCESS;
         break;
     case IRP_MN_REMOVE_DEVICE:
+        winebus_call(ps5_stop, NULL);
         winebus_call(sdl_stop, NULL);
         winebus_call(udev_stop, NULL);
         winebus_call(iohid_stop, NULL);
