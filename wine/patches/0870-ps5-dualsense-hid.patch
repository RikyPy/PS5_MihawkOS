From 9a1bc075afa8d20472ca954bfae6ffe1e4ebfaf1 Mon Sep 17 00:00:00 2001
From: Mihawk <163614687+mihawk-99@users.noreply.github.com>
Date: Fri, 2 Oct 2026 21:30:20 -0400
Subject: [PATCH] ps5: expose the native DualSense through an in-process HID
 bus

---
 dlls/ntdll/loader.c                 |  16 ++++
 dlls/ntoskrnl.exe/ntoskrnl.c        |  84 +++++++++++++++++-
 dlls/ntoskrnl.exe/ntoskrnl.exe.spec |   2 +
 dlls/ntoskrnl.exe/pnp.c             |  11 +++
 dlls/winebus.sys/Makefile.in        |   1 +
 dlls/winebus.sys/bus_ps5.c          | 121 ++++++++++++++++++++++++++++
 dlls/winebus.sys/main.c             |   7 ++
 dlls/winebus.sys/unix_private.h     |   4 +
 dlls/winebus.sys/unixlib.c          |   3 +
 dlls/winebus.sys/unixlib.h          |   3 +
 10 files changed, 250 insertions(+), 2 deletions(-)
 create mode 100644 dlls/winebus.sys/bus_ps5.c

diff --git a/dlls/ntdll/loader.c b/dlls/ntdll/loader.c
index 52b6e70..b4477df 100644
--- a/dlls/ntdll/loader.c
+++ b/dlls/ntdll/loader.c
@@ -4633,6 +4633,7 @@ void loader_init( CONTEXT *context, void **entry )
 {
     static int attach_done;
     NTSTATUS status;
+    BOOL ps5_hid_init = FALSE;
     ULONG_PTR cookie, port = 0;
     WINE_MODREF *wm;
 
@@ -4651,6 +4652,7 @@ void loader_init( CONTEXT *context, void **entry )
         ULONG heap_flags = HEAP_GROWABLE;
         unsigned int i;
 
+        ps5_hid_init = TRUE;
         peb->LdrData            = &ldr;
         peb->FastPebLock        = &peb_lock;
         peb->TlsBitmap          = &tls_bitmap;
@@ -4802,6 +4804,20 @@ void loader_init( CONTEXT *context, void **entry )
     }
 
     RtlLeaveCriticalSection( &loader_section );
+    if (ps5_hid_init)
+    {
+        WCHAR enabled[4];
+        if (get_env(L"WINE_PS5_HID", enabled, sizeof(enabled)) && enabled[0] == L'1')
+        {
+            UNICODE_STRING name = RTL_CONSTANT_STRING(L"ntoskrnl.exe");
+            ANSI_STRING proc = RTL_CONSTANT_STRING("wine_ps5_hid_start");
+            NTSTATUS (CDECL *start)(void);
+            HMODULE module;
+            if (!(status = LdrLoadDll(NULL, 0, &name, &module)) &&
+                !(status = LdrGetProcedureAddress(module, &proc, 0, (void **)&start))) status = start();
+            WARN("[PS5 Proton] in-process HID initialization %#lx\n", status);
+        }
+    }
 }
 
 
diff --git a/dlls/ntoskrnl.exe/ntoskrnl.c b/dlls/ntoskrnl.exe/ntoskrnl.c
index b3f4575..d729f35 100644
--- a/dlls/ntoskrnl.exe/ntoskrnl.c
+++ b/dlls/ntoskrnl.exe/ntoskrnl.c
@@ -26,6 +26,8 @@
 #include "ntoskrnl_private.h"
 #include "excpt.h"
 #include "winreg.h"
+#include "winuser.h"
+#include "setupapi.h"
 #include "ntsecapi.h"
 #include "evntprov.h"
 #include "ddk/csq.h"
@@ -874,6 +876,7 @@ static const dispatch_func dispatch_funcs[] =
 static void set_service_status( SERVICE_STATUS_HANDLE handle, DWORD state, DWORD accepted )
 {
     SERVICE_STATUS status;
+    if (!handle) return;
     status.dwServiceType             = SERVICE_WIN32;
     status.dwCurrentState            = state;
     status.dwControlsAccepted        = accepted;
@@ -918,6 +921,7 @@ static void unload_driver( struct wine_rb_entry *entry, void *context )
 }
 
 PEPROCESS PsInitialSystemProcess = NULL;
+static HANDLE ps5_pnp_ready;
 
 /***********************************************************************
  *           wine_ntoskrnl_main_loop   (Not a Windows API)
@@ -935,6 +939,7 @@ NTSTATUS CDECL wine_ntoskrnl_main_loop( HANDLE stop_event )
     request_thread = GetCurrentThreadId();
 
     pnp_manager_start();
+    if (ps5_pnp_ready) SetEvent( ps5_pnp_ready );
 
     handles[0] = stop_event;
     handles[1] = manager;
@@ -4108,8 +4113,13 @@ NTSTATUS WINAPI ZwLoadDriver( const UNICODE_STRING *service_name )
 
     TRACE( "(%s)\n", debugstr_us(service_name) );
 
-    if ((status = open_driver( service_name, (SC_HANDLE *)&service_handle )) != STATUS_SUCCESS)
-        return status;
+    /* PS5 has one process and no service manager. Only the built-in HID
+     * transport drivers may use this path; ordinary drivers still use SCM. */
+    service_handle = NULL;
+    if (!(ps5_pnp_ready && (!wcsicmp(service_name->Buffer + wcslen(servicesW), L"winebus") ||
+                           !wcsicmp(service_name->Buffer + wcslen(servicesW), L"winehid"))))
+        if ((status = open_driver( service_name, (SC_HANDLE *)&service_handle )) != STATUS_SUCCESS)
+            return status;
 
     if (!get_drv_name( &drv_name, service_name ))
     {
@@ -4713,3 +4723,73 @@ BOOL WINAPI DllMain( HINSTANCE inst, DWORD reason, LPVOID reserved )
     }
     return TRUE;
 }
+
+/* The console runs the normal Wine HID stack in the game process. */
+static DWORD WINAPI ps5_device_thread(void *stop)
+{
+    return wine_ntoskrnl_main_loop(stop);
+}
+
+/* Milliseconds until the DualSense's HID interface is present (registered and enabled, as raw input and DirectInput
+ * find it), or -1 once limit_ms has passed without it. */
+static LONG ps5_wait_dualsense(DWORD limit_ms)
+{
+    static const GUID hid = {0x4d1e55b2, 0xf16f, 0x11cf, {0x88, 0xcb, 0x00, 0x11, 0x11, 0x00, 0x00, 0x30}};
+    DWORD start = GetTickCount();
+    for (;;)
+    {
+        HDEVINFO set = SetupDiGetClassDevsW(&hid, NULL, NULL, DIGCF_PRESENT | DIGCF_DEVICEINTERFACE);
+        SP_DEVINFO_DATA device = {sizeof(device)};
+        WCHAR id[200]; /* MAX_DEVICE_ID_LEN */
+        BOOL found = FALSE;
+        DWORD i;
+        for (i = 0; set != INVALID_HANDLE_VALUE && !found && SetupDiEnumDeviceInfo(set, i, &device); i++)
+            found = SetupDiGetDeviceInstanceIdW(set, &device, id, ARRAY_SIZE(id), NULL) &&
+                    !wcsnicmp(id, L"HID\\VID_054C&PID_0CE6", 21);
+        if (set != INVALID_HANDLE_VALUE) SetupDiDestroyDeviceInfoList(set);
+        if (found) return GetTickCount() - start;
+        if (GetTickCount() - start >= limit_ms) return -1;
+        Sleep(10);
+    }
+}
+
+NTSTATUS CDECL wine_ps5_hid_start(void)
+{
+    UNICODE_STRING service = RTL_CONSTANT_STRING(L"\\Registry\\Machine\\System\\CurrentControlSet\\Services\\winebus");
+    SP_DEVINFO_DATA device = {sizeof(device)};
+    HDEVINFO set;
+    HANDLE thread, stop;
+    HKEY key;
+    NTSTATUS status;
+    LONG waited = -1;
+    if (ps5_pnp_ready) return STATUS_SUCCESS;
+    ps5_pnp_ready = CreateEventW(NULL, TRUE, FALSE, NULL);
+    stop = CreateEventW(NULL, TRUE, FALSE, NULL);
+    if (!(thread = CreateThread(NULL, 0, ps5_device_thread, stop, 0, NULL))) return STATUS_NO_MEMORY;
+    CloseHandle(thread);
+    if (WaitForSingleObject(ps5_pnp_ready, 10000) != WAIT_OBJECT_0) return STATUS_IO_TIMEOUT;
+    if (!RegCreateKeyW(HKEY_LOCAL_MACHINE, L"System\\CurrentControlSet\\Services\\winebus", &key)) RegCloseKey(key);
+    if (!RegCreateKeyW(HKEY_LOCAL_MACHINE, L"System\\CurrentControlSet\\Services\\winehid", &key)) RegCloseKey(key);
+    /* Remove the duplicate root used by the first PS5 development build.
+     * winebus has one global FDO and must reuse Wine's canonical root. */
+    RegDeleteTreeW(HKEY_LOCAL_MACHINE, L"System\\CurrentControlSet\\Enum\\ROOT\\WINEBUS\\0000");
+    set = SetupDiCreateDeviceInfoList(NULL, NULL);
+    if (set == INVALID_HANDLE_VALUE) return STATUS_UNSUCCESSFUL;
+    if (!SetupDiCreateDeviceInfoW(set, L"ROOT\\WINE\\WINEBUS", &GUID_NULL, NULL, NULL, 0, &device) &&
+        !SetupDiOpenDeviceInfoW(set, L"ROOT\\WINE\\WINEBUS", NULL, 0, &device))
+    {
+        SetupDiDestroyDeviceInfoList(set);
+        return STATUS_UNSUCCESSFUL;
+    }
+    SetupDiSetDeviceRegistryPropertyW(set, &device, SPDRP_SERVICE, (BYTE *)L"winebus", sizeof(L"winebus"));
+    SetupDiRegisterDeviceInfo(set, &device, 0, NULL, NULL, NULL);
+    SetupDiDestroyDeviceInfoList(set);
+    status = ZwLoadDriver(&service);
+    /* The program starts once the controller is there, not beside it: Wine keeps its raw-input device list for 2 s,
+     * and a game may look for controllers only once, at its start. The PS5 bus creates the DualSense as soon as the
+     * title's page says the pad is connected; with no pad the wait ends after a second. */
+    if (!status) waited = ps5_wait_dualsense(1000);
+    MESSAGE("[PS5 Proton] HID bus start status %#lx; DualSense %s %ld ms\n", status,
+         waited >= 0 ? "ready after" : "not seen in", waited >= 0 ? waited : 1000L);
+    return status;
+}
