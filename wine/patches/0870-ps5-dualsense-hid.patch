+        return SetupDiRegisterDeviceInfo(set, sp_device, 0, NULL, NULL, NULL);
+    }
     ExFreePool( ids );
 
     if ((status = get_device_id( device, BusQueryCompatibleIDs, &ids )) || !ids)
