diff --git a/dlls/winebus.sys/bus_ps5.c b/dlls/winebus.sys/bus_ps5.c
new file mode 100644
index 0000000..3d96e64
--- /dev/null
+++ b/dlls/winebus.sys/bus_ps5.c
@@ -0,0 +1,121 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later
+ * Native PS5 DualSense transport for Wine's existing HID/PnP stack. */
+#if 0
+#pragma makedep unix
+#endif
+#include "config.h"
+#include <dlfcn.h>
+#include <unistd.h>
+#include <pthread.h>
+#include <string.h>
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "unix_private.h"
+
+struct ps5_device { struct unix_device base; int started; };
+static struct ps5_device *device;
+static int stopping;
+static pthread_mutex_t device_lock = PTHREAD_MUTEX_INITIALIZER;
+static int (*read_pad)(unsigned char *);
+static struct list events = LIST_INIT(events);
+
+/* USB report 1: six axes, counter, hat, 15 buttons and vendor payload.
+ * The vendor payload retains DualSense's public USB layout for SDL HIDAPI. */
+static const BYTE descriptor[] = {
+    0x05,0x01, 0x09,0x05, 0xa1,0x01, 0x85,0x01,
+    0x15,0x00, 0x26,0xff,0x00, 0x75,0x08, 0x95,0x06,
+    0x09,0x30, 0x09,0x31, 0x09,0x32, 0x09,0x35, 0x09,0x33, 0x09,0x34, 0x81,0x02,
+    0x06,0x00,0xff, 0x09,0x20, 0x95,0x01, 0x81,0x02,
+    0x05,0x01, 0x09,0x39, 0x15,0x00, 0x25,0x07, 0x35,0x00, 0x46,0x3b,0x01,
+    0x65,0x14, 0x75,0x04, 0x95,0x01, 0x81,0x42,
+    0x65,0x00, 0x05,0x09, 0x19,0x01, 0x29,0x0f, 0x15,0x00, 0x25,0x01,
+    0x75,0x01, 0x95,0x0f, 0x81,0x02,
+    0x75,0x01, 0x95,0x0d, 0x81,0x03,
+    0x06,0x00,0xff, 0x09,0x21, 0x15,0x00, 0x26,0xff,0x00,
+    0x75,0x08, 0x95,0x34, 0x81,0x02,
+    0x85,0x02, 0x09,0x22, 0x95,0x2f, 0x91,0x02,
+    0x85,0x09, 0x09,0x23, 0x95,0x13, 0xb1,0x02,
+    0xc0
+};
+static void destroy(struct unix_device *iface) { }
+static NTSTATUS start(struct unix_device *iface)
+{
+    __atomic_store_n(&((struct ps5_device *)iface)->started, 1, __ATOMIC_RELEASE);
+    return STATUS_SUCCESS;
+}
+static void stop(struct unix_device *iface)
+{
+    pthread_mutex_lock(&device_lock);
+    if (device == (struct ps5_device *)iface) device = NULL;
+    __atomic_store_n(&((struct ps5_device *)iface)->started, 0, __ATOMIC_RELEASE);
+    pthread_mutex_unlock(&device_lock);
+}
+static NTSTATUS get_descriptor(struct unix_device *iface, BYTE *buffer, UINT length, UINT *out)
+{
+    *out = sizeof(descriptor);
+    if (length < sizeof(descriptor)) return STATUS_BUFFER_TOO_SMALL;
+    memcpy(buffer, descriptor, sizeof(descriptor));
+    return STATUS_SUCCESS;
+}
+static void unsupported(struct unix_device *iface, HID_XFER_PACKET *packet, IO_STATUS_BLOCK *io)
+{
+    io->Status = STATUS_NOT_SUPPORTED;
+    io->Information = 0;
+}
+static void feature(struct unix_device *iface, HID_XFER_PACKET *packet, IO_STATUS_BLOCK *io)
+{
+    /* A stable local virtual-device serial, not the user's hardware address. */
+    static const BYTE serial[20] = {9, 1, 0, 0, 0, 0, 2};
+    unsupported(iface, packet, io);
+    if (packet->reportId != 9) return;
+    if (packet->reportBufferLen < sizeof(serial)) { io->Status = STATUS_BUFFER_TOO_SMALL; return; }
+    memcpy(packet->reportBuffer, serial, sizeof(serial));
+    io->Information = sizeof(serial);
+    io->Status = STATUS_SUCCESS;
+}
+static const struct raw_device_vtbl vtbl = {destroy, start, stop, get_descriptor, unsupported, feature, unsupported};
+
+NTSTATUS ps5_bus_init(void *args)
+{
+    read_pad = dlsym(RTLD_DEFAULT, "pw_wine_dualsense");
+    return read_pad ? STATUS_SUCCESS : STATUS_NOT_SUPPORTED;
+}
+NTSTATUS ps5_bus_wait(void *args)
+{
+    struct bus_event *event = args;
+    BYTE report[64];
+    int connected;
+    bus_event_cleanup(event);
+    while (!__atomic_load_n(&stopping, __ATOMIC_ACQUIRE))
+    {
+        usleep(8000);
+        connected = read_pad(report);
+        pthread_mutex_lock(&device_lock);
+        if (connected && !device)
+        {
+            struct device_desc desc = {.vid=0x054c, .pid=0x0ce6, .version=0x0100, .input=-1,
+                .is_gamepad=TRUE, .is_hidraw=TRUE, .bus_type=BUS_TYPE_USB,
+                .manufacturer={'S','o','n','y',' ','I','n','t','e','r','a','c','t','i','v','e',' ','E','n','t','e','r','t','a','i','n','m','e','n','t'},
+                .product={'D','u','a','l','S','e','n','s','e',' ','W','i','r','e','l','e','s','s',' ','C','o','n','t','r','o','l','l','e','r'},
+                .serialnumber={'P','S','5','-','L','O','C','A','L','-','1'}};
+            if (!(device = raw_device_create(&vtbl, sizeof(*device))))
+            { pthread_mutex_unlock(&device_lock); return STATUS_NO_MEMORY; }
+            bus_event_queue_device_created(&events, &device->base, &desc);
+        }
+        else if (!connected && device)
+        {
+            bus_event_queue_device_removed(&events, &device->base);
+            device = NULL; /* device_remove releases the bus ownership reference */
+        }
+        else if (device && __atomic_load_n(&device->started, __ATOMIC_ACQUIRE))
+            bus_event_queue_input_report(&events, &device->base, report, sizeof(report));
+        pthread_mutex_unlock(&device_lock);
+        if (bus_event_queue_pop(&events, event)) return STATUS_PENDING;
+    }
+    return STATUS_SUCCESS;
+}
+NTSTATUS ps5_bus_stop(void *args)
+{
+    __atomic_store_n(&stopping, 1, __ATOMIC_RELEASE);
+    return STATUS_SUCCESS;
+}
