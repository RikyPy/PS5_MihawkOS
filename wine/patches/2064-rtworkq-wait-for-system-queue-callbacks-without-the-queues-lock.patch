From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mihawk <163614687+mihawk-99@users.noreply.github.com>
Date: Sat, 17 Oct 2026 00:06:20 -0400
Subject: [PATCH] rtworkq: Wait for system queue callbacks without the queues
 lock.

MFShutdown hung after a source reader had played a clip (tests/mf-video-probe.c on
GE-Proton11-7's own Linux build: 5 of 8 runs reaching it). The main thread was in
shutdown_system_queues(), holding queues_section while shutting the standard
queue down, which waits for its running callbacks; one callback was releasing
the reader's last reference, and source_reader_release() unlocks the reader's
private queue through unlock_user_queue(), which takes queues_section. Each
waited for the other.

Mark the system queues as closing under the lock, so that grab_queue() creates
none of them again until the next startup, and shut them down without it.
---
 dlls/rtworkq/queue.c | 14 ++++++++++++--
 1 file changed, 12 insertions(+), 2 deletions(-)

diff --git a/dlls/rtworkq/queue.c b/dlls/rtworkq/queue.c
index cc9dcbd..5ce6a09 100644
--- a/dlls/rtworkq/queue.c
+++ b/dlls/rtworkq/queue.c
@@ -65,6 +65,8 @@ static CRITICAL_SECTION_DEBUG queues_critsect_debug =
       0, 0, { (DWORD_PTR)(__FILE__ ": queues_section") }
 };
 static CRITICAL_SECTION queues_section = { &queues_critsect_debug, -1, 0, 0, 0, 0 };
+/* Set under queues_section while the system queues shut down: none is created again until the next startup. */
+static BOOL system_queues_closing;
 
 static CRITICAL_SECTION async_result_cache_section;
 static CRITICAL_SECTION_DEBUG async_result_cache_critsect_debug =
@@ -665,6 +667,11 @@ static HRESULT grab_queue(DWORD queue_id, struct queue **ret)
         struct queue_desc desc;
 
         EnterCriticalSection(&queues_section);
+        if (system_queues_closing)
+        {
+            LeaveCriticalSection(&queues_section);
+            return RTWQ_E_SHUTDOWN;
+        }
         switch (queue_id)
         {
             case RTWQ_CALLBACK_QUEUE_IO:
@@ -1286,6 +1293,7 @@ static void init_system_queues(void)
     if (FAILED(hr = CoIncrementMTAUsage(&mta_cookie)))
         WARN("Failed to initialize MTA, hr %#lx.\n", hr);
 
+    system_queues_closing = FALSE;
     desc.queue_type = RTWQ_STANDARD_WORKQUEUE;
     desc.ops = &pool_queue_ops;
     desc.target_queue = 0;
@@ -1311,7 +1319,11 @@ static void shutdown_system_queues(void)
     HRESULT hr;
 
     EnterCriticalSection(&queues_section);
+    system_queues_closing = TRUE;
+    LeaveCriticalSection(&queues_section);
 
+    /* Without queues_section: shutting a queue down waits for its running callbacks, and one that releases the last
+     * reference to a user queue's owner (a source reader) takes queues_section to unlock that queue. */
     for (i = 0; i < ARRAY_SIZE(system_queues); ++i)
     {
         shutdown_queue(&system_queues[i]);
@@ -1319,8 +1331,6 @@ static void shutdown_system_queues(void)
 
     if (FAILED(hr = CoDecrementMTAUsage(mta_cookie)))
         WARN("Failed to uninitialize MTA, hr %#lx.\n", hr);
-
-    LeaveCriticalSection(&queues_section);
 }
 
 HRESULT WINAPI RtwqShutdown(void)
