+/* Live preview of a hovered application button: the window's title and its
+ * real DWM thumbnail, scaled to fit, or its icon while it is minimized. */
+static LRESULT CALLBACK taskbar_preview_proc(HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam)
+{
+    switch (msg)
+    {
+    case WM_ERASEBKGND: return 1;
+    case WM_MOUSEACTIVATE: return MA_NOACTIVATE;
+    case WM_PAINT:
+    {
+        PAINTSTRUCT paint; RECT client, title; HDC dc = BeginPaint(hwnd, &paint), buffer = NULL; HPAINTBUFFER glass;
+        int dpi = GetDpiForWindow(hwnd), header = MulDiv(32, dpi, 96), margin = MulDiv(12, dpi, 96);
+        WCHAR text[256];
+        GetClientRect(hwnd, &client);
+        if ((glass = pw_shell_glass_begin(dc, &client, &buffer)))
+        {
+            struct taskbar_button *win = taskbar_preview_button ?
+                find_taskbar_button((HWND)GetWindowLongPtrW(taskbar_preview_button, GWLP_ID)) : NULL;
+            HGDIOBJ prior = SelectObject(buffer, taskbar_font ? taskbar_font : GetStockObject(DEFAULT_GUI_FONT));
+            GetWindowTextW(hwnd, text, ARRAY_SIZE(text));
+            SetRect(&title, margin, 0, client.right - margin, header);
+            pw_shell_glass_text(taskbar_theme, glass, buffer, text, &title, taskbar_colour(1),
+                                DT_SINGLELINE | DT_VCENTER | DT_END_ELLIPSIS | DT_NOPREFIX);
+            SelectObject(buffer, prior);
+            if (!taskbar_preview_thumbnail && win)
+            {
+                int size = MulDiv(48, dpi, 96);
+                HICON icon = taskbar_window_icon(win);
+                DrawIconEx(buffer, (client.right - size) / 2, header + (client.bottom - header - size) / 2,
+                           icon ? icon : LoadIconW(NULL, (LPCWSTR)IDI_APPLICATION), size, size, 0, NULL, DI_NORMAL);
+                pw_shell_glass_fix(glass);
+            }
+            EndBufferedPaint(glass, TRUE);
+        }
+        EndPaint(hwnd, &paint); return 0;
+    }
+    case WM_MOUSEMOVE:
+    {
+        TRACKMOUSEEVENT tracking = {sizeof(tracking), TME_LEAVE, hwnd, 0};
+        TrackMouseEvent(&tracking); KillTimer(tray_window, TASKBAR_PREVIEW_HIDE); return 0;
+    }
+    case WM_MOUSELEAVE: SetTimer(tray_window, TASKBAR_PREVIEW_HIDE, 300, NULL); return 0;
+    case WM_LBUTTONUP:
+        if (taskbar_preview_button)
+        {
+            HWND button = taskbar_preview_button;
+            taskbar_preview_hide();
+            click_taskbar_button(button);
+        }
+        return 0;
+    }
+    return DefWindowProcW(hwnd, msg, wparam, lparam);
+}
+
+static void taskbar_preview_hide(void)
+{
+    if (!tray_window) return;
+    KillTimer(tray_window, TASKBAR_PREVIEW_SHOW); KillTimer(tray_window, TASKBAR_PREVIEW_HIDE);
+    if (taskbar_preview_thumbnail) DwmUnregisterThumbnail(taskbar_preview_thumbnail);
+    taskbar_preview_thumbnail = NULL; taskbar_preview_button = NULL;
+    if (taskbar_preview) ShowWindow(taskbar_preview, SW_HIDE);
+}
+
+static void taskbar_preview_show(HWND button)
+{
+    struct taskbar_button *win = find_taskbar_button((HWND)GetWindowLongPtrW(button, GWLP_ID));
+    int dpi = GetDpiForWindow(tray_window), margin = MulDiv(8, dpi, 96), header = MulDiv(32, dpi, 96);
+    int max_w = MulDiv(240, dpi, 96), max_h = MulDiv(150, dpi, 96), tw = max_w, th = max_h, width, height, x, y;
+    MONITORINFO monitor = {sizeof(monitor)};
+    SIZE source = {0};
+    RECT anchor;
+
+    if (!win || !win->hwnd || !IsWindow(win->hwnd)) { taskbar_preview_hide(); return; }
+    if (!taskbar_preview)
+    {
+        WNDCLASSW type = {0};
+        type.lpfnWndProc = taskbar_preview_proc; type.hInstance = GetModuleHandleW(NULL);
+        type.hCursor = LoadCursorW(NULL, (LPCWSTR)IDC_ARROW); type.lpszClassName = L"MihawkTaskbarPreview";
+        RegisterClassW(&type);
+        taskbar_preview = CreateWindowExW(WS_EX_TOOLWINDOW | WS_EX_TOPMOST | WS_EX_NOACTIVATE, type.lpszClassName,
+                                          NULL, WS_POPUP, 0, 0, 0, 0, tray_window, NULL, NULL, NULL);
+        if (!taskbar_preview) return;
+        taskbar_dwm(taskbar_preview, DWMWCP_ROUND, DWMSBT_TRANSIENTWINDOW, taskbar_colour(3));
+    }
+    if (taskbar_preview_thumbnail) DwmUnregisterThumbnail(taskbar_preview_thumbnail);
+    taskbar_preview_thumbnail = NULL;
+    if (!IsIconic(win->hwnd) && SUCCEEDED(DwmRegisterThumbnail(taskbar_preview, win->hwnd, &taskbar_preview_thumbnail)))
+    {
+        if (SUCCEEDED(DwmQueryThumbnailSourceSize(taskbar_preview_thumbnail, &source)) && source.cx > 0 && source.cy > 0)
+        {
+            if ((LONGLONG)source.cx * max_h > (LONGLONG)source.cy * max_w) th = max(1, MulDiv(source.cy, max_w, source.cx));
+            else tw = max(1, MulDiv(source.cx, max_h, source.cy));
+        }
+    }
+    width = max(tw, MulDiv(160, dpi, 96)) + 2 * margin;
+    height = header + th + margin;
+    GetWindowRect(button, &anchor);
+    GetMonitorInfoW(MonitorFromWindow(tray_window, MONITOR_DEFAULTTOPRIMARY), &monitor);
+    x = (anchor.left + anchor.right - width) / 2;
+    x = max(monitor.rcWork.left + margin, min(x, monitor.rcWork.right - margin - width));
+    y = monitor.rcWork.bottom - margin - height;
+    taskbar_preview_button = button;
+    SetWindowTextW(taskbar_preview, win->title);
+    if (taskbar_preview_thumbnail)
+    {
+        DWM_THUMBNAIL_PROPERTIES properties = {0};
+        properties.dwFlags = DWM_TNP_RECTDESTINATION | DWM_TNP_VISIBLE | DWM_TNP_OPACITY | DWM_TNP_SOURCECLIENTAREAONLY;
+        SetRect(&properties.rcDestination, (width - tw) / 2, header, (width - tw) / 2 + tw, header + th);
+        properties.opacity = 255; properties.fVisible = TRUE; properties.fSourceClientAreaOnly = FALSE;
+        DwmUpdateThumbnailProperties(taskbar_preview_thumbnail, &properties);
+    }
+    SetWindowPos(taskbar_preview, HWND_TOPMOST, x, y, width, height, SWP_NOACTIVATE | SWP_SHOWWINDOW);
+    InvalidateRect(taskbar_preview, NULL, FALSE);
+}
+
+/* Application buttons only; a visible preview follows the pointer at once. */
+static void taskbar_preview_hover(HWND button)
+{
+    if (!mihawk_taskbar || button == taskbar_overflow || !GetWindowLongPtrW(button, GWLP_ID)) return;
+    taskbar_hover = button;
+    KillTimer(tray_window, TASKBAR_PREVIEW_HIDE);
+    if (taskbar_preview_button && taskbar_preview && IsWindowVisible(taskbar_preview)) taskbar_preview_show(button);
+    else SetTimer(tray_window, TASKBAR_PREVIEW_SHOW, 400, NULL);
+}
