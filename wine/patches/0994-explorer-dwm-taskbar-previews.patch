+static void taskbar_dwm(HWND hwnd, DWORD corner, DWORD backdrop, DWORD border)
+{
+    DWORD dark = taskbar_dark;
+    MARGINS sheet = {-1, -1, -1, -1};
+    DwmSetWindowAttribute(hwnd, DWMWA_WINDOW_CORNER_PREFERENCE, &corner, sizeof(corner));
+    DwmSetWindowAttribute(hwnd, DWMWA_USE_IMMERSIVE_DARK_MODE, &dark, sizeof(dark));
+    DwmSetWindowAttribute(hwnd, DWMWA_BORDER_COLOR, &border, sizeof(border));
+    DwmExtendFrameIntoClientArea(hwnd, &sheet);
+    DwmSetWindowAttribute(hwnd, DWMWA_SYSTEMBACKDROP_TYPE, &backdrop, sizeof(backdrop));
+}
+
+/* After the palette refreshes: Mica taskbar, acrylic previews, theme text. */
+static void taskbar_surfaces(void)
+{
+    if (tray_window) taskbar_dwm(tray_window, DWMWCP_DONOTROUND, DWMSBT_MAINWINDOW, DWMWA_COLOR_NONE);
+    if (taskbar_preview) taskbar_dwm(taskbar_preview, DWMWCP_ROUND, DWMSBT_TRANSIENTWINDOW, taskbar_colour(3));
+    if (taskbar_theme) CloseThemeData(taskbar_theme);
+    taskbar_theme = tray_window ? OpenThemeData(tray_window, L"WINDOW") : NULL;
+}
