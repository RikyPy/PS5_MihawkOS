From 2e99e522ad86de943f74e72d403551a3b40d1c15 Mon Sep 17 00:00:00 2001
From: Mihawk <163614687+mihawk-99@users.noreply.github.com>
Date: Fri, 2 Oct 2026 21:00:19 -0400
Subject: [PATCH] wineps5: provide the PE audio driver loader module

Proton mmdevapi loads wineps5.drv before resolving its Unix functions. Build the empty PE driver shell so the existing wineps5.prx is reachable.
---
 configure.ac                 | 1 +
 dlls/wineps5.drv/Makefile.in | 3 +++
 2 files changed, 4 insertions(+)
 create mode 100644 dlls/wineps5.drv/Makefile.in

diff --git a/configure.ac b/configure.ac
index 7434ef9..a35f335 100644
--- a/configure.ac
+++ b/configure.ac
@@ -3443,6 +3443,7 @@ WINE_CONFIG_MAKEFILE(dlls/winehid.sys)
 WINE_CONFIG_MAKEFILE(dlls/winemac.drv)
 WINE_CONFIG_MAKEFILE(dlls/winemapi)
 WINE_CONFIG_MAKEFILE(dlls/wineoss.drv)
+WINE_CONFIG_MAKEFILE(dlls/wineps5.drv)
 WINE_CONFIG_MAKEFILE(dlls/wineps.drv)
 WINE_CONFIG_MAKEFILE(dlls/wineps16.drv16)
 WINE_CONFIG_MAKEFILE(dlls/winepulse.drv)
diff --git a/dlls/wineps5.drv/Makefile.in b/dlls/wineps5.drv/Makefile.in
new file mode 100644
index 0000000..cac2437
--- /dev/null
+++ b/dlls/wineps5.drv/Makefile.in
@@ -0,0 +1,3 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+MODULE = wineps5.drv
+UNIXLIB = wineps5.so
-- 
2.55.0

