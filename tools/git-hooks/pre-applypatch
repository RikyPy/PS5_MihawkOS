# The privacy guard (tools/privacy_check.py) on git am, which runs no commit hook: the patch's author, message and
# changes once applied.
exec python3 "$(dirname "$0")/../privacy_check.py" staged "$(git rev-parse --git-path rebase-apply/final-commit)"
