#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# The privacy guard (tools/privacy_check.py) on the index and first message of every commit git makes: the only hook
# that merges, cherry-picks, reverts and rebases run, and the only one --no-verify does not skip.
exec python3 "$(dirname "$0")/../privacy_check.py" staged "$1"
